/* {{ scheme }} - Generated by theme switcher */

:root {
  --zen-primary-color: #{{ base0D }} !important;
  --zen-colors-primary: #{{ base0D }} !important;
  --zen-dialog-background: #{{ base01 }} !important;

  /* Toolbar */
  --toolbar-bgcolor: #{{ base01 }} !important;
  --toolbar-color: #{{ base05 }} !important;
  --toolbarbutton-hover-background: #{{ base02 }} !important;
  --toolbarbutton-active-background: #{{ base03 }} !important;

  /* URL bar */
  --urlbar-background-color: #{{ base00 }} !important;
  --urlbar-color: #{{ base05 }} !important;
  --urlbar-focused-background-color: #{{ base00 }} !important;
  --urlbar-hover-background-color: #{{ base01 }} !important;

  /* Tabs */
  --tab-background-color: #{{ base01 }} !important;
  --tab-selected-background-color: #{{ base02 }} !important;
  --tab-text-color: #{{ base05 }} !important;
  --tab-hover-background-color: #{{ base02 }} !important;

  /* Sidebar */
  --sidebar-background-color: #{{ base00 }} !important;
  --sidebar-text-color: #{{ base05 }} !important;
  --sidebar-border-color: #{{ base02 }} !important;

  /* Popup panels */
  --arrowpanel-background: #{{ base01 }} !important;
  --arrowpanel-color: #{{ base05 }} !important;
  --arrowpanel-border-color: #{{ base02 }} !important;

  /* General */
  --lwt-accent-color: #{{ base01 }} !important;
  --lwt-text-color: #{{ base05 }} !important;
  --lwt-toolbar-field-background-color: #{{ base00 }} !important;
  --lwt-toolbar-field-color: #{{ base05 }} !important;
  --lwt-toolbar-field-border-color: #{{ base02 }} !important;
  --lwt-toolbar-field-focus: #{{ base00 }} !important;
  --lwt-toolbar-field-focus-color: #{{ base05 }} !important;
}

/* Navigator toolbox (main toolbar area) */
#navigator-toolbox {
  background-color: #{{ base01 }} !important;
  border-bottom: 1px solid #{{ base02 }} !important;
}

/* URL bar container */
#urlbar-background {
  background-color: #{{ base00 }} !important;
  border: 1px solid #{{ base02 }} !important;
}

#urlbar:not([focused]) #urlbar-background {
  background-color: #{{ base01 }} !important;
}

/* Tab bar */
#tabbrowser-tabs {
  background-color: #{{ base01 }} !important;
}

.tab-background {
  background-color: transparent !important;
}

.tab-background[selected="true"] {
  background-color: #{{ base02 }} !important;
}

/* Sidebar */
#sidebar-box {
  background-color: #{{ base00 }} !important;
}

/* Findbar */
findbar {
  background-color: #{{ base01 }} !important;
  color: #{{ base05 }} !important;
}
