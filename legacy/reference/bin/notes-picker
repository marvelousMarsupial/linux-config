#!/bin/bash
# Pick and open a note from vault using fuzzel

VAULT="$HOME/vault"

# Find all markdown files, strip vault path, show in fuzzel
NOTE=$(find "$VAULT" -name "*.md" -type f | \
    sed "s|$VAULT/||" | \
    sort | \
    fuzzel --dmenu --prompt="Note: ")

# Open selected note if not cancelled
if [ -n "$NOTE" ]; then
    foot --app-id=notes -e ~/.local/bin/nvim "$VAULT/$NOTE"
fi
