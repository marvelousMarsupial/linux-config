#!/bin/bash
# Toggle notes window - focus existing or create new blank note

VAULT="$HOME/vault"

# If notes window exists, focus it
if swaymsg -t get_tree | grep -q '"app_id": "notes"'; then
    swaymsg '[app_id="notes"] focus'
    exit 0
fi

# Create new note
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
NOTE="$VAULT/$TIMESTAMP.md"
mkdir -p "$VAULT"
echo "# " > "$NOTE"

# Open with cursor ready to type title
foot --app-id=notes -e ~/.local/bin/nvim "+normal! A" "$NOTE"
