#!/usr/bin/env python3
"""forge - workstation provisioning tool"""

import argparse
import sys

from forge_lib import DEFAULT_IMAGE, DEV_RUNTIMES, Role
from forge_lib.common import cmd_cleanup_home, parse_role
from forge_lib.ansible import (
    cmd_cleanup,
    cmd_setup,
    cmd_status,
    cmd_switch,
    cmd_teardown,
    cmd_theme,
)
from forge_lib.incus import cmd_incus_create, cmd_incus_delete, cmd_incus_list
from forge_lib.dev import (
    cmd_dev_create,
    cmd_dev_enter,
    cmd_dev_list,
    cmd_dev_rm,
    cmd_dev_stop,
)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="forge - workstation provisioning tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Roles:
    server            Base CLI: zsh, tmux, neovim, yazi, starship
    dev               + code-server, jupyter, lazygit, build tools
    desktop           + sway, foot, flatpaks (Obsidian, Zen, KeePassXC)
    remote-desktop    + sunshine/moonlight for headless GUI
    net-box           + wireshark, nmap, tcpdump, network analysis
    attack-box        + CTF tools, wordlists, exploitation frameworks

Examples:
    forge setup server
    forge switch desktop
    forge theme apply kanagawa
    forge status

    # Incus containers/VMs (user/hostname = role-type)
    forge lxc attack-box              # Creates attack-box-lxc (user+hostname)
    forge vm net-box                  # Creates net-box-vm (user+hostname)
    forge instances                   # List all instances

    # Dev containers (podman) - isolated dev environments
    forge dev create myapp python     # Python container
    forge dev create frontend ts      # TypeScript/Node container
    forge dev create webapp nuxt      # Nuxt/Vue container
    forge dev create kernel c         # C development container
    forge dev enter myapp             # Enter container shell
    forge dev list                    # List dev containers
    forge dev stop myapp              # Stop container
    forge dev rm myapp                # Remove container
"""
    )

    subparsers = parser.add_subparsers(dest="command", metavar="command")

    # setup
    p_setup = subparsers.add_parser("setup", help="Install a role")
    p_setup.add_argument("role", nargs="?", default="server",
                         choices=[r.value for r in Role],
                         help="Role to install (default: server)")

    # teardown
    p_teardown = subparsers.add_parser("teardown", help="Remove current role")
    p_teardown.add_argument("role", nargs="?", choices=[r.value for r in Role],
                            help="Role to teardown (default: current)")
    p_teardown.add_argument("--full", "-f", action="store_true",
                            help="Also remove packages")

    # switch
    p_switch = subparsers.add_parser("switch", help="Teardown current, setup new")
    p_switch.add_argument("role", choices=[r.value for r in Role],
                          help="Role to switch to")

    # status
    subparsers.add_parser("status", help="Show current role and theme")

    # cleanup
    subparsers.add_parser("cleanup", help="Remove ansible post-install")

    # cleanup-home
    p_cleanup_home = subparsers.add_parser("cleanup-home", help="Remove unnecessary home dir files")
    p_cleanup_home.add_argument("--dry-run", "-n", action="store_true",
                                help="Show what would be removed")

    # theme
    p_theme = subparsers.add_parser("theme", help="Theme switcher")
    p_theme.add_argument("theme_args", nargs="*", help="Arguments for theme command")

    # lxc - create container
    p_lxc = subparsers.add_parser("lxc", help="Create LXC container with role")
    p_lxc.add_argument("role", choices=[r.value for r in Role],
                       help="Role to install in container")
    p_lxc.add_argument("--name", "-n", help="Instance name (auto-generated if not set)")
    p_lxc.add_argument("--image", "-i", default=DEFAULT_IMAGE,
                       help=f"Base image (default: {DEFAULT_IMAGE})")

    # vm - create VM
    p_vm = subparsers.add_parser("vm", help="Create VM with role")
    p_vm.add_argument("role", choices=[r.value for r in Role],
                      help="Role to install in VM")
    p_vm.add_argument("--name", "-n", help="Instance name (auto-generated if not set)")
    p_vm.add_argument("--image", "-i", default=DEFAULT_IMAGE,
                      help=f"Base image (default: {DEFAULT_IMAGE})")

    # instances - list
    subparsers.add_parser("instances", help="List incus instances")

    # delete - delete instance
    p_delete = subparsers.add_parser("delete", help="Delete incus instance")
    p_delete.add_argument("name", help="Instance name to delete")
    p_delete.add_argument("--force", "-f", action="store_true",
                          help="Force delete (stop if running)")

    # dev - dev containers
    p_dev = subparsers.add_parser("dev", help="Dev container management")
    dev_subparsers = p_dev.add_subparsers(dest="dev_command", metavar="command")

    # dev create
    p_dev_create = dev_subparsers.add_parser("create", help="Create dev container")
    p_dev_create.add_argument("name", help="Container name")
    p_dev_create.add_argument("runtime", choices=DEV_RUNTIMES,
                              help="Runtime environment")
    p_dev_create.add_argument("-p", "--port", action="append", dest="ports",
                              help="Port forwarding (e.g., -p 8000 or -p 8000:8080). Can be repeated.")
    p_dev_create.add_argument("-v", "--volume", action="append", dest="volumes",
                              help="Volume mount (e.g., -v ./src:/workspace). Can be repeated.")

    # dev enter
    p_dev_enter = dev_subparsers.add_parser("enter", help="Enter dev container")
    p_dev_enter.add_argument("name", help="Container name")

    # dev list
    dev_subparsers.add_parser("list", help="List dev containers")

    # dev stop
    p_dev_stop = dev_subparsers.add_parser("stop", help="Stop dev container")
    p_dev_stop.add_argument("name", help="Container name")

    # dev rm
    p_dev_rm = dev_subparsers.add_parser("rm", help="Remove dev container")
    p_dev_rm.add_argument("name", help="Container name")
    p_dev_rm.add_argument("--force", "-f", action="store_true",
                          help="Force remove (stop if running)")

    # Handle shorthand: forge <role> = forge setup <role>
    # But don't intercept if it's a valid subcommand (e.g., "dev" is both a role and subcommand)
    subcommands = {"setup", "teardown", "switch", "status", "cleanup", "theme",
                   "lxc", "vm", "instances", "delete", "dev"}
    if len(sys.argv) > 1 and sys.argv[1] in [r.value for r in Role] and sys.argv[1] not in subcommands:
        sys.argv.insert(1, "setup")

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        return

    if args.command == "setup":
        cmd_setup(parse_role(args.role))
    elif args.command == "teardown":
        role = parse_role(args.role) if args.role else None
        cmd_teardown(role, args.full)
    elif args.command == "switch":
        cmd_switch(parse_role(args.role))
    elif args.command == "status":
        cmd_status()
    elif args.command == "cleanup":
        cmd_cleanup()
    elif args.command == "cleanup-home":
        cmd_cleanup_home(args.dry_run)
    elif args.command == "theme":
        cmd_theme(args.theme_args)
    elif args.command == "lxc":
        cmd_incus_create("container", parse_role(args.role), args.name, args.image)
    elif args.command == "vm":
        cmd_incus_create("vm", parse_role(args.role), args.name, args.image)
    elif args.command == "instances":
        cmd_incus_list()
    elif args.command == "delete":
        cmd_incus_delete(args.name, args.force)
    elif args.command == "dev":
        if args.dev_command == "create":
            cmd_dev_create(args.name, args.runtime, args.ports, args.volumes)
        elif args.dev_command == "enter":
            cmd_dev_enter(args.name)
        elif args.dev_command == "list":
            cmd_dev_list()
        elif args.dev_command == "stop":
            cmd_dev_stop(args.name)
        elif args.dev_command == "rm":
            cmd_dev_rm(args.name, args.force)
        else:
            p_dev.print_help()


if __name__ == "__main__":
    main()
