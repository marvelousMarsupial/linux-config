#!/bin/bash
# Power menu using fuzzel

choice=$(printf "Lock\nSuspend\nLogout\nReboot\nShutdown" | fuzzel --dmenu --prompt="Power  " --lines=5 --width=20)

case "$choice" in
    Lock)     swaylock -f ;;
    Suspend)  systemctl suspend ;;
    Logout)   swaymsg exit ;;
    Reboot)   systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac
