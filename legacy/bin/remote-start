#!/bin/bash
set -e

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Ensure runtime dir exists
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    sudo mkdir -p "$XDG_RUNTIME_DIR"
    sudo chown $(id -u):$(id -g) "$XDG_RUNTIME_DIR"
    sudo chmod 700 "$XDG_RUNTIME_DIR"
fi

# Kill any existing session
echo "Cleaning up old session..."
pkill -u $(id -u) -f "dbus-daemon --session" 2>/dev/null || true
pkill -u $(id -u) mako 2>/dev/null || true
pkill -u $(id -u) wayvnc 2>/dev/null || true
pkill -u $(id -u) sway 2>/dev/null || true
sleep 1

# Start D-Bus session daemon (persistent)
echo "Starting D-Bus session..."
DBUS_SOCKET="$XDG_RUNTIME_DIR/bus"
rm -f "$DBUS_SOCKET"
dbus-daemon --session --address="unix:path=$DBUS_SOCKET" --nofork --nopidfile &
DBUS_PID=$!
sleep 1

export DBUS_SESSION_BUS_ADDRESS="unix:path=$DBUS_SOCKET"
echo "export DBUS_SESSION_BUS_ADDRESS='$DBUS_SESSION_BUS_ADDRESS'" > "$XDG_RUNTIME_DIR/dbus-env"

# Verify D-Bus is running
if ! kill -0 $DBUS_PID 2>/dev/null; then
    echo "Failed to start D-Bus daemon"
    exit 1
fi
echo "D-Bus running (PID $DBUS_PID)"

# Start PulseAudio for virtual audio
echo "Starting PulseAudio..."
pulseaudio --start --exit-idle-time=-1 2>/dev/null || true

# Start headless Sway (pixman for software rendering on VPS without GPU)
export WLR_BACKENDS=headless
export WLR_RENDERER=pixman
export WLR_LIBINPUT_NO_DEVICES=1
export WAYLAND_DISPLAY=wayland-1

echo "Starting headless Sway..."
sway -c ~/.config/sway/config &
SWAY_PID=$!
sleep 3

# Kill lock screen components (not needed for headless)
pkill swayidle 2>/dev/null || true
pkill swaylock 2>/dev/null || true

# Check if Sway started
if ! pgrep -x sway >/dev/null; then
    echo "Failed to start Sway"
    exit 1
fi

# Start mako notification daemon with correct environment
echo "Starting mako..."
mako &
MAKO_PID=$!
sleep 1

if kill -0 $MAKO_PID 2>/dev/null; then
    echo "Mako running (PID $MAKO_PID)"
else
    echo "Warning: Mako failed to start"
fi

# Start wayvnc (WireGuard interface only - not exposed on public IP)
echo "Starting wayvnc..."
wayvnc --output=HEADLESS-1 10.0.0.1 5900 &
sleep 1

echo ""
echo "Remote desktop running!"
echo "  Sway PID: $SWAY_PID"
echo "  D-Bus PID: $DBUS_PID"
echo "  Mako PID: $MAKO_PID"
echo ""
echo "Connect via WireGuard:"
echo "  1. wg-quick up wg0"
echo "  2. vncviewer 10.0.0.1:5900"
echo ""
echo "Stop with: remote-stop"
