/* {{ scheme }} - Generated by theme switcher */

@define-color theme_bg_color #{{ base00 }};
@define-color theme_fg_color #{{ base05 }};
@define-color theme_base_color #{{ base00 }};
@define-color theme_text_color #{{ base05 }};
@define-color theme_selected_bg_color #{{ base0D }};
@define-color theme_selected_fg_color #{{ base00 }};
@define-color theme_tooltip_bg_color #{{ base01 }};
@define-color theme_tooltip_fg_color #{{ base05 }};

@define-color error_color #{{ base08 }};
@define-color warning_color #{{ base0A }};
@define-color success_color #{{ base0B }};

window, .background {
  background-color: #{{ base00 }};
  color: #{{ base05 }};
}

headerbar, .titlebar {
  background-color: #{{ base01 }};
  color: #{{ base05 }};
}

button {
  background-color: #{{ base02 }};
  color: #{{ base05 }};
}

button:hover {
  background-color: #{{ base03 }};
}

entry, textview, treeview {
  background-color: #{{ base00 }};
  color: #{{ base05 }};
}

selection, *:selected {
  background-color: #{{ base0D }};
  color: #{{ base00 }};
}

menu, popover {
  background-color: #{{ base01 }};
  color: #{{ base05 }};
}

menuitem:hover {
  background-color: #{{ base02 }};
}

scrollbar slider {
  background-color: #{{ base03 }};
}

scrollbar slider:hover {
  background-color: #{{ base04 }};
}
