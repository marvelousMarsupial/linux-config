/* {{ scheme }} - Generated by theme switcher */

.theme-dark, .theme-light {
  --background-primary: #{{ base00 }};
  --background-primary-alt: #{{ base01 }};
  --background-secondary: #{{ base01 }};
  --background-secondary-alt: #{{ base02 }};
  --background-modifier-border: #{{ base02 }};
  --background-modifier-form-field: #{{ base01 }};
  --background-modifier-form-field-highlighted: #{{ base02 }};
  --background-modifier-box-shadow: rgba(0, 0, 0, 0.3);
  --background-modifier-success: #{{ base0B }};
  --background-modifier-error: #{{ base08 }};
  --background-modifier-error-hover: #{{ base08 }};
  --background-modifier-cover: rgba(0, 0, 0, 0.8);

  --text-normal: #{{ base05 }};
  --text-muted: #{{ base04 }};
  --text-faint: #{{ base03 }};
  --text-error: #{{ base08 }};
  --text-error-hover: #{{ base08 }};
  --text-on-accent: #{{ base00 }};
  --text-accent: #{{ base0D }};
  --text-accent-hover: #{{ base0C }};

  --interactive-normal: #{{ base02 }};
  --interactive-hover: #{{ base03 }};
  --interactive-accent: #{{ base0D }};
  --interactive-accent-hover: #{{ base0C }};
  --interactive-success: #{{ base0B }};

  --scrollbar-active-thumb-bg: #{{ base03 }};
  --scrollbar-bg: #{{ base01 }};
  --scrollbar-thumb-bg: #{{ base02 }};

  /* Syntax highlighting */
  --code-normal: #{{ base05 }};
  --code-comment: #{{ base03 }};
  --code-function: #{{ base0D }};
  --code-important: #{{ base08 }};
  --code-keyword: #{{ base0E }};
  --code-operator: #{{ base05 }};
  --code-property: #{{ base0C }};
  --code-punctuation: #{{ base05 }};
  --code-string: #{{ base0B }};
  --code-tag: #{{ base08 }};
  --code-value: #{{ base09 }};

  /* Headings */
  --h1-color: #{{ base08 }};
  --h2-color: #{{ base09 }};
  --h3-color: #{{ base0A }};
  --h4-color: #{{ base0B }};
  --h5-color: #{{ base0D }};
  --h6-color: #{{ base0E }};

  /* Links */
  --link-color: #{{ base0D }};
  --link-color-hover: #{{ base0C }};
  --link-external-color: #{{ base0E }};
  --link-unresolved-color: #{{ base08 }};
}
