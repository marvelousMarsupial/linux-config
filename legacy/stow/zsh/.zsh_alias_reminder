# Alias Reminder - Terminal Hints + Corner Notification
# Shows hint when you could use a shorter alias
#
# HOW IT WORKS:
# 1. On shell startup, build lookup table: "git status" -> "gs"
# 2. When you run a command, preexec hook checks the table
# 3. If match: dim inline hint + small corner notification
#
# SECURITY:
# - No logging, no disk writes, no network
# - Commands stay in memory only for instant lookup
# - Hint shows only the alias name, not your full command
# - Notification runs async (backgrounded), never blocks
#
# ENABLE: export ALIAS_REMINDER=1

[[ "$ALIAS_REMINDER" != "1" ]] && return

# Colors
typeset -g _AR_DIM=$'\e[2m'
typeset -g _AR_RESET=$'\e[0m'

# Associative array: expansion -> alias name
typeset -gA _alias_map

# Build lookup table from current aliases
_ar_build_cache() {
    _alias_map=()
    local name exp
    for name in ${(k)aliases}; do
        exp="${aliases[$name]}"
        _alias_map[$exp]="$name"
    done
}

# Show hint (terminal + notification)
_ar_hint() {
    local name="$1" exp="$2"

    # 1. Inline terminal hint (dim gray)
    print -P "${_AR_DIM}  ↳ ${name}${_AR_RESET}" >&2

    # 2. Corner notification (async, never blocks)
    (notify-send -u low -t 1500 -a "alias" "↳ $name" "$exp" &) 2>/dev/null
}

# Check command for alias match
_ar_check() {
    local cmd="$1"
    local exp name

    # Skip empty or single-word
    [[ -z "$cmd" || "$cmd" != *" "* ]] && return

    # Exact match
    if [[ -n "${_alias_map[$cmd]}" ]]; then
        name="${_alias_map[$cmd]}"
        (( ${#name} < ${#cmd} )) && _ar_hint "$name" "$cmd"
        return
    fi

    # Prefix match (longest first)
    for exp in ${(On)${(k)_alias_map}}; do
        if [[ "$cmd" == "$exp "* || "$cmd" == "$exp" ]]; then
            name="${_alias_map[$exp]}"
            (( ${#name} < ${#exp} )) && _ar_hint "$name" "$exp"
            return
        fi
    done
}

# Hook
_ar_preexec() { _ar_check "$1" }

# Initialize
_ar_build_cache
autoload -Uz add-zsh-hook
add-zsh-hook preexec _ar_preexec

# Rebuild cache after changing aliases
alias reload-aliases='source ~/.zsh_aliases 2>/dev/null; _ar_build_cache'
