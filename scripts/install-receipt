#!/usr/bin/env bash
# Called only after install/setup succeeds. The checkout can then be deleted.
set -euo pipefail
umask 077
repo=$1
home=$2
kind=${3:-config-install}
state="$home/.local/state/linux-config"
[[ $(realpath -m "$state") == "$home/"* ]] || exit 1
mkdir -p "$state"
version=$(git -C "$repo" rev-parse HEAD 2>/dev/null || printf 'unknown')
dirty=$(git -C "$repo" status --porcelain 2>/dev/null || true)
[[ -z "$dirty" ]] || version="$version (modified checkout)"
staged=$(mktemp "$state/.receipt.XXXXXXXX")
trap 'rm -f -- "$staged"' EXIT
printf 'Installed config version: %s\nInstallation completed: %s\nInstallation scope: %s\n' "$version" "$(date --iso-8601=seconds)" "$kind" > "$staged"
chmod 600 "$staged"
mv -fT "$staged" "$state/install-info"
