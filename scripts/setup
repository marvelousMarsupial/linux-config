#!/usr/bin/python3
"""Set up this Debian 13 desktop. Run as your normal user, not through sudo."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import platform
import pwd
import re
import shlex
import shutil
import subprocess
import tarfile
import tempfile
import tomllib
import urllib.request
import uuid
import zipfile

REPO = Path(__file__).resolve().parent.parent
# Release assets per CPU architecture. packages.<machine>.txt adds packages for
# that machine only; today that is the VM stack, which stays off the Raspberry Pi.
ARCHITECTURES = {
    'x86_64': {'yazi': 'yazi-x86_64-unknown-linux-musl.zip'},
    'aarch64': {'yazi': 'yazi-aarch64-unknown-linux-musl.zip'},
}
# The Firefox configuration is a .deb built by its own repository; the asset
# name follows the pinned tag.
BROWSER_PACKAGE = 'firefoxconfig'
PORTAL_COMMIT = 'cb8cec0b30aa6e2cc36b1b5cb34d6dc9a1face29'


def pinned_releases(path=REPO / 'releases.toml'):
    """Load the reviewed release tags and digests; refuse malformed pins."""
    releases = tomllib.loads(path.read_text())
    for name, release in releases.items():
        if not re.fullmatch(r'[\w.-]+/[\w.-]+', release.get('repository', '')):
            raise ValueError(f'{name}: invalid repository in releases.toml')
        if not re.fullmatch(r'[\w.+-]+', release.get('tag', '')):
            raise ValueError(f'{name}: invalid tag in releases.toml')
        if 'url' in release and not re.fullmatch(r'https://[\w.-]+(/[\w.+-]+)*', release['url']):
            raise ValueError(f'{name}: url must be an HTTPS location without a trailing slash')
        for asset, digest in release.get('assets', {}).items():
            if not re.fullmatch(r'[0-9a-f]{64}', digest):
                raise ValueError(f'{name}: {asset} needs a SHA-256 digest in releases.toml')
    return releases
BUILD_PACKAGES = ['build-essential', 'pkgconf', 'meson', 'ninja-build', 'libinih-dev', 'libsystemd-dev', 'scdoc']


def run(*args, dry=False, **kwargs):
    print('+ ' + shlex.join(map(str, args)), flush=True)
    if not dry:
        return subprocess.run(list(map(str, args)), check=True, **kwargs)


def request(url):
    if not url.startswith('https://'):
        raise ValueError('Downloads must use HTTPS')
    response = urllib.request.urlopen(urllib.request.Request(
        url, headers={'User-Agent': 'linux-config-setup', 'Accept': 'application/vnd.github+json'}), timeout=60)
    if not response.url.startswith('https://'):
        response.close()
        raise ValueError('Refusing non-HTTPS redirect')
    return response


def asset_name(name, tag):
    """Expand {version} in a pinned asset name to the tag without its leading v."""
    return name.replace('{version}', tag.removeprefix('v'))


def release_asset(repository, name, destination, tag, expected, url=None):
    """Download one pinned release asset and verify it against the reviewed digest."""
    name = asset_name(name, tag)
    url = f'{url}/{name}' if url else f'https://github.com/{repository}/releases/download/{tag}/{name}'
    digest = hashlib.sha256()
    with request(url) as response, destination.open('wb') as output:
        while chunk := response.read(1024 * 1024):
            digest.update(chunk)
            output.write(chunk)
    if digest.hexdigest() != expected:
        raise ValueError(f'Release checksum mismatch for {repository} {tag} {name}; nothing installed')
    print(f'Verified {repository} {tag}: {name}', flush=True)


def unpack(archive, destination):
    """Reject archive traversal and links before writing files."""
    destination.mkdir()
    if zipfile.is_zipfile(archive):
        with zipfile.ZipFile(archive) as source:
            for item in source.infolist():
                path = Path(item.filename)
                if path.is_absolute() or '..' in path.parts or (item.external_attr >> 16) & 0o170000 == 0o120000:
                    raise ValueError('Unsafe release archive member')
            source.extractall(destination)
    else:
        with tarfile.open(archive) as source:
            members = source.getmembers()
            for item in members:
                path = Path(item.name)
                if path.is_absolute() or '..' in path.parts or not (item.isfile() or item.isdir()):
                    raise ValueError('Unsafe release archive member')
            source.extractall(destination, members=members, filter='data')


def replace(source, destination, backup):
    """Stage on the destination filesystem; preserve replaced installations."""
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists() or destination.is_symlink():
        backup.parent.mkdir(parents=True, exist_ok=True)
        destination.rename(backup)
    try:
        source.rename(destination)
    except OSError:
        if backup.exists() or backup.is_symlink():
            backup.rename(destination)
        raise


def firefox_running():
    """True while this user has Firefox ESR open; its startup scripts are about to be replaced."""
    return subprocess.run(['pgrep', '-u', str(os.getuid()), '-x', 'firefox-esr'], capture_output=True).returncode == 0


def encrypted_disk():
    """True when any block device is a dm-crypt mapping, the gate autologin relies on."""
    try:
        types = subprocess.run(['lsblk', '-rno', 'TYPE'], capture_output=True, text=True, timeout=15).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return 'crypt' in types.split()


def installed_version(package):
    """Version dpkg has for a package, or None when it is not installed."""
    try:
        result = subprocess.run(['dpkg-query', '-W', '-f', '${Version}', package], capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return result.stdout.strip() if result.returncode == 0 and result.stdout.strip() else None


def applications(home, dry, machine=None):
    assets = ARCHITECTURES[machine or platform.machine()]
    # Temporary directory is on the same filesystem as the installed applications.
    local = home / '.local'
    if not dry:
        local.mkdir(exist_ok=True)
    releases = pinned_releases()
    wanted = []
    if not shutil.which('yazi') or not shutil.which('ya'):
        wanted.append(('sxyazi/yazi', assets['yazi'], 'yazi'))
    browser = releases[BROWSER_PACKAGE]
    if installed_version(BROWSER_PACKAGE) != browser['tag'].removeprefix('v'):
        wanted.append((browser['repository'], next(iter(browser['assets'])), BROWSER_PACKAGE))
    fontdir = local / 'share/fonts/CaskaydiaCove'
    fonts = subprocess.run(['fc-match', '-f', '%{family}', 'CaskaydiaCove Nerd Font'],
                           capture_output=True, text=True).stdout if shutil.which('fc-match') else ''
    if 'CaskaydiaCove' not in fonts or 'Nerd Font' not in fonts:
        wanted.append(('ryanoasis/nerd-fonts', 'CascadiaCode.zip', 'font'))
    for repository, asset, kind in wanted:
        pin = releases[kind]
        if pin['repository'] != repository or asset not in pin['assets']:
            raise ValueError(f'releases.toml has no digest for {repository}/{asset}')
        print(f'Install missing {kind} from pinned release {repository} {pin["tag"]}: '
              f'{asset_name(asset, pin["tag"])}', flush=True)
        if dry:
            continue
        with tempfile.TemporaryDirectory(prefix='linux-config-', dir=local) as temporary:
            temporary = Path(temporary)
            archive = temporary / 'release'
            release_asset(repository, asset, archive, pin['tag'], pin['assets'][asset], pin.get('url'))
            stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
            if kind == BROWSER_PACKAGE:
                package = temporary / asset_name(asset, pin['tag'])
                archive.rename(package)
                # Firefox must be closed: the package replaces its startup scripts.
                if firefox_running():
                    raise ValueError(f'Close Firefox before setup installs {BROWSER_PACKAGE}')
                run('sudo', 'dpkg', '-i', package)
                if installed_version(BROWSER_PACKAGE) != pin['tag'].removeprefix('v'):
                    raise ValueError(f'{BROWSER_PACKAGE} {pin["tag"]} did not install')
                # Firefox caches autoconfig scripts per profile; drop the cache so the new ones load.
                for cache in (home / '.cache/mozilla/firefox').glob('*/startupCache'):
                    if not cache.is_symlink():
                        shutil.rmtree(cache)
                continue
            unpack(archive, temporary / 'extracted')
            extracted = temporary / 'extracted'
            if kind == 'yazi':
                for binary in ('yazi', 'ya'):
                    matches = list(extracted.rglob(binary))
                    if len(matches) != 1 or not matches[0].is_file():
                        raise ValueError(f'Missing release executable: {binary}')
                    matches[0].chmod(0o755)
                    run(matches[0], '--version')
                for binary in ('yazi', 'ya'):
                    source = next(extracted.rglob(binary))
                    dest = local / 'bin' / binary
                    replace(source, dest, local / f'state/linux-config/backups/{stamp}/.local/bin/{binary}')
            else:
                if not list(extracted.rglob('*.ttf')):
                    raise ValueError('Missing font files')
                replace(extracted, fontdir, local / f'state/linux-config/backups/{stamp}/fonts')
                run('fc-cache', '-f', fontdir)


def portal(home, dry):
    marker = home / '.local/state/linux-config/termfilechooser-commit'
    binary = Path('/usr/lib/xdg-desktop-portal-termfilechooser')
    metadata = Path('/usr/share/xdg-desktop-portal/portals/termfilechooser.portal')
    if binary.is_file() and metadata.is_file() and marker.is_file() and marker.read_text().strip() == PORTAL_COMMIT:
        print('termfilechooser already installed at the pinned revision')
        return
    run('sudo', 'apt-get', 'install', '-y', *BUILD_PACKAGES, dry=dry)
    if dry:
        print(f'Build and install termfilechooser commit {PORTAL_COMMIT} into /usr')
        return
    with tempfile.TemporaryDirectory(prefix='linux-config-portal-') as temporary:
        source = Path(temporary) / 'source'
        run('git', 'clone', 'https://github.com/hunkyburrito/xdg-desktop-portal-termfilechooser.git', source)
        run('git', '-C', source, 'checkout', '--detach', PORTAL_COMMIT)
        build = source / 'build'
        run('meson', 'setup', build, source, '--prefix=/usr', '--libexecdir=lib')
        run('meson', 'compile', '-C', build)
        run('sudo', 'meson', 'install', '-C', build)
    if not binary.is_file() or not metadata.is_file():
        raise ValueError('termfilechooser installation is incomplete')
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(PORTAL_COMMIT + '\n')


# Outbound rules for the system's own daemons. Without them a fresh desktop
# prompts for apt, unattended upgrades, time sync and DHCP, and the UI's
# prompt denies on timeout, so updates silently stop until someone clicks.
# User applications still prompt. Existing rule files are never replaced.
OPENSNITCH_SYSTEM_RULES = {
    'apt-http': '/usr/lib/apt/methods/http',
    'systemd-timesyncd': '/usr/lib/systemd/systemd-timesyncd',
    'networkmanager': '/usr/sbin/NetworkManager',
    'dhcpcd': '/usr/sbin/dhcpcd',
}


ANNOUNCED_RULES = set()


def opensnitch_rules(dry):
    """Install allow rules for system daemons; returns True when a rule was added."""
    rules = Path('/etc/opensnitchd/rules')
    if not rules.is_dir():
        return False
    added = False
    for name, executable in OPENSNITCH_SYSTEM_RULES.items():
        rule = rules / f'000-linux-config-{name}.json'
        # A dry run announces each rule once although it installs nothing.
        if rule.is_file() or rule.name in ANNOUNCED_RULES:
            continue
        ANNOUNCED_RULES.add(rule.name)
        stamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        content = json.dumps({
            'created': stamp, 'updated': stamp, 'name': rule.stem, 'enabled': True,
            'precedence': False, 'nolog': False, 'action': 'allow', 'duration': 'always',
            'operator': {'type': 'simple', 'operand': 'process.path', 'sensitive': False,
                         'data': executable, 'list': []},
        }, indent=2) + '\n'
        print(f'Install OpenSnitch rule {rule.name}: allow {executable}', flush=True)
        added = True
        if dry:
            continue
        with tempfile.TemporaryDirectory(prefix='linux-config-opensnitch-') as temporary:
            source = Path(temporary) / rule.name
            source.write_text(content)
            run('sudo', 'install', '-Dm644', source, rule)
    return added


def opensnitch(dry):
    """Connect the system daemon to this workstation user's session UI."""
    destination = Path('/etc/systemd/system/opensnitch.service.d/90-linux-config.conf')
    address = f'unix:///run/user/{os.getuid()}/opensnitch/osui.sock'
    content = ('[Service]\nExecStart=\n'
               'ExecStart=/usr/bin/opensnitchd -rules-path /etc/opensnitchd/rules '
               f'-ui-socket {address}\n')
    changed = not destination.is_file() or destination.read_text() != content
    if changed:
        if dry:
            print(f'Back up {destination} if present, then configure OpenSnitch UI socket: {address}')
        else:
            stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
            backup = Path('/var/backups/linux-config') / stamp / 'opensnitch.service.d/90-linux-config.conf'
            if destination.exists():
                run('sudo', 'install', '-d', '-m', '0700', backup.parent)
                run('sudo', 'cp', '-a', destination, backup)
            with tempfile.TemporaryDirectory(prefix='linux-config-opensnitch-') as temporary:
                source = Path(temporary) / '90-linux-config.conf'
                source.write_text(content)
                run('sudo', 'install', '-Dm644', source, destination)
        run('sudo', 'systemctl', 'daemon-reload', dry=dry)
    rules_added = opensnitch_rules(dry)
    run('sudo', 'systemctl', 'enable', '--now', 'opensnitch.service', dry=dry)
    if changed or rules_added:
        run('sudo', 'systemctl', 'restart', 'opensnitch.service', dry=dry)


def autologin(user, dry):
    """Log the desktop user in on tty1 so an encrypted boot asks for one passphrase only."""
    if not encrypted_disk():
        print(f'WARNING: no encrypted disk found; autologin lets anyone at the console in as {user}. '
              'Fine for a throwaway VM, not for a laptop.', flush=True)
    destination = Path('/etc/systemd/system/getty@tty1.service.d/autologin.conf')
    content = ('# Installed by linux-config setup --autologin. Pair with full-disk encryption:\n'
               '# the LUKS passphrase is the gate, .zshrc starts Sway on tty1.\n'
               '[Service]\nExecStart=\n'
               f'ExecStart=-/sbin/agetty --autologin {user} --noclear %I $TERM\n')
    if destination.is_file() and destination.read_text() == content:
        print(f'Autologin for {user} on tty1 already configured')
        return
    if dry:
        print(f'Back up {destination} if present, then configure autologin for {user} on tty1')
    else:
        stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
        backup = Path('/var/backups/linux-config') / stamp / 'getty@tty1.service.d/autologin.conf'
        if destination.exists():
            run('sudo', 'install', '-d', '-m', '0700', backup.parent)
            run('sudo', 'cp', '-a', destination, backup)
        with tempfile.TemporaryDirectory(prefix='linux-config-autologin-') as temporary:
            source = Path(temporary) / 'autologin.conf'
            source.write_text(content)
            run('sudo', 'install', '-Dm644', source, destination)
    run('sudo', 'systemctl', 'daemon-reload', dry=dry)
    print('Autologin takes effect at the next boot; the running getty is left alone.')


def firewall(dry):
    """Install and activate the host policy without restarting other firewall tables."""
    source = REPO / 'system/nftables.conf'
    override = 'systemd/system/nftables.service.d/10-linux-config.conf'
    files = ((source, Path('/etc/nftables.conf')),
             (REPO / 'system/systemd/nftables.service.d/10-linux-config.conf',
              Path('/etc') / override))
    # Check against the current ruleset before replacing boot configuration.
    run('sudo', 'nft', '--check', '--file', source, dry=dry)
    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    for source, destination in files:
        if dry:
            print(f'Back up {destination} if present, then install {source}')
            continue
        exists = subprocess.run(['sudo', 'test', '-e', str(destination)])
        if exists.returncode not in (0, 1):
            raise subprocess.CalledProcessError(exists.returncode, exists.args)
        if exists.returncode == 0 or destination.is_symlink():
            backup = Path('/var/backups/linux-config') / stamp / 'firewall' / destination.relative_to('/etc')
            run('sudo', 'install', '-d', '-m', '0700', backup.parent)
            run('sudo', 'cp', '-a', destination, backup)
        run('sudo', 'install', '-Dm644', source, destination)
    run('sudo', 'systemctl', 'daemon-reload', dry=dry)
    run('sudo', 'systemctl', 'enable', '--now', 'nftables.service', dry=dry)
    # An already-active service still needs to load the newly installed rules.
    # Reload is atomic and touches only inet linux_config; never restart/flush all.
    run('sudo', 'systemctl', 'reload', 'nftables.service', dry=dry)
    run('sudo', 'systemctl', 'is-enabled', '--quiet', 'nftables.service', dry=dry)
    run('sudo', 'systemctl', 'is-active', '--quiet', 'nftables.service', dry=dry)
    run('sudo', 'nft', 'list', 'table', 'inet', 'linux_config', dry=dry)


def host_settings(user, dry, virtualization):
    # adm and systemd-journal let the health report and update notifier read
    # /var/log and the system journal without sudo.
    groups = 'video,adm,systemd-journal' + (',libvirt,kvm' if virtualization else '')
    run('sudo', 'usermod', '-aG', groups, user, dry=dry)
    run('sudo', 'usermod', '-s', '/bin/zsh', user, dry=dry)
    locales = subprocess.run(['locale', '-a'], capture_output=True, text=True, check=True).stdout.lower()
    if 'en_us.utf8' not in locales:
        # Through /etc/locale.gen, so the locales package keeps it on its next regeneration.
        run('sudo', 'sed', '-i', r's/^#\s*\(en_US\.UTF-8 UTF-8\)/\1/', '/etc/locale.gen', dry=dry)
        run('sudo', 'locale-gen', dry=dry)
    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    for name in ('20auto-upgrades', '90linux-config-unattended-upgrades'):
        source = REPO / 'system/apt/apt.conf.d' / name
        dest = Path('/etc/apt/apt.conf.d') / name
        if dest.is_file() and dest.read_bytes() == source.read_bytes():
            continue
        backup = Path('/var/backups/linux-config') / stamp / name
        if dry:
            print(f'Back up {dest} if present, then install {source}')
        else:
            exists = subprocess.run(['sudo', 'test', '-e', str(dest)]).returncode == 0
            if exists:
                run('sudo', 'install', '-d', '-m', '0700', backup.parent)
                run('sudo', 'cp', '-a', dest, backup)
            run('sudo', 'install', '-Dm644', source, dest)
    services = ['libvirtd.service'] if virtualization else []
    run('sudo', 'systemctl', 'enable', '--now', *services, 'apt-daily.timer', 'apt-daily-upgrade.timer', dry=dry)


def home_row_mods(dry):
    """Install keyd and the home row modifier map for the built-in laptop keyboard.

    keyd matches the keyboard by ID, so external boards keep their own layout.
    Debian has to offer the package; otherwise setup says so and moves on.
    """
    policy = subprocess.run(['apt-cache', 'policy', 'keyd'], capture_output=True, text=True).stdout
    if 'Candidate:' not in policy or 'Candidate: (none)' in policy:
        print('Notice: APT does not offer keyd, so home row modifiers were skipped. See docs/keyboard.md.')
        return
    run('sudo', 'apt-get', 'install', '-y', 'keyd', dry=dry)
    source = REPO / 'system/keyd/laptop.conf'
    dest = Path('/etc/keyd/laptop.conf')
    if not (dest.is_file() and dest.read_bytes() == source.read_bytes()):
        stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
        backup = Path('/var/backups/linux-config') / stamp / 'keyd/laptop.conf'
        if dry:
            print(f'Back up {dest} if present, then install {source}')
        else:
            if subprocess.run(['sudo', 'test', '-e', str(dest)]).returncode == 0:
                run('sudo', 'install', '-d', '-m', '0700', backup.parent)
                run('sudo', 'cp', '-a', dest, backup)
            run('sudo', 'install', '-Dm644', source, dest)
    run('sudo', 'systemctl', 'enable', 'keyd.service', dry=dry)
    # A running daemon only reads its config at start. Restart through systemd,
    # since Debian may not name the keyd command keyd.
    run('sudo', 'systemctl', 'restart', 'keyd.service', dry=dry)


def ifupdown_stanzas(lines):
    """Split /etc/network/interfaces into (name, method, options, line numbers) per iface stanza."""
    stanzas, current = [], None
    for number, line in enumerate(lines):
        words = line.split()
        if not words or line.startswith('#'):
            continue
        if words[0] in ('auto', 'allow-hotplug', 'allow-auto', 'iface', 'mapping', 'source', 'source-directory'):
            current = None
            if words[0] in ('iface', 'mapping') and len(words) > 1 and words[1] != 'lo':
                current = {'name': words[1], 'method': words[-1] if words[0] == 'iface' else 'mapping',
                           'options': {}, 'lines': [number]}
                stanzas.append(current)
            elif words[0] in ('auto', 'allow-hotplug', 'allow-auto') and words[1:] and words[1:] != ['lo']:
                stanzas.append({'name': words[1], 'method': 'auto', 'options': {}, 'lines': [number]})
        elif current is not None:
            current['options'][words[0]] = ' '.join(words[1:])
            current['lines'].append(number)
    return stanzas


def network_manager(dry):
    """Hand interfaces the Debian installer gave ifupdown to NetworkManager.

    NetworkManager leaves any interface named in /etc/network/interfaces unmanaged,
    so wifi-menu and the status panel would see nothing on such a machine while
    dhcpcd keeps running beside it. DHCP stanzas are commented out, and a Wi-Fi
    stanza's network becomes a NetworkManager connection so the laptop comes back
    online after the reboot. Static stanzas stay with ifupdown and are reported:
    translating addresses, routes and DNS is a decision, not a rewrite. The
    loopback stays. The change applies at the next boot.
    """
    interfaces = Path('/etc/network/interfaces')
    if not interfaces.is_file():
        return
    try:
        text = interfaces.read_text()
    except PermissionError:
        # The installer makes the file root-only when it holds a Wi-Fi passphrase.
        if dry:
            print(f'Notice: {interfaces} is readable only by root; a real run reads it with sudo.')
            return
        text = run('sudo', 'cat', interfaces, capture_output=True, text=True).stdout
    lines = text.splitlines(keepends=True)
    stanzas = ifupdown_stanzas(lines)
    static = {s['name'] for s in stanzas if s['method'] not in ('dhcp', 'auto', 'manual')}
    for name in sorted(static):
        print(f'Notice: {name} has a static or non-DHCP stanza in {interfaces}; left with ifupdown. '
              'Move it to NetworkManager yourself (nmcli connection add) and remove the stanza.')
    handed_over = {s['name'] for s in stanzas} - static
    if not handed_over:
        return
    commented = {n for s in stanzas if s['name'] in handed_over for n in s['lines']}
    rendered = [('# ' + line if number in commented else line) for number, line in enumerate(lines)]
    wifi = []
    for stanza in stanzas:
        if stanza['name'] not in handed_over or stanza['method'] != 'dhcp':
            continue
        options = stanza['options']
        if options.get('wpa-ssid') and options.get('wpa-psk'):
            wifi.append((stanza['name'], options['wpa-ssid'].strip('"'), options['wpa-psk'].strip('"')))
        elif any(key.startswith('wpa-') for key in options):
            print(f"Notice: {stanza['name']} uses {', '.join(k for k in options if k.startswith('wpa-'))}, "
                  'which setup does not translate; reconnect with wifi-menu after the reboot.')
    print(f'Hand {", ".join(sorted(handed_over))} from ifupdown to NetworkManager in {interfaces}', flush=True)
    for name, ssid, _ in wifi:
        print(f'Add NetworkManager connection "{ssid}" for {name} from the installer\'s Wi-Fi settings', flush=True)
    if dry:
        return
    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
    backup = Path('/var/backups/linux-config') / stamp / 'network/interfaces'
    run('sudo', 'install', '-d', '-m', '0700', backup.parent)
    run('sudo', 'cp', '-a', interfaces, backup)
    with tempfile.TemporaryDirectory(prefix='linux-config-network-') as temporary:
        temporary = Path(temporary)
        source = temporary / 'interfaces'
        source.write_text('# linux-config setup commented out the stanzas below; NetworkManager owns these interfaces.\n'
                          + ''.join(rendered))
        # Commented stanzas still carry the passphrase, so the file stays root-only.
        run('sudo', 'install', '-Dm600', source, interfaces)
        for name, ssid, psk in wifi:
            # A keyfile keeps the passphrase out of argument lists and process listings.
            keyfile = temporary / f'{ssid}.nmconnection'
            keyfile.write_text(f'[connection]\nid={ssid}\nuuid={uuid.uuid4()}\ntype=wifi\n'
                               f'interface-name={name}\nautoconnect=true\n\n'
                               f'[wifi]\nssid={ssid}\nmode=infrastructure\n\n'
                               f'[wifi-security]\nkey-mgmt=wpa-psk\npsk={psk}\n\n'
                               '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n')
            run('sudo', 'install', '-Dm600', keyfile, Path('/etc/NetworkManager/system-connections') / keyfile.name)
    if wifi:
        run('sudo', 'nmcli', 'connection', 'reload')
    print('NetworkManager takes over at the next boot; the running connection is left alone.')


def leftover_services():
    """Point out listening services this setup neither installs nor opens in the firewall."""
    for unit in ('ssh.service', 'avahi-daemon.service'):
        if subprocess.run(['systemctl', 'is-active', '--quiet', unit]).returncode == 0:
            print(f'Notice: {unit} is running but not part of this setup; the firewall drops its incoming '
                  f'traffic. Keep it for remote access (see docs/firewall.md) or run: '
                  f'sudo systemctl disable --now {unit}')


def package_list(path):
    if not path.is_file():
        return []
    return [line.strip() for line in path.read_text().splitlines() if line.strip() and not line.startswith('#')]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true', help='Print the plan without downloads, sudo or file changes')
    parser.add_argument('--backups', action='store_true', help='Also install Restic; backups remain disabled until configured')
    parser.add_argument('--dev-tools', action='store_true', help='Also install optional editor development tools')
    parser.add_argument('--autologin', action='store_true',
                        help='Log this user in on tty1 at boot; pair with full-disk encryption')
    args = parser.parse_args()
    if os.geteuid() == 0:
        parser.error('Run as your normal desktop user; the script calls sudo only when needed')
    release = dict(line.split('=', 1) for line in Path('/etc/os-release').read_text().splitlines() if '=' in line)
    if release.get('ID', '').strip('"') != 'debian' or release.get('VERSION_ID', '').strip('"') != '13':
        parser.error('This setup supports Debian 13')
    machine = platform.machine()
    if machine not in ARCHITECTURES:
        parser.error(f'This setup supports {" and ".join(ARCHITECTURES)}, not {machine}')
    home = Path.home().resolve()
    if not (home / '.local').resolve().is_relative_to(home):
        parser.error('~/.local must stay inside your home directory')
    user = pwd.getpwuid(os.getuid()).pw_name
    os.environ['PATH'] = f'{home}/.local/bin:' + os.environ['PATH']
    # New directories and backups stay private whatever umask the login shell has.
    os.umask(0o077)
    packages = set(package_list(REPO / 'packages.txt')) | set(package_list(REPO / f'packages.{machine}.txt'))
    if args.backups:
        packages.add('restic')
    packages = sorted(packages)
    # On a rerun the OpenSnitch UI is already up: let apt through before it is used.
    if opensnitch_rules(args.dry_run) and not args.dry_run:
        run('sudo', 'systemctl', 'try-restart', 'opensnitch.service')
    run('sudo', 'apt-get', 'update', dry=args.dry_run)
    run('sudo', 'apt-get', 'install', '-y', *packages, dry=args.dry_run)
    firewall(args.dry_run)
    applications(home, args.dry_run)
    # The sub-installers have their own dry runs; show their plans instead of only their names.
    run(REPO / 'scripts/setup-shell', *(['--dry-run'] if args.dry_run else []))
    portal(home, args.dry_run)
    editor = [str(REPO / 'scripts/setup-editor'), '--skip-apt']
    if args.dev_tools:
        # setup-editor skips its APT stage when called here.
        run('sudo', 'apt-get', 'install', '-y', 'build-essential', 'clangd', 'clang-format', 'ipython3', 'nodejs', 'npm', 'shellcheck', dry=args.dry_run)
        editor.append('--dev-tools')
    colors_present = (home / '.config/sway/colors').is_file()
    run(*editor, dry=args.dry_run)
    if args.dry_run:
        run(REPO / 'scripts/install', '--dry-run')
    # setup-editor applies user files and installs/checks Neovim plugins.
    current = home / '.cache/theme/current'
    if current.is_file():
        # Re-render the selected palette so updated templates reach every target.
        run(home / '.local/bin/theme', 'apply', current.read_text().strip(), dry=args.dry_run)
    elif not colors_present:
        run(home / '.local/bin/theme', 'apply', 'summer-dusk', dry=args.dry_run)
    host_settings(user, args.dry_run, 'libvirt-daemon-system' in packages)
    network_manager(args.dry_run)
    home_row_mods(args.dry_run)
    if args.autologin:
        autologin(user, args.dry_run)
    if shutil.which('tailscale'):
        # Let the desktop user toggle Tailscale without sudo; vpn-off relies on this.
        run('sudo', 'tailscale', 'set', f'--operator={user}', dry=args.dry_run)
    opensnitch(args.dry_run)
    if args.dry_run or Path(f'/run/user/{os.getuid()}/bus').exists():
        run('systemctl', '--user', 'daemon-reload', dry=args.dry_run)
        run('systemctl', '--user', 'enable', '--now', 'sysreport.timer', dry=args.dry_run)
    else:
        timer_link = home / '.config/systemd/user/timers.target.wants/sysreport.timer'
        timer_link.parent.mkdir(parents=True, exist_ok=True)
        if not timer_link.exists() and not timer_link.is_symlink():
            timer_link.symlink_to('../sysreport.timer')
        print('No user bus: log in to the desktop to load user services')
    run('bash', REPO / 'scripts/install-receipt', REPO, home, 'setup', dry=args.dry_run)
    leftover_services()
    print('Plan complete.' if args.dry_run else 'Setup complete. Log out/in (or reboot) to apply groups, shell and portals; restart Firefox.')
    print('Disk encryption, lid rules and hardware tests remain separate; see docs/installation.md.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        raise SystemExit(f'Setup stopped: {error}\nFix the failed step and rerun scripts/setup; completed installations are preserved.')
