#!/bin/bash
# Install a lightweight editor; development tools require --dev-tools.
set -euo pipefail
umask 077
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
dev_tools=false
skip_apt=false
for argument in "$@"; do
    case "$argument" in
        --dev-tools) dev_tools=true ;;
        --skip-apt) skip_apt=true ;;
        --help)
            echo 'Usage: scripts/setup-editor [--dev-tools] [--skip-apt]'
            echo 'Installs Neovim, plugins, IPython, jq and bat'
            echo '--dev-tools adds compilers, Node, language servers, formatters and parsers'
            exit 0 ;;
        *) echo "Unknown option: $argument" >&2; exit 1 ;;
    esac
done
if ! "$skip_apt"; then
    sudo apt-get update
    sudo apt-get install -y ipython3 jq bat git curl unzip ca-certificates python3 python3-jinja2 python3-yaml
    if "$dev_tools"; then
        sudo apt-get install -y build-essential clangd clang-format nodejs npm
    fi
fi
export PATH="$HOME/.local/bin:$PATH"
# The Debian 13 package is older than this configuration supports.
if ! command -v nvim >/dev/null || ! nvim --headless -u NONE '+lua if vim.fn.has("nvim-0.12") == 0 then vim.cmd("cquit 1") end' +qa; then
    case $(uname -m) in
        x86_64) nvim_arch=x86_64 ;;
        aarch64) nvim_arch=arm64 ;;
        *) echo 'Install Neovim 0.12 or newer for this architecture' >&2; exit 1 ;;
    esac
    nvim_version=${NVIM_VERSION:-v0.12.2}
    [[ "$nvim_version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Invalid NVIM_VERSION" >&2; exit 1; }
    # Digests pinned from the official release assets; never execute unchecked downloads.
    nvim_sha256=${NVIM_SHA256:-}
    if [[ -z "$nvim_sha256" && "$nvim_version" == v0.12.2 ]]; then
        case "$nvim_arch" in
            x86_64) nvim_sha256=31cf85945cb600d96cdf69f88bc68bec814acbff50863c5546adef3a1bcef260 ;;
            arm64) nvim_sha256=f697d4e4582b6e4b5c3c26e76e06ce26efa08ba1768e03fd2733fcc422bb0490 ;;
        esac
    fi
    [[ "$nvim_sha256" =~ ^[[:xdigit:]]{64}$ ]] || { echo "Set NVIM_SHA256 to the verified release checksum" >&2; exit 1; }
    download_dir=$(mktemp -d)
    trap 'rm -rf -- "$download_dir"' EXIT
    curl --proto '=https' --tlsv1.2 --fail --location --retry 3 "https://github.com/neovim/neovim/releases/download/$nvim_version/nvim-linux-$nvim_arch.tar.gz" -o "$download_dir/nvim.tar.gz"
    printf '%s  %s\n' "$nvim_sha256" "$download_dir/nvim.tar.gz" | sha256sum --check --status || {
        echo 'Neovim checksum failed
Nothing installed' >&2
        exit 1
    }
    mkdir -p "$download_dir/nvim"
    tar -xzf "$download_dir/nvim.tar.gz" -C "$download_dir/nvim" --strip-components=1
    "$download_dir/nvim/bin/nvim" --headless -u NONE '+lua assert(vim.fn.has("nvim-0.12") == 1)' +qa
    mkdir -p "$HOME/.local/bin"
    if [[ -e "$HOME/.local/nvim" ]]; then
        mv "$HOME/.local/nvim" "$HOME/.local/nvim.backup.$(date +%s%N)"
    fi
    mv "$download_dir/nvim" "$HOME/.local/nvim"
    ln -sfnT "$HOME/.local/nvim/bin/nvim" "$HOME/.local/bin/nvim"
fi
"$repo_dir/scripts/install"
nvim --headless '+Lazy! install' '+lua for name, plugin in pairs(require("lazy.core.config").plugins) do if not plugin._.installed or require("lazy.core.plugin").has_errors(plugin) then vim.api.nvim_err_writeln("Plugin installation failed: " .. name); vim.cmd("cquit 1") end end' +qa
if "$dev_tools"; then
    export LINUX_CONFIG_EDITOR_SETUP="$repo_dir/scripts/editor-tools.lua"
    nvim --headless '+lua dofile(vim.env.LINUX_CONFIG_EDITOR_SETUP)' +qa
fi
"$repo_dir/scripts/check"
echo 'Editor ready
Use --dev-tools to add development tools'
