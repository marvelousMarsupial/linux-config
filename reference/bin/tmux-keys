#!/bin/bash
# tmux keybindings cheatsheet

cat << 'EOF'

  TMUX KEYBINDINGS (Alt-based, no prefix needed)

  NAVIGATION (no prefix)
  Alt + h/j/k/l         Focus pane (integrates with nvim)
  Alt + Shift + H/J/K/L Resize pane

  SPLITS (no prefix)
  Alt + Enter           Vertical split (side-by-side)
  Alt + s               Horizontal split (stacked)
  Alt + v               Vertical split + nvim
  Alt + e               Vertical split + yazi
  Alt + Shift + V       Horizontal split + nvim
  Alt + Shift + E       Horizontal split + yazi

  PANES (no prefix)
  Alt + q               Kill pane
  Alt + z               Zoom pane (fullscreen toggle)

  COPY MODE (no prefix)
  Alt + [               Enter copy mode (vi keys)
  Alt + ]               Paste buffer
  v                     Start selection (in copy mode)
  y                     Copy to clipboard (in copy mode)
  q                     Exit copy mode

  SESSIONS (no prefix)
  Alt + d               Detach
  Alt + n               New session
  Alt + (               Previous session
  Alt + )               Next session

  PREFIX COMMANDS (Ctrl+Space + key)
  prefix + r            Reload config

  NESTED SESSIONS
  F12                   Toggle local/remote (dims status bar)

  COMMAND LINE
  tmux ls               List sessions
  tmux new -s name      New named session
  tmux a -t name        Attach to session
  tmux kill-session -t  Kill session
  tmux kill-session -a  Kill all except current
  tmux kill-server      Kill everything

EOF

read -rn 1 -s
