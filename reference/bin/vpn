#!/usr/bin/env python3
"""vpn - WireGuard helper for managing VPN connections"""

import re
import socket
import subprocess
import sys
from pathlib import Path

DEFAULT_INTERFACE = "wg0"

def run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess:
    """Run a command."""
    return subprocess.run(cmd, check=check)

def run_output(cmd: list[str]) -> str:
    """Run a command and return stdout."""
    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
        return result.stdout if result.returncode == 0 else ""
    except FileNotFoundError:
        return ""

def sudo_read_file(path: Path) -> str:
    """Read a file with sudo."""
    result = subprocess.run(["sudo", "cat", str(path)], capture_output=True, text=True)
    return result.stdout if result.returncode == 0 else ""

def has_wg_config(interface: str) -> bool:
    """Check if WireGuard config exists."""
    config = Path(f"/etc/wireguard/{interface}.conf")
    result = subprocess.run(["sudo", "test", "-f", str(config)], capture_output=True)
    return result.returncode == 0

def is_server(interface: str) -> bool:
    """Check if this is a WireGuard server (has ListenPort)."""
    config = sudo_read_file(Path(f"/etc/wireguard/{interface}.conf"))
    return "ListenPort" in config

def get_wg_ip(interface: str) -> str:
    """Get WireGuard interface IP."""
    output = run_output(["ip", "-4", "addr", "show", interface])
    match = re.search(r"inet\s+(\d+\.\d+\.\d+\.\d+)", output)
    return match.group(1) if match else ""

def get_peer_ip(interface: str) -> str:
    """Get peer IP from WireGuard config."""
    config = sudo_read_file(Path(f"/etc/wireguard/{interface}.conf"))
    match = re.search(r"AllowedIPs\s*=\s*(\d+\.\d+\.\d+\.\d+)", config)
    return match.group(1) if match else ""

def command_exists(cmd: str) -> bool:
    """Check if a command exists."""
    return subprocess.run(["which", cmd], capture_output=True).returncode == 0

def notify(title: str, msg: str, critical: bool = False) -> None:
    """Send desktop notification."""
    if command_exists("notify-send"):
        cmd = ["notify-send"]
        if critical:
            cmd.extend(["-u", "critical"])
        cmd.extend([title, msg])
        subprocess.run(cmd, capture_output=True)

def list_interfaces() -> list[str]:
    """List available WireGuard configs, sorted."""
    wg_dir = Path("/etc/wireguard")
    result = subprocess.run(["sudo", "ls", str(wg_dir)], capture_output=True, text=True)
    if result.returncode != 0:
        return []
    interfaces = sorted([f.replace(".conf", "") for f in result.stdout.split() if f.endswith(".conf")])
    return interfaces

def resolve_interface(arg: str | None) -> str:
    """Resolve interface from argument (number, name, or default)."""
    if arg is None:
        return DEFAULT_INTERFACE

    # If it's a number, get interface by index
    if arg.isdigit():
        idx = int(arg)
        interfaces = list_interfaces()
        if idx < len(interfaces):
            return interfaces[idx]
        else:
            print(f"Error: No interface at index {idx}")
            print(f"Available: {', '.join(f'{i}={iface}' for i, iface in enumerate(interfaces))}")
            sys.exit(1)

    # Otherwise treat as interface name
    return arg

def cmd_up(interface: str) -> None:
    """Bring up WireGuard."""
    result = subprocess.run(["sudo", "wg-quick", "up", interface])
    if result.returncode == 0:
        wg_ip = get_wg_ip(interface)
        notify("VPN Connected", f"{interface}: {wg_ip}")
    else:
        notify("VPN Failed", f"Could not connect {interface}", critical=True)

def cmd_down(interface: str) -> None:
    """Bring down WireGuard."""
    result = subprocess.run(["sudo", "wg-quick", "down", interface])
    if result.returncode == 0:
        notify("VPN Disconnected", f"{interface} is down")

def cmd_status(interface: str) -> None:
    """Show WireGuard status."""
    run(["sudo", "wg", "show", interface], check=False)

def cmd_list() -> None:
    """List available interfaces with indices."""
    interfaces = list_interfaces()
    if not interfaces:
        print("No WireGuard configs found in /etc/wireguard/")
        return
    print("Available interfaces:")
    for i, iface in enumerate(interfaces):
        wg_ip = get_wg_ip(iface)
        status = f"({wg_ip})" if wg_ip else "(down)"
        print(f"  {i}: {iface} {status}")

def cmd_info(interface: str) -> None:
    """Show detailed info about an interface."""
    host = socket.gethostname()
    wg_ip = get_wg_ip(interface)
    peer_ip = get_peer_ip(interface)

    print(f"VPN ({interface}) - {host}")
    print()

    # Status
    if wg_ip:
        print(f"STATUS: connected ({wg_ip})")
    else:
        print("STATUS: not connected")

    # Role info
    if has_wg_config(interface):
        if is_server(interface):
            print(f"ROLE:   server (peer: {peer_ip})")
            if command_exists("remote-start"):
                print()
                print("REMOTE DESKTOP:")
                print("  rstart     → remote-start   Start Sway + wayvnc")
                print("  rstop      → remote-stop    Stop remote desktop")
        else:
            print(f"ROLE:   client (server: {peer_ip})")
            if peer_ip:
                print()
                print(f"CONNECT: vncviewer {peer_ip}:5900")
    else:
        print()
        print(f"NOTE: /etc/wireguard/{interface}.conf not found")
    print()

def show_help() -> None:
    """Show help message."""
    print("""vpn - WireGuard VPN helper

USAGE:
  vpn [command] [interface]

COMMANDS:
  up [N|name]     Bring up interface (default: wg0)
  down [N|name]   Bring down interface
  status [N|name] Show wg status
  list            List available interfaces
  info [N|name]   Show connection info (default)

INTERFACE:
  Can be a number (index from 'vpn list') or name
  Examples: vpn up 0, vpn up 1, vpn up wg0, vpn up laptop

ALIASES:
  vpnup [N]       → vpn up [N]
  vpndown [N]     → vpn down [N]
  vpnstat [N]     → vpn status [N]

EXAMPLES:
  vpn                  Show info for wg0
  vpn up               Bring up wg0
  vpn up 1             Bring up interface #1
  vpn up laptop        Bring up 'laptop' interface
  vpn list             Show all interfaces with indices
  vpn status           Show wg0 status
""")

def main() -> None:
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help", "help"):
        show_help()
        return

    cmd = args[0]
    iface_arg = args[1] if len(args) > 1 else None

    if cmd == "up":
        interface = resolve_interface(iface_arg)
        cmd_up(interface)
    elif cmd == "down":
        interface = resolve_interface(iface_arg)
        cmd_down(interface)
    elif cmd in ("status", "stat"):
        interface = resolve_interface(iface_arg)
        cmd_status(interface)
    elif cmd in ("list", "ls"):
        cmd_list()
    elif cmd == "info":
        interface = resolve_interface(iface_arg)
        cmd_info(interface)
    else:
        # Maybe they passed an interface directly: vpn wg1
        interface = resolve_interface(cmd)
        cmd_info(interface)

if __name__ == "__main__":
    main()
