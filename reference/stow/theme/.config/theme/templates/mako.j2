# {{ scheme }} - Generated by theme switcher

# Base settings
font=monospace 12
width=350
height=120
margin=10
padding=15
border-size=2
border-radius=8
default-timeout=5000
max-visible=3
anchor=top-right

# Default colors
background-color=#{{ base01 }}
text-color=#{{ base05 }}
border-color=#{{ base0D }}
progress-color=#{{ base0D }}

[urgency=low]
background-color=#{{ base01 }}
border-color=#{{ base03 }}

[urgency=high]
background-color=#{{ base01 }}
border-color=#{{ base08 }}

# OSD-style status popup (centered, larger, shorter timeout)
[app-name=status-osd]
anchor=center
width=400
height=200
font=monospace 18
border-size=3
border-radius=16
default-timeout=2500
background-color=#{{ base00 }}ee
border-color=#{{ base0D }}

# Alias reminder (small, corner, subtle)
[app-name=alias]
anchor=bottom-right
width=200
height=60
font=monospace 10
padding=8
border-size=1
border-radius=6
default-timeout=1500
background-color=#{{ base00 }}cc
border-color=#{{ base03 }}
text-color=#{{ base04 }}
