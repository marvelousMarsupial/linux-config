# Sway config
# Philosophy: tmux is your window manager. Sway just holds terminals.
# hjkl is ALWAYS movement. Modifier determines scope.

# ===========================================
# VARIABLES
# ===========================================

set $mod Mod4
set $term foot
set $bin /home/august/.local/bin
set $menu $bin/launcher

set $left h
set $down j
set $up k
set $right l

# Include theme colors
include ~/.config/sway/colors


# ===========================================
# MONITORS
# ===========================================
#
# Per-output mode/position/transform/scale is owned entirely by kanshi
# (see ~/.config/kanshi/config). Hard-coding `output <NAME> ...` lines
# here as well caused two persistent bugs:
#
#   1. Connector names (DP-5, DP-6, ...) shift across cable swaps and
#      dock reboots, so a static `output DP-6 ...` line eventually
#      starts targeting the wrong physical panel. Kanshi sidesteps
#      this by matching on `Make Model Serial` from EDID instead.
#
#   2. When both kanshi and sway try to configure the same output,
#      whichever runs last wins, and on `swaymsg reload` the static
#      sway lines fired again and clobbered kanshi's portrait-rotated
#      layout. Removing them puts kanshi in sole control.
#
# The only output line we keep is the wildcard wallpaper assignment
# below, which kanshi does not touch.

# Wallpaper (falls back to theme color if file missing)
output * bg ~/.config/sway/wallpaper fill $base00

# ===========================================
# APPEARANCE (minimal)
# ===========================================

# Whitespace between tiled windows (inner) and between the outermost
# windows and the screen edge (outer).
#
# Sway adds the outer value ON TOP of the inner value when computing
# the edge-to-window distance (sway(5): "Outer gaps are added to the
# inner gaps"). So `gaps inner 3` + `gaps outer 3` would render as
# 3 px between adjacent tiled windows but 6 px from the screen edge
# to the outermost window — the screen-edge stripe ends up visibly
# twice as wide as the between-window stripe, which reads as the
# layout floating in a frame rather than tiling cleanly to the edge.
#
# Setting outer to 0 makes the effective edge gap equal to the
# inner gap (0 + 3 = 3 px), so every visible whitespace stripe in
# the layout — between windows AND between the outermost window
# and the screen edge — is the same 3 px.
gaps inner 3
gaps outer 0

# Window border thickness (the focus-outline drawn by sway around
# the focused container). A 1px outline is hard to spot at a glance
# — easy to lose track of which window will receive a keystroke
# when more than one is visible. 3px is wide enough to be
# unambiguously visible without eating noticeable screen real
# estate. The `for_window [app_id="keybinds"] ... border pixel 3`
# rule lower in the file already used 3 — the default now matches
# so floating popups and tiled windows look consistent.
default_border pixel 3
default_floating_border pixel 3

# Hide borders when only one window (disabled - may not work on all sway versions)
# smart_borders on

# Hide gaps when only one window
# smart_gaps on

# ===========================================
# INPUT
# ===========================================

input type:keyboard {
    xkb_options ctrl:nocaps
    repeat_delay 300
    repeat_rate 50
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
}

# ===========================================
# BEHAVIOR
# ===========================================

# New windows open side-by-side
default_orientation horizontal
for_window [app_id=".*"] layout splith

focus_follows_mouse no
mouse_warping none
popup_during_fullscreen smart
floating_modifier $mod normal

# ===========================================
# NAVIGATION (Super + hjkl or arrows)
# ===========================================

# Focus window (hjkl)
bindsym --to-code $mod+$left focus left
bindsym --to-code $mod+$down focus down
bindsym --to-code $mod+$up focus up
bindsym --to-code $mod+$right focus right

# Focus window (arrows)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move window (hjkl)
bindsym --to-code $mod+Shift+$left move left
bindsym --to-code $mod+Shift+$down move down
bindsym --to-code $mod+Shift+$up move up
bindsym --to-code $mod+Shift+$right move right

# Move window (arrows)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Resize window (hjkl)
bindsym --to-code $mod+Ctrl+$left resize shrink width 50px
bindsym --to-code $mod+Ctrl+$right resize grow width 50px
bindsym --to-code $mod+Ctrl+$up resize shrink height 50px
bindsym --to-code $mod+Ctrl+$down resize grow height 50px

# Resize window (arrows)
bindsym $mod+Ctrl+Left resize shrink width 50px
bindsym $mod+Ctrl+Right resize grow width 50px
bindsym $mod+Ctrl+Up resize shrink height 50px
bindsym $mod+Ctrl+Down resize grow height 50px

# Focus parent container
bindsym --to-code $mod+a focus parent

# Cycle through windows (Alt+Tab)
bindsym Alt+Tab focus next
bindsym Alt+Shift+Tab focus prev

# ===========================================
# WORKSPACES
# ===========================================

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Cycle workspaces
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# ===========================================
# OUTPUTS (Multi-monitor)
# ===========================================

# Focus next output
bindsym --to-code $mod+o focus output right

# Move workspace to next output
bindsym --to-code $mod+Shift+o move workspace to output right

# ===========================================
# LAYOUT
# ===========================================

# Splits (match tmux: \ and -)
bindsym $mod+backslash splith
bindsym $mod+minus splitv

# Fullscreen
bindsym --to-code $mod+f fullscreen toggle

# Floating
bindsym --to-code $mod+Shift+space floating toggle

# Toggle split/tabbed
bindsym --to-code $mod+t layout toggle split

# Sticky (stays on all workspaces)
bindsym --to-code $mod+Shift+s sticky toggle

# Scratchpad
bindsym $mod+grave scratchpad show
bindsym $mod+Shift+grave move scratchpad

# ===========================================
# APPS
# ===========================================

# Terminal (unset TMUX so new terminals start fresh tmux sessions)
bindsym $mod+Return exec env -u TMUX $term

# Launcher (Space is easy to hit)
bindsym $mod+Space exec $menu

# Browser. `$bin/zen` is the wrapper at ~/.local/bin/zen that execs the
# tarball-installed launcher at ~/.local/zen/zen with MOZ_ENABLE_WAYLAND=1.
# (Was previously `flatpak run app.zen_browser.zen --ozone-platform-hint=auto`
# — see the desktop role's `zen-browser` Download for the migration.)
#
# We spell the path in full via `$bin/...` instead of bare `zen` for the
# same reason every other dotfile-script bindsym in this file does:
# sway's `exec` shells out via `/bin/sh -c` against whatever PATH the
# sway process inherited at launch, which on a headless / non-login
# session can omit `~/.local/bin` entirely. `$bin` is pinned absolute
# (`/home/august/.local/bin`) so the keybind works regardless of how
# sway got started.
bindsym --to-code $mod+b exec $bin/zen

# Notes - new vim note (foot+nvim with timestamp filename)
bindsym $mod+n exec $bin/notes-toggle

# Notes - search existing (fuzzel picker over ~/vault)
bindsym --to-code $mod+m exec $bin/notes-picker

# Obsidian. Same Electron Wayland flag as the browser.
bindsym --to-code $mod+Shift+n exec flatpak run md.obsidian.Obsidian --ozone-platform-hint=auto

# File manager
bindsym --to-code $mod+e exec $term -e yazi

# Password manager (pass with fuzzel picker)
bindsym --to-code $mod+p exec $bin/pass-picker

# Editor (vim)
bindsym $mod+v exec $term -e ~/.local/bin/nvim

# Dictation - local Whisper push-to-toggle (offline, no cloud).
#
# First press starts a pw-record capture; second press stops the
# recorder, POSTs the WAV to a loopback whisper-server (lazy-started
# user systemd unit holding the small.en-q5_1 model in memory), and
# types the transcription directly into the focused window via wtype.
# The clipboard is intentionally left untouched.
#
# Mod+Ctrl+s aborts an in-flight recording. To free the ~330 MiB the
# model holds in RAM when you're done dictating for a while, run
# `dictate stop-server` from a terminal — the next Mod+s press
# lazy-restarts it.
bindsym --to-code $mod+s exec $bin/dictate
bindsym --to-code $mod+Ctrl+s exec $bin/dictate cancel


# Power menu (lock, suspend, logout, reboot, shutdown)
bindsym --to-code $mod+x exec $bin/power-menu

# ===========================================
# WINDOW MANAGEMENT
# ===========================================

# Kill focused window
bindsym --to-code $mod+q kill

# Reload config
bindsym --to-code $mod+Shift+c reload

# Exit sway
bindsym --to-code $mod+Shift+e exec swaymsg exit

# ===========================================
# SYSTEM
# ===========================================

# Help (keybindings cheatsheet)
bindsym $mod+Shift+slash exec $term --app-id=keybinds -e $bin/keybinds

# Lock screen
bindsym $mod+Escape exec swaylock

# VNC passthrough mode (pass all keys to remote)
bindsym $mod+Ctrl+p mode "passthrough"
mode "passthrough" {
    bindsym $mod+Ctrl+p mode "default"
}

# Status OSD (time, battery, network, bluetooth)
bindsym --to-code $mod+i exec $bin/status-panel

# System monitor (btop in floating terminal)
bindsym --to-code $mod+Shift+i exec $term --app-id=btop -e btop

# Bluetooth manager
bindsym --to-code $mod+Shift+b exec blueman-manager

# WiFi menu
bindsym --to-code $mod+w exec $bin/wifi-menu

# Containers / VMs picker — unified fuzzel menu over podman
# containers, incus LXCs, and libvirt-managed KVM VMs. Selecting
# an entry opens an action submenu (start / stop / resume /
# shell). The shell action auto-starts a stopped instance first
# and drops into bash/sh/serial console in a new foot window.
# See dotfiles/.local/bin/vm-menu for the picker itself.
bindsym --to-code $mod+c exec $bin/vm-menu

# USB eject all
bindsym --to-code $mod+u exec udiskie-umount -a && notify-send "USB" "All devices ejected"

# Clipboard history (10 items)
bindsym --to-code $mod+Shift+v exec cliphist list | head -10 | fuzzel --dmenu | cliphist decode | wl-copy

# ===========================================
# SCREENSHOTS
# ===========================================

# Selection: save to ~/Pictures AND copy to clipboard (the common
# case — drag a region, get both a permanent file and an
# immediately-pasteable clipboard payload). Implementation lives in
# $bin/screenshot so the save-then-copy chain, slurp-cancel
# handling, and ~/Pictures auto-create only need to be written
# once.
bindsym Print exec $bin/screenshot select

# Fullscreen: same save-and-copy behavior across all connected
# outputs. Using Shift+Print rather than $mod+Print so the modifier
# matches the "expanded scope" idiom Print already uses elsewhere
# (Shift = bigger region) and so the bind works without the user
# having to reach for Mod first.
bindsym Shift+Print exec $bin/screenshot full

# ===========================================
# MEDIA / BRIGHTNESS
# ===========================================

bindsym --locked XF86MonBrightnessUp exec brightnessctl set +10%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 10%-

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# ===========================================
# WINDOW RULES
# ===========================================

# Float utility windows
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
# pass-picker terminal popup
for_window [app_id="pass-prompt"] floating enable, resize set 720 350
for_window [title="File Operation Progress"] floating enable

# btop floating terminal (smaller window)
for_window [app_id="btop"] floating enable, resize set 900 600

# Keybindings help popup
for_window [app_id="keybinds"] floating enable, resize set 760 720, border pixel 3


# Notes scratchpad (floating, sticky, small window)
for_window [app_id="notes"] floating enable
for_window [app_id="notes"] sticky enable
for_window [app_id="notes"] resize set 500 400

# Inhibit idle for fullscreen
for_window [app_id=".*"] inhibit_idle fullscreen

# ===========================================
# AUTOSTART
# ===========================================

# Bring up the systemd user session that hosts sway-integrated
# services. The `sway-session` script:
#   1. exports XDG_CURRENT_DESKTOP / XDG_SESSION_TYPE / XDG_SESSION_DESKTOP
#   2. pushes WAYLAND_DISPLAY / SWAYSOCK / DISPLAY / cursor vars into
#      both dbus (`dbus-update-activation-environment`) and the user
#      systemd manager (`systemctl --user import-environment`)
#   3. starts `sway-session.target`, which `BindsTo=graphical-session.target`
#      and pulls in everything `WantedBy=sway-session.target` (kanshi.service)
#
# This single line subsumes the previous standalone
# `dbus-update-activation-environment` invocation that used to live
# here (the script does it as part of step 2) and replaces the
# previous `exec_always $bin/kanshi-restart` autostart — kanshi is
# now started by systemd via the unit file at
# ~/.config/systemd/user/kanshi.service, with proper `After=` and
# `PartOf=` ordering against graphical-session.target so it can't
# subscribe to wlr-output-management before sway-IPC is ready (the
# subscribe-before-ready race was the root cause of the boot-time
# wedge that left the launcher rendering off-screen).
#
# `exec` (not `exec_always`): the script already short-circuits if
# sway-session.target is active, so re-running it on `swaymsg
# reload` is a no-op. Keeping `exec` makes the no-op explicit and
# avoids reload-time DBus traffic.
exec $bin/sway-session

# Force dark mode for Flatpak apps (Obsidian, etc)
exec gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

exec mako
# udiskie auto-mounts removable media (USB sticks, external drives) into
# /run/media/$USER/<label>/ and pops a notification on plug. Flags:
#   --no-tray : this sway setup has no system tray, so the default
#               --tray would silently fail to start the daemon
#   --automount : mount as soon as a device shows up (the user-facing goal)
#   --notify : send a libnotify pop on every mount/unmount/error so the
#              user actually knows when a drive came online
# Browsing the mounted drives happens inside yazi via the `M` keybind
# (mount.yazi plugin) or the `gm` jump-to-/run/media binding — see
# dotfiles/.config/yazi/keymap.toml.
exec udiskie --no-tray --automount --notify
exec wl-paste --watch cliphist store -max-items 10
exec swayidle -w before-sleep 'swaylock -f'
exec $bin/battery-monitor
