# Sway config
# Sway manages desktop windows and terminal layouts.
# hjkl is ALWAYS movement. Modifier determines scope.

# ===========================================
# VARIABLES
# ===========================================

set $mod Mod4
set $term foot
set $bin /home/august/.local/bin
set $menu $bin/launcher

set $left h
set $down j
set $up k
set $right l

# Include theme colors
include ~/.config/sway/colors


# ===========================================
# MONITORS
# ===========================================
#
# Per-output mode/position/transform/scale is owned entirely by kanshi
# (see ~/.config/kanshi/config). Hard-coding `output <NAME> ...` lines
# here as well caused two persistent bugs:
#
#   1. Connector names (DP-5, DP-6, ...) shift across cable swaps and
#      dock reboots, so a static `output DP-6 ...` line eventually
#      starts targeting the wrong physical panel. Kanshi sidesteps
#      this by matching on `Make Model Serial` from EDID instead.
#
#   2. When both kanshi and sway try to configure the same output,
#      whichever runs last wins, and on `swaymsg reload` the static
#      sway lines fired again and clobbered kanshi's portrait-rotated
#      layout. Removing them puts kanshi in sole control.
#
# The only output line we keep is the wildcard wallpaper assignment
# below, which kanshi does not touch.

# Wallpaper is managed by the generated colors file.

# ===========================================
# APPEARANCE (minimal)
# ===========================================

# Equal 6px gutters at screen edges and between windows.
# Sway adds outer gaps to inner gaps, so outer stays zero.
font pango:CaskaydiaCove Nerd Font 11
gaps inner 6
gaps outer 0
default_border pixel 2
default_floating_border pixel 2

# ===========================================
# INPUT
# ===========================================

input type:keyboard {
    xkb_options ctrl:nocaps
    repeat_delay 300
    repeat_rate 50
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
}

# ===========================================
# BEHAVIOR
# ===========================================

# Choose split orientation automatically from the container dimensions.
default_orientation auto

focus_follows_mouse no
mouse_warping container
popup_during_fullscreen smart
floating_modifier $mod normal

# ===========================================
# NAVIGATION (Super + hjkl or arrows)
# ===========================================

# Focus window (hjkl)
bindsym --to-code $mod+$left focus left
bindsym --to-code $mod+$down focus down
bindsym --to-code $mod+$up focus up
bindsym --to-code $mod+$right focus right

# Focus window (arrows)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move window (hjkl)
bindsym --to-code $mod+Shift+$left move left
bindsym --to-code $mod+Shift+$down move down
bindsym --to-code $mod+Shift+$up move up
bindsym --to-code $mod+Shift+$right move right

# Move window (arrows)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Resize window (hjkl)
bindsym --to-code $mod+Ctrl+$left resize shrink width 50px
bindsym --to-code $mod+Ctrl+$right resize grow width 50px
bindsym --to-code $mod+Ctrl+$up resize shrink height 50px
bindsym --to-code $mod+Ctrl+$down resize grow height 50px

# Resize window (arrows)
bindsym $mod+Ctrl+Left resize shrink width 50px
bindsym $mod+Ctrl+Right resize grow width 50px
bindsym $mod+Ctrl+Up resize shrink height 50px
bindsym $mod+Ctrl+Down resize grow height 50px

# Focus parent container
bindsym --to-code $mod+a focus parent

# Cycle through windows (Alt+Tab)
bindsym Alt+Tab focus next
bindsym Alt+Shift+Tab focus prev

# ===========================================
# WORKSPACES
# ===========================================

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Cycle workspaces
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# ===========================================
# OUTPUTS (Multi-monitor)
# ===========================================

# Focus next output
bindsym --to-code $mod+o focus output right

# Move workspace to next output
bindsym --to-code $mod+Shift+o move workspace to output right

# ===========================================
# LAYOUT
# ===========================================

# Window splits
bindsym $mod+backslash splith
bindsym $mod+minus splitv

# Fullscreen
bindsym --to-code $mod+f fullscreen toggle

# Floating
bindsym --to-code $mod+Shift+space floating toggle

# Toggle split/tabbed
bindsym --to-code $mod+t layout toggle split

# Sticky (stays on all workspaces)
bindsym --to-code $mod+Shift+s sticky toggle

# Scratchpad
bindsym $mod+grave scratchpad show
bindsym $mod+Shift+grave move scratchpad

# ===========================================
# APPS
# ===========================================

# Terminal
bindsym $mod+Return exec $bin/terminal

# Launcher (Space is easy to hit)
bindsym $mod+Space exec $menu

# Browser installed separately at ~/.local/zen/zen.
bindsym --to-code $mod+b exec $bin/zen

# Notes - new vim note (foot+nvim with timestamp filename)
bindsym $mod+n exec $bin/notes-toggle

# Notes - search existing (fuzzel picker over ~/vault)
bindsym --to-code $mod+m exec $bin/notes-picker

# File manager
bindsym --to-code $mod+e exec $term -e yazi

# Password manager: show/unlock KeePassXC; press again to hide it.
bindsym --to-code $mod+p exec $bin/keepass-toggle

# Editor (vim)
bindsym $mod+v exec $term -e ~/.local/bin/nvim

# Power menu (lock, suspend, logout, reboot, shutdown)
bindsym --to-code $mod+x exec $bin/power-menu

# ===========================================
# WINDOW MANAGEMENT
# ===========================================

# Kill focused window
bindsym --to-code $mod+q kill

# Reload config
bindsym --to-code $mod+Shift+c reload

# Exit sway
bindsym --to-code $mod+Shift+e exec swaymsg exit

# ===========================================
# SYSTEM
# ===========================================

# Help (keybindings cheatsheet)
bindsym $mod+Shift+slash exec $term --app-id=keybinds -e $bin/keybinds

# Lock screen
bindsym $mod+Escape exec swaylock

# VNC passthrough mode (pass all keys to remote)
bindsym $mod+Ctrl+p mode "passthrough"
mode "passthrough" {
    bindsym $mod+Ctrl+p mode "default"
}

# Status OSD (time, battery, network, bluetooth)
bindsym --to-code $mod+i exec $bin/status-panel

# System monitor (btop in floating terminal)
bindsym --to-code $mod+Shift+i exec $term --app-id=btop -e btop

# Bluetooth manager
bindsym --to-code $mod+Shift+b exec blueman-manager

# WiFi menu
bindsym --to-code $mod+w exec $bin/wifi-menu

# Virtual machines — managed directly with libvirt.
bindsym --to-code $mod+c exec virt-manager --connect qemu:///system

# USB eject all
bindsym --to-code $mod+u exec udiskie-umount -a && notify-send "USB" "Drives ejected"

# ===========================================
# SCREENSHOTS
# ===========================================

# Selection: save to ~/Pictures AND copy to clipboard (the common
# case — drag a region, get both a permanent file and an
# immediately-pasteable clipboard payload). Implementation lives in
# $bin/screenshot so the save-then-copy chain, slurp-cancel
# handling, and ~/Pictures auto-create only need to be written
# once.
bindsym Print exec $bin/screenshot select

# Fullscreen: same save-and-copy behavior across all connected
# outputs. Using Shift+Print rather than $mod+Print so the modifier
# matches the "expanded scope" idiom Print already uses elsewhere
# (Shift = bigger region) and so the bind works without the user
# having to reach for Mod first.
bindsym Shift+Print exec $bin/screenshot full

# ===========================================
# MEDIA / BRIGHTNESS
# ===========================================

bindsym --locked XF86MonBrightnessUp exec $bin/brightness up
bindsym --locked XF86MonBrightnessDown exec $bin/brightness down

# Backup brightness keys
bindsym $mod+F11 exec $bin/brightness down
bindsym $mod+F12 exec $bin/brightness up

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# ===========================================
# WINDOW RULES
# ===========================================

# Terminals opened from fullscreen
for_window [app_id="^fullscreen-terminal(-[0-9]+-[12])?$"] floating enable, resize set 800 550, move position center

# Portal file picker (uploads, downloads and file dialogs)
for_window [app_id="^yazi-portal$"] floating enable, resize set 900 650, move position center

# KeePassXC: float the main window; Super+P hides it in the scratchpad.
for_window [app_id="^org\.keepassxc\.KeePassXC$"] floating enable, resize set 1000 700, move position center
for_window [class="^KeePassXC$"] floating enable, resize set 1000 700, move position center

# Float utility windows
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
# pass-picker terminal popup
for_window [app_id="pass-prompt"] floating enable, resize set 720 350
for_window [title="File Operation Progress"] floating enable

# btop floating terminal (smaller window)
for_window [app_id="btop"] floating enable, resize set 900 600

# Appearance gallery popup
for_window [app_id="org.linuxconfig.Appearance"] floating enable, move position center, border pixel 0

# Keybindings help popup
for_window [app_id="keybinds"] floating enable, resize set 760 720, border pixel 2


# Notes scratchpad (floating, sticky, small window)
for_window [app_id="notes"] floating enable
for_window [app_id="notes"] sticky enable
for_window [app_id="notes"] resize set 500 400

# Fullscreen alone does not inhibit the idle lock.
# Applications can still request their own idle inhibitors (e.g. video playback).

# ===========================================
# AUTOSTART
# ===========================================

# Import the compositor environment and start session services once.
# An IPC monitor stops the target and kanshi when Sway exits. Ordering
# controls service startup; it does not guarantee monitor discovery is done.
# Start from Sway so Polkit registers against the desktop login session.
# A systemd user service can belong to a different logind session.
exec /usr/libexec/polkit-mate-authentication-agent-1
exec $bin/sway-session

# Publish dark preferences on session start and on config reload.
exec_always $bin/desktop-appearance

# Notifications, USB automounting, idle locking and battery warnings are
# managed by sway-session.target. No clipboard-history watcher is started.
# Browse mounted drives in Yazi with M or gm.

# Optional machine-specific outputs and bindings.
include ~/.config/sway/local.conf

# Appearance popup: theme and transparency selectors.
bindsym --to-code $mod+g exec $bin/appearance-menu
