[Unit]
Description=OpenSnitch desktop interface
PartOf=sway-session.target
After=graphical-session.target

[Service]
Type=exec
RuntimeDirectory=opensnitch
RuntimeDirectoryMode=0700
# --background: prompts still appear; the statistics window opens from the launcher.
ExecStart=%h/.local/bin/opensnitch-ui --background --socket unix://%t/opensnitch/osui.sock
Restart=on-failure
RestartSec=3
