[Unit]
Description=Sway compositor session
Documentation=man:systemd.special(7)
# The IPC monitor exits when Sway disconnects, stopping this target too.
BindsTo=graphical-session.target sway-session-monitor.service
After=graphical-session-pre.target sway-session-monitor.service
Wants=sway-popup-guard.service graphical-session-pre.target kanshi.service mako.service update-notify.timer battery-monitor.service swayidle.service udiskie.service opensnitch-ui.service vpn-off.service
