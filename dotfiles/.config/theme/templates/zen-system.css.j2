/* {{ scheme }} - generated from the desktop palette. Browser chrome only. */
@-moz-document url("chrome://browser/content/browser.xhtml") {
  :root,
  #navigator-toolbox,
  .zen-browser-generic-background {
    color-scheme: dark !important;
    --zen-primary-color: #{{ base0D }} !important;
    --zen-branding-bg: #{{ base00 }} !important;
    --zen-branding-bg-reverse: #{{ base05 }} !important;
    --zen-colors-primary: #{{ base01 }} !important;
    --zen-colors-secondary: #{{ base02 }} !important;
    --zen-colors-tertiary: #{{ base00 }} !important;
    --zen-colors-primary-foreground: #{{ base05 }} !important;
    --zen-colors-border: #{{ base03 }} !important;
    --zen-colors-border-contrast: #{{ base02 }} !important;
    --zen-colors-input-bg: #{{ base01 }} !important;
    --zen-colors-hover-bg: #{{ base02 }} !important;
    --zen-dialog-background: #{{ base01 }} !important;
    --zen-urlbar-background: #{{ base01 }} !important;
    --zen-input-border-color: #{{ base03 }} !important;
    --toolbox-textcolor: #{{ base05 }} !important;
    --lwt-textcolor: #{{ base05 }} !important;
    --toolbar-color: #{{ base05 }} !important;
    --toolbarbutton-icon-fill: #{{ base05 }} !important;
    --toolbar-field-color: #{{ base05 }} !important;
    --toolbar-field-focus-color: #{{ base05 }} !important;
    --toolbar-field-background-color: #{{ base01 }} !important;
    --toolbar-field-focus-background-color: #{{ base01 }} !important;
    --toolbarbutton-background-color-hover: #{{ base02 }} !important;
    --toolbarbutton-background-color-active: #{{ base02 }} !important;
    --tab-selected-textcolor: #{{ base05 }} !important;
    --tab-selected-bgcolor: #{{ base02 }} !important;
    --tab-line-color: #{{ base0D }} !important;
    --urlbarView-highlight-background: #{{ base02 }} !important;
    --urlbarView-highlight-color: #{{ base05 }} !important;
    --urlbarView-separator-color: #{{ base03 }} !important;
    --urlbar-text-color: #{{ base05 }} !important;
    --urlbar-placeholder-color: #{{ base04 }} !important;
    --link-color: #{{ base0D }} !important;
    --link-color-hover: #{{ base0E }} !important;
    --focus-outline-color: #{{ base0D }} !important;
    --button-primary-bgcolor: #{{ base0D }} !important;
    --button-primary-color: #{{ base00 }} !important;
    --panel-background: #{{ base01 }} !important;
    --panel-color: #{{ base05 }} !important;
    --panel-border-color: #{{ base03 }} !important;
    --arrowpanel-background: #{{ base01 }} !important;
    --arrowpanel-color: #{{ base05 }} !important;
    --arrowpanel-border-color: #{{ base03 }} !important;
  }

  :root {
    --zen-main-browser-background: #{{ base00 }} !important;
    --zen-main-browser-background-toolbar: #{{ base00 }} !important;
    --zen-themed-toolbar-bg-transparent: #{{ base00 }} !important;
    --zen-navigator-toolbox-background: #{{ base00 }} !important;
  }

  .zen-browser-generic-background::after {
    background: #{{ base00 }} !important;
  }

  .tab-background[selected] {
    background: #{{ base02 }} !important;
    box-shadow: inset 2px 0 #{{ base0D }} !important;
  }

  #urlbar .urlbarView-url,
  #navigator-toolbox .zen-current-workspace-indicator-name,
  #navigator-toolbox #tabs-newtab-button {
    color: #{{ base04 }} !important;
  }

  #urlbar-input::placeholder {
    color: #{{ base04 }} !important;
  }
}
