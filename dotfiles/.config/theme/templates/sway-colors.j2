# {{ scheme }} - Generated by theme switcher
set $base00 #{{ base00 }}
set $base01 #{{ base01 }}
set $base02 #{{ base02 }}
set $base03 #{{ base03 }}
set $base04 #{{ base04 }}
set $base05 #{{ base05 }}
set $base06 #{{ base06 }}
set $base07 #{{ base07 }}
set $base08 #{{ base08 }}
set $base09 #{{ base09 }}
set $base0A #{{ base0A }}
set $base0B #{{ base0B }}
set $base0C #{{ base0C }}
set $base0D #{{ base0D }}
set $base0E #{{ base0E }}
set $base0F #{{ base0F }}

# class                 border   bg       text     indicator child_border
client.focused          $base0D  $base01  $base05  $base0D   $base0D
client.focused_inactive $base02  $base01  $base04  $base02   $base02
client.unfocused        $base02  $base00  $base04  $base02   $base02
client.urgent           $base08  $base08  $base00  $base08   $base08
client.placeholder      $base00  $base00  $base05  $base00   $base00
client.background       $base00

{% if glass_mode %}
output * bg ~/.local/share/wallpapers/glass-texture.png {{ "tile" if wallpaper_tiled else "fill" }} $base00
{% else %}
output * bg $base00 solid_color
{% endif %}
