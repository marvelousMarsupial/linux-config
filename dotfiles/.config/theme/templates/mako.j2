# {{ scheme }} - Generated by theme switcher

# Base settings
font=CaskaydiaCove Nerd Font 11
width=360
height=120
margin=12
padding=14
border-size=1
border-radius=8
default-timeout=5000
# Force mako's default-timeout to apply even when the originating app
# passes its own `expire_timeout` over the freedesktop notifications
# bus. Without this, `default-timeout` is only a fallback for apps
# that omit the field — apps that send `expire_timeout=0` (battery
# low, update prompts, browser permission popups, plenty of others)
# still pin the notification on screen forever, which reads as "mako
# is broken / notifications never go away" even though the config
# looks right.
ignore-timeout=1
max-visible=3
max-history=100
history=1
anchor=top-right

# Default colors
background-color=#{{ base01 }}{{ "b8" if glass_mode else "ff" }}
text-color=#{{ base05 }}
border-color=#{{ base03 }}
progress-color=#{{ base0D }}

[urgency=low]
background-color=#{{ base01 }}{{ "b8" if glass_mode else "ff" }}
border-color=#{{ base03 }}

[urgency=high]
# Critical notices (battery, failed connections) stay until dismissed.
default-timeout=0
background-color=#{{ base01 }}{{ "b8" if glass_mode else "ff" }}
border-color=#{{ base08 }}

# Alias reminder (small, corner, subtle)
[app-name=alias]
history=0
anchor=bottom-right
width=200
height=60
font=CaskaydiaCove Nerd Font 10
padding=8
border-size=1
border-radius=6
default-timeout=1500
background-color=#{{ base01 }}{{ "b8" if glass_mode else "ff" }}
border-color=#{{ base03 }}
text-color=#{{ base04 }}
