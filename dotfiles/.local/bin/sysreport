#!/usr/bin/python3
"""Read-only daily health snapshot as a private static HTML page.

No dependency on the source checkout, jq, sqlite3 or flock. Every section
runs in isolation, every command is bounded, and nothing is changed except
the report files under ~/.local/share/sysreport.
"""
import argparse
import datetime
import fcntl
import glob
import grp
import html
import json
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

HOME = Path.home()
OUTPUT = HOME / '.local/share/sysreport'
HOUR = 3600
TIMEOUT = 30
STYLE = ("<style>:root{color-scheme:light dark;--green:#176638;--red:#a32020;--amber:#895100}"
         "body{font:16px system-ui,sans-serif;max-width:1100px;margin:2rem auto;padding:0 1rem}"
         "pre{font:14px ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere;padding:1rem;"
         "border:1px solid #8886;border-radius:6px}"
         ".tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin:1.5rem 0}"
         ".tile{border:1px solid #8886;border-top:5px solid;border-radius:8px;padding:1rem}"
         ".tile h3{margin:0 0 .6rem;font-size:.95rem}.tile strong{font-size:1.3rem}.tile p{margin:.6rem 0 0;font-size:.9rem}"
         ".ok{border-top-color:var(--green)}.ok strong{color:var(--green)}.bad{border-top-color:var(--red)}"
         ".bad strong{color:var(--red)}.warn{border-top-color:var(--amber)}.warn strong,.problem{color:var(--amber)}"
         "details{border-bottom:1px solid #8886;padding:1rem 0}summary{cursor:pointer;font-weight:600}h2{margin-top:2rem}"
         "@media(prefers-color-scheme:dark){:root{--green:#7fdb9b;--red:#ff9494;--amber:#ffbc70}}</style>")


def escape(text):
    return html.escape(str(text), quote=True).replace('&#x27;', '&#39;')


def iso(seconds):
    return datetime.datetime.fromtimestamp(seconds).astimezone().isoformat(timespec='seconds')


def parse_time(text):
    """Accept ISO timestamps with any fraction length, as Restic writes them."""
    text = re.sub(r'(\.\d{6})\d+', r'\1', text.strip())
    return datetime.datetime.fromisoformat(text.replace('Z', '+00:00')).timestamp()


class Section:
    """Collects one section's text and its problems; failures never spread."""

    def __init__(self, name, title):
        self.name, self.title = name, title
        self.lines = []
        self.problems = []
        self.flags = {}

    def write(self, *text):
        self.lines.extend(text)

    def problem(self, text):
        self.problems.append(text)

    def command(self, *args, timeout=TIMEOUT):
        """Run one bounded command and return (returncode, output, stderr)."""
        try:
            done = subprocess.run(list(args), capture_output=True, text=True, timeout=timeout, errors='replace')
            return done.returncode, done.stdout, done.stderr
        except FileNotFoundError:
            return 127, '', f'{args[0]}: not found\n'
        except subprocess.TimeoutExpired:
            return 124, '', f'{args[0]}: timed out\n'

    def run(self, *args):
        """Show a command's output; a failure is recorded, never fatal."""
        code, out, err = self.command(*args)
        self.write((out + err).rstrip('\n'))
        if code:
            self.write(f'\nERROR: command failed (exit {code}): {args[0]}')
            self.problem(f'{self.title}: {args[0]} unavailable or failed (exit {code})')
        return code, out

    @property
    def text(self):
        return '\n'.join(self.lines) + '\n'


def installation(s):
    receipt = HOME / '.local/state/linux-config/install-info'
    if receipt.is_file():
        s.write(receipt.read_text().rstrip('\n'))
    else:
        s.write('Installed version/date: unknown (no installation receipt)')
        s.problem('Installation version/date unknown; no installation receipt')


def backup(s):
    if not (HOME / '.config/restic-home/env').is_file() or not shutil.which('restic'):
        s.write('Backup not configured: Restic or its configuration is missing.')
        s.problem('Backup not configured; last success unknown')
        return
    s.run('systemctl', '--user', 'show', 'restic-home.service', '-p', 'ExecMainStartTimestamp',
          '-p', 'ExecMainExitTimestamp', '-p', 'Result', '-p', 'ExecMainStatus')
    code, out, _ = s.command('journalctl', '--user', '-u', 'restic-home.service', '--no-pager', '-o', 'json')
    if code:
        s.write('ERROR: backup success journal unavailable')
        s.problem('Backup: success journal unavailable')
    else:
        stamps = []
        for line in out.splitlines():
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get('MESSAGE_ID') == '39f53479d3a045ac8e11786248231fbf':
                stamps.append(int(event['__REALTIME_TIMESTAMP']) // 1000000)
        if stamps:
            last = max(stamps)
            s.write(f'Last journal-confirmed successful completion: {iso(last)}',
                    f'Hours since confirmed success: {int(time.time() - last) // HOUR}')
            if time.time() - last > 26 * HOUR:
                s.problem('Backup confirmed success older than 26 hours')
        else:
            s.write('Last successful exit-0 completion: unknown in retained journal')
            s.problem('Backup: last successful completion unknown')
    # Snapshot metadata is inexpensive; never run a backup, check or full repository scan.
    code, out, err = s.command('restic-home', 'snapshots', '--no-lock', '--json', '--tag', 'linux-config-home')
    if code:
        s.write(err.rstrip('\n'))
        s.problem('Backup: cannot read snapshot metadata')
        return
    try:
        times = [parse_time(item['time']) for item in json.loads(out) if item.get('time')]
    except (ValueError, TypeError, KeyError):
        times = []
    if not times:
        s.write('No successful snapshot found')
        s.problem('Backup: no successful snapshot found')
        return
    age = time.time() - max(times)
    s.write(f'Latest snapshot: {iso(max(times))}', f'Age: {int(age) // HOUR} hours',
            'Snapshot existence does not prove a complete exit-0 backup; consult service result above.',
            'Repository size: skipped to avoid repository scans or remote traffic.')
    if age > 26 * HOUR:
        s.problem('Backup snapshot older than 26 hours')


SKIP_UNITS = re.compile(r'^(getty@|console-getty|systemd-|grub-|accounts-daemon|remote-fs)')
SYSTEM_UNITS = ['apt-daily.service', 'apt-daily-upgrade.service', 'fstrim.service',
                'dpkg-db-backup.service', 'e2scrub_all.service', 'logrotate.service']


def units_scope(s, scope):
    flags = ['--user'] if scope == 'user' else []
    s.write(f'Scope: {scope}')
    s.run('systemctl', *flags, 'list-timers', '--all', '--no-pager')
    code, out, err = s.command('systemctl', *flags, '--failed', '--no-legend', '--plain', '--no-pager')
    if code:
        s.write(err.rstrip('\n'))
        s.problem(f'Systemd: {scope} failed units unknown')
        return
    failed = [line.split()[0] for line in out.splitlines() if line.split()]
    s.write('Failed units:', out.rstrip('\n'))
    if failed:
        s.problem(f'Failed {scope} units: {" ".join(failed)}')
    names = set(failed)
    for args in (('list-unit-files', '--state=enabled', '--type=service', '--type=timer', '--no-legend', '--no-pager'),
                 ('list-units', '--all', '--type=timer', '--no-legend', '--plain', '--no-pager')):
        _, out, _ = s.command('systemctl', *flags, *args)
        names.update(line.split()[0] for line in out.splitlines() if line.split())
    if scope == 'user':
        names.update(p.name for p in (HOME / '.config/systemd/user').glob('*') if p.suffix in ('.service', '.timer'))
    else:
        names.update(SYSTEM_UNITS)
    for unit in sorted(names):
        if not unit.endswith(('.service', '.timer')) or SKIP_UNITS.match(unit):
            continue
        s.write(f'--- {unit}')
        s.run('systemctl', *flags, 'show', unit, '-p', 'ActiveState', '-p', 'SubState', '-p', 'Result',
              '-p', 'ExecMainStatus', '-p', 'ExecMainCode', '-p', 'ExecMainStartTimestamp', '-p', 'ExecMainExitTimestamp',
              '-p', 'LastTriggerUSec', '-p', 'NextElapseUSecRealtime', '-p', 'Triggers')
        _, out, _ = s.command('systemctl', *flags, 'show', unit, '-p', 'Result', '--value')
        if out.strip() not in ('', 'success'):
            s.problem(f'{scope} {unit} result: {out.strip()}')


def units(s):
    units_scope(s, 'system')
    units_scope(s, 'user')


def updates(s):
    _, out, _ = s.command('systemctl', 'show', 'apt-daily-upgrade.service', '-p', 'Result',
                          '-p', 'ExecMainStatus', '-p', 'ExecMainExitTimestamp', timeout=10)
    values = dict(line.split('=', 1) for line in out.splitlines() if '=' in line)
    result, completed = values.get('Result', ''), values.get('ExecMainExitTimestamp', '')
    code, stamp, _ = s.command('date', '-d', completed, '+%s') if completed else (1, '', '')
    epoch = int(stamp) if not code and stamp.strip().isdigit() else 0
    if result == 'success' and values.get('ExecMainStatus') == '0' and epoch and time.time() - epoch <= 48 * HOUR:
        s.write(f'Update check completed successfully: {completed}')
        s.flags['confirmed'] = True
    elif result and result != 'success':
        s.problem(f'Update service failed: {result}')
    else:
        s.problem('Recent successful automatic update check not confirmed')
    s.write('Last recorded APT transaction (not a record of every apt invocation):')
    history = Path('/var/log/apt/history.log')
    try:
        blocks = [b for b in history.read_text(errors='replace').split('\n\n') if 'Start-Date:' in b]
        s.write(blocks[-1].strip() if blocks else 'No transactions in current log')
        upgrades = [b for b in blocks if 'Upgrade:' in b]
        s.write('Latest recorded upgrade in current history log:',
                upgrades[-1].strip() if upgrades else 'No upgrades in current log')
    except OSError:
        s.problem('APT history unreadable')
        s.write('ERROR: APT history unreadable')
    s.write('Pending updates (cached metadata; no apt update is run):')
    code, out, err = s.command('apt-get', '-s', '-o', 'Debug::NoLocking=1', 'upgrade')
    s.write((out + err).rstrip('\n'))
    if code:
        s.problem('Pending update count unknown')
    else:
        count = sum(1 for line in out.splitlines() if line.startswith('Inst '))
        s.write(f'Pending upgrade count: {count}')
        if count:
            s.problem(f'{count} package upgrades pending (cached metadata)')
    s.write('Package metadata timestamps:')
    stamps = []
    for path in sorted(glob.glob('/var/lib/apt/lists/*InRelease')):
        mtime = os.stat(path).st_mtime
        stamps.append(mtime)
        s.write(f'{datetime.datetime.fromtimestamp(mtime):%Y-%m-%d %H:%M} {os.path.basename(path)}')
    if not stamps:
        s.problem('APT metadata age unknown')
    elif time.time() - max(stamps) > 48 * HOUR:
        s.problem('APT metadata older than 48 hours')
    marker = Path('/run/reboot-required')
    if marker.exists():
        s.write('Reboot required')
        s.problem('Reboot required')
        for path in (marker, Path('/run/reboot-required.pkgs')):
            try:
                s.write(path.read_text().rstrip('\n'))
            except OSError:
                pass
    else:
        s.write('No reboot-required marker (absence does not guarantee no reboot is needed).')


def performance(s):
    s.run('uptime')
    failed = bool(s.run('free', '-h')[0])
    try:
        memory = dict(line.split(':', 1) for line in Path('/proc/meminfo').read_text().splitlines())
        total = int(memory['MemTotal'].split()[0])
        available = int(memory['MemAvailable'].split()[0])
        if total and available / total < 0.1:
            s.problem('Available RAM below 10%')
    except (OSError, KeyError, ValueError):
        pass
    failed |= bool(s.run('df', '-hPT')[0])
    # Only memory and disk usage decide the Resources tile; SMART has its own.
    s.flags['resources_unknown'] = failed
    _, out, _ = s.command('df', '-PT')
    for line in out.splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 7 and fields[5].rstrip('%').isdigit() and int(fields[5].rstrip('%')) >= 90:
            s.problem(f'Disk usage >=90%: {fields[6]}')
    for title, key in (('Top CPU processes (%CPU averaged over process lifetime):', '-pcpu'),
                       ('Top memory processes:', '-pmem')):
        s.write(title)
        _, out, _ = s.command('ps', '-eo', 'pid,comm,pcpu,pmem', f'--sort={key}')
        s.write('\n'.join(out.splitlines()[:6]))
    s.write('CPU/thermal sensors (millidegrees Celsius):')
    sensors = sorted(glob.glob('/sys/class/thermal/thermal_zone*/temp'))
    for path in sensors:
        try:
            s.write(f'{path}: {Path(path).read_text().strip()}')
        except OSError:
            pass
    if not sensors:
        s.write('Temperature unavailable')
    s.write('Battery health:')
    found = False
    for path in sorted(glob.glob('/sys/class/power_supply/*/uevent')):
        try:
            values = dict(line.split('=', 1) for line in Path(path).read_text().splitlines() if '=' in line)
        except OSError:
            continue
        if values.get('POWER_SUPPLY_TYPE') != 'Battery':
            continue
        found = True
        for key in ('STATUS', 'CAPACITY', 'CYCLE_COUNT', 'ENERGY_FULL', 'ENERGY_FULL_DESIGN', 'CHARGE_FULL', 'CHARGE_FULL_DESIGN'):
            if f'POWER_SUPPLY_{key}' in values:
                s.write(f'POWER_SUPPLY_{key}={values[f"POWER_SUPPLY_{key}"]}')
        full = values.get('POWER_SUPPLY_ENERGY_FULL') or values.get('POWER_SUPPLY_CHARGE_FULL')
        design = values.get('POWER_SUPPLY_ENERGY_FULL_DESIGN') or values.get('POWER_SUPPLY_CHARGE_FULL_DESIGN')
        if full and design and design.isdigit() and int(design):
            s.write(f'Health: {100 * int(full) / int(design):.1f}% of design capacity')
    if not found:
        s.write('Battery unavailable')
    s.write('Disk devices:')
    s.run('lsblk', '-o', 'NAME,TYPE,SIZE,FSTYPE,MOUNTPOINTS,MODEL')
    s.write('Disk health: read-only SMART health query; no self-tests are started.')
    if shutil.which('smartctl'):
        _, out, _ = s.command('lsblk', '-dn', '-o', 'NAME,TYPE')
        for line in out.splitlines():
            fields = line.split()
            if len(fields) == 2 and fields[1] == 'disk':
                s.run('smartctl', '-n', 'standby', '-H', f'/dev/{fields[0]}')
    else:
        s.write('SMART/NVMe health unavailable: smartctl not installed. Capacity is shown above.')
        s.problem('Disk hardware health unknown: smartctl unavailable')


def journal(s):
    try:
        groups = {grp.getgrgid(gid).gr_name for gid in os.getgroups()}
    except KeyError:
        groups = set()
    if 'systemd-journal' not in groups:
        s.flags['limited'] = True
        s.write('System journal coverage is not guaranteed: user is not in systemd-journal.')
        s.problem('Journal: user lacks systemd-journal membership; coverage may be incomplete')
    code, out, err = s.command('journalctl', '--since', '24 hours ago', '-p', 'warning', '-o', 'json', '--no-pager')
    s.write(err.rstrip('\n'))
    if code or 'not seeing' in err:
        s.flags['limited'] = True
        s.problem('Journal: full system warning/error coverage unavailable')
    counts = {}
    for line in out.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        unit = event.get('_SYSTEMD_USER_UNIT') or event.get('_SYSTEMD_UNIT') or event.get('SYSLOG_IDENTIFIER') or 'unknown'
        message = event.get('MESSAGE', '')
        if not isinstance(message, str):
            message = str(message)
        counts[(unit, message)] = counts.get((unit, message), 0) + 1
    s.flags['count'] = sum(counts.values())
    for (unit, message), count in sorted(counts.items(), key=lambda item: -item[1]):
        s.write(f'{count:7d} {unit}\t{message}')
    if counts:
        s.problem('Journal contains warnings/errors in the last 24 hours; review counts')


def network_snitch(s):
    database = ''
    section = ''
    try:
        for line in (HOME / '.config/opensnitch/settings.conf').read_text().splitlines():
            if line.startswith('['):
                section = line.strip()
            elif section == '[database]' and line.startswith('file='):
                database = line[5:].strip()
    except OSError:
        pass
    if not database or ':memory:' in database:
        s.write('No persistent OpenSnitch database configured; statistics skipped.')
        return
    s.write(f'Database: {database}')
    path = Path(database)
    if not path.is_file():
        s.write('Database file missing. Restart the OpenSnitch UI after saving its database settings.')
        s.problem('OpenSnitch: database file missing')
        return
    if not os.access(path, os.R_OK):
        s.write('Database file unreadable.')
        s.problem('OpenSnitch: database file unreadable')
        return
    # Read-only URI plus query_only; short transactions and zero busy timeout.
    try:
        connection = sqlite3.connect(f'file:{path}?mode=ro', uri=True, timeout=0)
        connection.execute('PRAGMA query_only=ON')
    except sqlite3.Error as error:
        s.write(f'ERROR: cannot open database: {error}')
        s.problem('OpenSnitch: could not read connections')
        return
    with connection:
        try:
            connections = connection.execute('SELECT count(*) FROM connections').fetchone()[0]
        except sqlite3.Error:
            connections = 'unknown'
        s.write(f'Saved connections: {connections}')
        if connections == 0:
            s.problem('OpenSnitch: no connections recorded yet')
        elif connections == 'unknown':
            s.problem('OpenSnitch: could not read connections')
        queries = (
            ('Rules created in the last 24 hours:',
             "SELECT created,name,action,operator_operand,operator_data FROM rules "
             "WHERE datetime(created)>=datetime('now','-1 day','localtime')"),
            ('Denied connections in the last 24 hours:',
             "SELECT process,dst_host,dst_ip,dst_port,count(*) AS connections FROM connections "
             "WHERE action='deny' AND datetime(time)>=datetime('now','-1 day','localtime') "
             "GROUP BY process,dst_host,dst_ip,dst_port ORDER BY connections DESC"),
            ('Top processes by connections in the last 24 hours:',
             "SELECT process,count(*) AS connections FROM connections "
             "WHERE datetime(time)>=datetime('now','-1 day','localtime') GROUP BY process ORDER BY connections DESC LIMIT 10"))
        for title, query in queries:
            s.write(title)
            try:
                cursor = connection.execute(query)
                rows = [[d[0] for d in cursor.description], *cursor.fetchall()]
                widths = [max(len(str(row[i])) for row in rows) for i in range(len(rows[0]))]
                for row in rows:
                    s.write('  '.join(str(cell).ljust(widths[i]) for i, cell in enumerate(row)).rstrip())
            except sqlite3.Error as error:
                s.write(f'ERROR: query failed: {error}')
                s.problem(f'{s.title}: query failed')
    connection.close()


def network_basics(s):
    s.run('ss', '-lntup')
    s.run('ip', '-brief', 'address', 'show', 'up')


SECTIONS = (('installation', 'Installation', installation), ('backup', 'Backup', backup),
            ('units', 'Systemd units', units), ('updates', 'Updates', updates),
            ('performance', 'Performance and disk health', performance), ('journal', 'Journal', journal),
            ('network_snitch', 'Network', network_snitch), ('network_basics', 'Network basics', network_basics))

DEMO_TILES = (('Backups', 'ok', 'Backup ran', 'Last success: 2 hours ago'),
              ('Updates', 'ok', 'Checked today', 'No updates waiting'),
              ('Services', 'ok', 'Running', 'No failed services'),
              ('Resources', 'ok', 'OK', 'Disk and memory usage normal'),
              ('Disk health', 'ok', 'OK', 'SMART passed'),
              ('Journal', 'ok', 'Quiet', 'No warnings in 24 hours'),
              ('Network', 'ok', 'Connected', 'Interfaces and ports checked'),
              ('OpenSnitch', 'ok', 'Saved', 'Connection history available'))


def overview(sections, problems):
    """Eight evidence-based tiles; detailed command output stays folded."""
    s = sections
    tiles = []
    state, label, detail = 'ok', 'Backup ran', 'Last success within 26 hours.'
    if s['backup'].problems:
        state, label, detail = 'warn', 'Check backup', s['backup'].problems[0]
    if re.search(r'^Result=(exit-code|signal|timeout|core-dump|oom-kill)', s['backup'].text, re.M):
        state, label, detail = 'bad', 'Failed', 'Last backup failed.'
    tiles.append(('Backups', state, label, detail))

    state, label, detail = 'warn', 'Unknown', 'No recent update check found.'
    if s['updates'].flags.get('confirmed'):
        state, label, detail = 'ok', 'Checked', 'Last successful check within 48 hours.'
    if s['updates'].problems:
        state, label, detail = 'warn', 'Check updates', s['updates'].problems[0]
    if any(p.startswith('Update service failed:') for p in problems):
        state, label = 'bad', 'Updates failed'
    tiles.append(('Updates', state, label, detail))

    state, label, detail = 'ok', 'OK', 'No failed services.'
    if s['units'].problems:
        state, label, detail = 'warn', 'Unknown', 'Could not read service status.'
        if any(re.search(r'^Failed .* units:|result:', p) for p in s['units'].problems):
            state, label, detail = 'bad', 'Failed', 'See failed services below.'
    tiles.append(('Services', state, label, detail))

    state, label, detail = 'ok', 'OK', 'Disk and memory usage normal.'
    resource = [p for p in problems if re.search(r'Disk usage|Available RAM', p)]
    if resource:
        state, label, detail = 'bad', 'Low space or memory', resource[0]
    elif s['performance'].flags.get('resources_unknown'):
        state, label, detail = 'warn', 'Unknown', 'Could not read resource usage.'
    tiles.append(('Resources', state, label, detail))

    state, label, detail = 'warn', 'Unknown', 'SMART unreadable or disk asleep.'
    smart = s['performance'].text
    if re.search(r'overall-health.*PASSED|Health Status: OK', smart, re.I) and not re.search(r'^ERROR:', smart, re.M):
        state, label, detail = 'ok', 'OK', 'SMART passed.'
    if re.search(r'overall-health.*FAILED|Health Status:.*(CRITICAL|FAILED)', smart, re.I):
        state, label, detail = 'bad', 'Failed', 'SMART reported a disk problem.'
    tiles.append(('Disk health', state, label, detail))

    state, label, detail = 'ok', 'Quiet', 'No warnings in 24 hours.'
    if s['journal'].problems:
        state, label, detail = 'warn', 'Check journal', 'Could not read logs.'
        if 'count' in s['journal'].flags:
            label, detail = f'{s["journal"].flags["count"]} warnings', 'In the last 24 hours.'
        if s['journal'].flags.get('limited'):
            detail = 'Last 24 hours; some system logs unreadable.'
    tiles.append(('Journal', state, label, detail))

    state, label, detail = 'ok', 'Checked', 'Interfaces and ports listed below.'
    if s['network_basics'].problems:
        state, label, detail = 'warn', 'Unknown', 'Could not read network status.'
    tiles.append(('Network', state, label, detail))

    state, label, detail = 'ok', 'Saved', 'Connection history available.'
    if 'No persistent' in s['network_snitch'].text:
        state, label, detail = 'warn', 'History off', 'No saved connection history.'
    elif s['network_snitch'].problems:
        state, label, detail = 'warn', 'Unknown', 'Could not read connection history.'
        if 'Saved connections: 0' in s['network_snitch'].text:
            label, detail = 'No connections', 'Database is empty. Check the UI connection.'
    tiles.append(('OpenSnitch', state, label, detail))
    return tiles


def tile(title, state, label, detail):
    return (f'<article class="tile {state}"><h3>{escape(title)}</h3><strong>{escape(label)}</strong>'
            f'<p>{escape(detail)}</p></article>\n')


def render(demo):
    sections = {}
    problems = []
    for name, title, function in SECTIONS:
        section = Section(name, title)
        if demo:
            section.write('Sample data')
        else:
            try:
                function(section)
            except Exception as error:  # One section's failure must not lose the report.
                section.write(f'\nERROR: section failed: {error!r}')
                section.problem(f'{name} failed')
        problems.extend(section.problems)
        sections[name] = section
    _, host, _ = Section('host', 'Host').command('hostname')
    page = ['<!doctype html><html lang="en"><meta charset="utf-8">'
            '<meta name="viewport" content="width=device-width,initial-scale=1">'
            '<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; style-src \'unsafe-inline\'">'
            '<title>System health</title>\n', STYLE, '\n<h1>System health</h1><pre>',
            escape(f'Host: {host.strip()}\nGenerated: {iso(time.time())}\n')]
    if demo:
        page.append('Demo: sample data\n')
    page.append(escape(sections['installation'].text))
    page.append('</pre><div class="tiles">\n')
    page.extend(tile(*entry) for entry in (DEMO_TILES if demo else overview(sections, problems)))
    page.append('</div>\n')
    if problems:
        page.append('<details><summary>Issues</summary><pre class="problem">'
                    + escape('\n'.join(sorted(set(problems)))) + '</pre></details>\n')
    else:
        page.append('<p>all OK</p>\n')
    page.append('<h2>Details</h2>\n')
    for name, title, _ in SECTIONS[1:]:
        page.append(f'<details><summary>{escape(title)}</summary><pre>{escape(sections[name].text)}</pre></details>\n')
    page.append('</html>\n')
    return ''.join(page)


def save(content, name):
    """Write privately and move into place atomically."""
    with tempfile.NamedTemporaryFile('w', dir=OUTPUT, prefix='.work.', delete=False) as staged:
        staged.write(content)
    os.chmod(staged.name, 0o600)
    os.replace(staged.name, OUTPUT / name)


def main():
    parser = argparse.ArgumentParser(description='Write a private local system health report.')
    parser.add_argument('--demo', action='store_true', help='Write demo.html with sample tiles instead of collecting data')
    args = parser.parse_args()
    os.umask(0o077)
    os.environ['LC_ALL'] = 'C'
    os.environ['PATH'] = f'{HOME}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin'
    if OUTPUT.is_symlink():
        sys.exit('Refusing symlinked output directory')
    OUTPUT.mkdir(parents=True, exist_ok=True)
    OUTPUT.chmod(0o700)
    with (OUTPUT / '.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        content = render(args.demo)
        if args.demo:
            save(content, 'demo.html')
            print(OUTPUT / 'demo.html')
            return
        name = f'report-{datetime.datetime.now(datetime.timezone.utc):%Y%m%dT%H%M%S.%f}Z.html'
        save(content, name)
        save(content, 'latest.html')
        for old in sorted(OUTPUT.glob('report-*.html'), reverse=True)[14:]:
            old.unlink()
        print(OUTPUT / 'latest.html')


if __name__ == '__main__':
    main()
