#!/usr/bin/env python3
"""motd - message of the day with system info"""

import argparse
import socket
import subprocess
from pathlib import Path

# ANSI colors
CYAN = "\033[0;36m"
DIM = "\033[0;90m"
GREEN = "\033[0;32m"
RESET = "\033[0m"

def run_output(cmd: list[str]) -> str:
    """Run a command and return stdout."""
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return result.stdout.strip() if result.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""

def get_hostname() -> str:
    """Get hostname."""
    return socket.gethostname()

def get_local_ip() -> str:
    """Get local IP address."""
    output = run_output(["hostname", "-I"])
    return output.split()[0] if output else ""

def get_uptime() -> str:
    """Get uptime."""
    output = run_output(["uptime", "-p"])
    return output.replace("up ", "") if output else ""

def get_load() -> str:
    """Get load average."""
    try:
        loadavg = Path("/proc/loadavg").read_text()
        return loadavg.split()[0]
    except IOError:
        return ""

def get_memory() -> str:
    """Get memory usage."""
    output = run_output(["free", "-h"])
    for line in output.splitlines():
        if line.startswith("Mem:"):
            parts = line.split()
            return f"{parts[2]}/{parts[1]}"
    return ""

def get_disk() -> str:
    """Get disk usage."""
    output = run_output(["df", "-h", "/"])
    lines = output.splitlines()
    if len(lines) >= 2:
        parts = lines[1].split()
        return f"{parts[2]}/{parts[1]}"
    return ""

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="motd",
        description="Display message of the day with system information",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Displays:
  - Hostname
  - Local IP
  - Uptime
  - Load average, memory, and disk usage

Typically added to shell profile for login display.
"""
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable colored output"
    )
    args = parser.parse_args()

    # Disable colors if requested
    if args.no_color:
        global CYAN, DIM, GREEN, RESET
        CYAN = DIM = GREEN = RESET = ""

    host = get_hostname()
    local_ip = get_local_ip()
    uptime = get_uptime()
    load = get_load()
    mem = get_memory()
    disk = get_disk()

    print()
    print(f"{CYAN}{host}{RESET}")
    print(f"{DIM}─────────────────────────{RESET}")
    print(f"  {DIM}ip{RESET}    {local_ip}")
    print(f"  {DIM}up{RESET}    {uptime}")
    print(f"  {DIM}load{RESET}  {load}  {DIM}mem{RESET} {mem}  {DIM}disk{RESET} {disk}")
    print()

if __name__ == "__main__":
    main()
