#!/usr/bin/python3
"""Render a subtle, static woven wallpaper using the current desktop palette."""
import math
import argparse
import json
import os
from pathlib import Path
import re
import struct
import subprocess
import zlib

parser = argparse.ArgumentParser(description=__doc__)
styles = ('woven', 'linen', 'frost', 'paper', 'brushed', 'grid', 'dots')
parser.add_argument('style', nargs='?', choices=(*styles, 'next', 'list'))
parser.add_argument('--output', type=Path, help='Render a preview without changing the desktop')
args = parser.parse_args()
if args.style == 'list':
    print('\n'.join(styles))
    raise SystemExit(0)
home = Path.home()
selection = home / '.config/theme/wallpaper-style'
style = selection.read_text().strip() if selection.exists() else 'woven'
if style not in styles:
    style = 'woven'
if args.style == 'next':
    style = styles[(styles.index(style) + 1) % len(styles)]
elif args.style:
    style = args.style
colors = (home / '.config/sway/colors').read_text()
match = re.search(r'(?m)^set \$base00 #([0-9a-fA-F]{6})$', colors)
if not match:
    raise SystemExit('Cannot find base00 in ~/.config/sway/colors')
base = tuple(int(match[1][i:i+2], 16) for i in (0, 2, 4))
mode = home / '.config/theme/glass-mode'
if not args.output and (not mode.exists() or mode.read_text().strip() != 'on'):
    import sys
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    sockets = list(runtime.glob('sway-ipc.*.sock'))
    if sockets:
        subprocess.run(['swaymsg', '-s', str(sockets[0]), f'output * bg #{match[1]} solid_color'], check=True, capture_output=True)
    print('Solid wallpaper')
    sys.exit(0)
# Match the active display so fine threads stay sharp rather than being
# softened by scaling a fixed-size image.
width, height = 1600, 1000
runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
sockets = list(runtime.glob('sway-ipc.*.sock'))
if sockets:
    result = subprocess.run(['swaymsg', '-s', str(sockets[0]), '-t', 'get_outputs', '-r'],
                            capture_output=True, text=True, timeout=3)
    if result.returncode == 0:
        outputs = [o for o in json.loads(result.stdout) if o.get('active') and o.get('current_mode')]
        if outputs:
            mode = max(outputs, key=lambda o: o['current_mode']['width'] * o['current_mode']['height'])['current_mode']
            width, height = mode['width'], mode['height']
# Grid tiles repeat exactly: five 24px cells, with no scaling or seams.
background_mode = 'tile' if style in ('grid', 'dots') else 'fill'
if background_mode == 'tile':
    width = height = 120
rows = bytearray()
for y in range(height):
    rows.append(0)  # PNG scanline filter: none.
    for x in range(width):
        # Stable spatial grain: static pixels, never animated noise.
        value = ((x * 374761393 + y * 668265263) ^ 0x5A17) & 0xffffffff
        value = ((value ^ (value >> 13)) * 1274126177) & 0xffffffff
        grain = ((value ^ (value >> 16)) & 255) / 255 - 0.5
        drift = 5 * math.sin(x / 170 + y / 260) + 3 * math.cos(y / 130)
        if style == 'grid':
            # One-pixel drafting lines, with a major line every five cells.
            # Flat backing preserves the clean cutting-mat geometry.
            drift = 0
            minor = x % 24 == 0 or y % 24 == 0
            major = x % 120 == 0 or y % 120 == 0
            texture = 17 if major else 8 if minor else 0
        elif style == 'dots':
            drift = 0
            # Small, sharply defined points; stronger five-cell anchors.
            dot = x % 24 in (0, 1) and y % 24 in (0, 1)
            anchor = x % 120 in (0, 1) and y % 120 in (0, 1)
            texture = 32 if anchor else 18 if dot else 0
        elif style == 'woven':
            texture = (5 if x % 12 == 0 else 0) + (4 if y % 12 == 0 else 0)
            texture += 3 if (x + y) % 96 == 0 else 0
        elif style == 'linen':
            texture = (3 if x % 4 == 0 else -1) + (2 if y % 6 == 0 else 0)
            texture += grain * 3
        elif style == 'frost':
            texture = grain * 12
            drift *= 0.7
        elif style == 'paper':
            texture = grain * 6 + 1.5 * math.sin(x / 13 + math.sin(y / 19))
            drift *= 0.4
        else:  # Fine horizontal fibers, like brushed metal.
            texture = 2.5 * math.sin(y * 2.4) + grain * 3
            drift = 4 * math.sin(x / 280) + 2 * math.cos(y / 220)
        shade = round(drift + texture)
        rows.extend(max(0, min(255, channel + shade)) for channel in base)

def chunk(kind, data):
    return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))

png = b'\x89PNG\r\n\x1a\n'
png += chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
png += chunk(b'IDAT', zlib.compress(rows, 6)) + chunk(b'IEND', b'')
path = args.output or home / '.local/share/wallpapers/glass-texture.png'
path.parent.mkdir(parents=True, exist_ok=True)
temporary = path.with_suffix('.tmp')
temporary.write_bytes(png)
temporary.replace(path)
if args.output:
    print(f'{style}: {path}')
    raise SystemExit(0)
selection.parent.mkdir(parents=True, exist_ok=True)
selection.write_text(style + '\n')
env = dict(os.environ)
if not env.get('SWAYSOCK'):
    runtime = Path(env.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    sockets = list(runtime.glob('sway-ipc.*.sock'))
    if len(sockets) == 1:
        env['SWAYSOCK'] = str(sockets[0])
if env.get('SWAYSOCK'):
    result = subprocess.run(['swaymsg', f'output * bg "{path}" {background_mode}'], env=env,
                            capture_output=True, text=True)
    if result.returncode or '"success": false' in result.stdout:
        raise SystemExit(f'Wallpaper activation failed: {result.stdout} {result.stderr}')
print(f'Wallpaper style: {style} ({path})')
