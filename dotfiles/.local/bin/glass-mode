#!/usr/bin/python3
"""Switch desktop glass; terminals and launchers pick it up when reopened."""
import argparse
import fcntl
import os
from pathlib import Path
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='toggle', choices=('on', 'off', 'toggle', 'status'))
    args = parser.parse_args()
    home = Path.home()
    state = home / '.config/theme/glass-mode'
    state.parent.mkdir(parents=True, exist_ok=True)
    with (state.parent / '.glass-mode.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        enabled = state.exists() and state.read_text().strip() == 'on'
        if args.action == 'status':
            print('Glass mode: ' + ('on' if enabled else 'off'))
            return
        enabled = not enabled if args.action == 'toggle' else args.action == 'on'
        try:
            current = (home / '.cache/theme/current').read_text().strip()
        except FileNotFoundError:
            raise SystemExit('No palette selected yet: run theme apply <scheme> first')
        state.write_text(('on' if enabled else 'off') + '\n')
        env = dict(os.environ)
        env.setdefault('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
        env.setdefault('DBUS_SESSION_BUS_ADDRESS', f"unix:path={env['XDG_RUNTIME_DIR']}/bus")
        subprocess.run([str(home / '.local/bin/theme'), 'apply', current], env=env, check=True)
        message = 'Glass mode ' + ('on' if enabled else 'off') + '. Reopen terminals to apply.'
        print(message)
        try:
            subprocess.run(['notify-send', '-a', 'Glass mode', 'Glass mode', message], env=env, check=False)
        except OSError:
            pass  # The printed message is enough without a notification daemon.


if __name__ == '__main__':
    main()
