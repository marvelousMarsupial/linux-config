#!/usr/bin/env python3
'monitor-info - dump connected displays as a kanshi profile block.'

import json
import subprocess
import sys


def get_outputs() -> list[dict]:
    """Return the list of currently-connected outputs from sway."""
    try:
        result = subprocess.run(
            ["swaymsg", "-t", "get_outputs"],
            capture_output=True,
            text=True,
            check=True, timeout=5,
        )
    except (subprocess.CalledProcessError, OSError, subprocess.TimeoutExpired) as e:
        # We can't print a kanshi block without sway IPC, so abort with
        # a helpful diagnostic rather than dumping a half-formed block.
        sys.stderr.write(f"monitor-info: failed to query sway: {e}\n")
        sys.exit(1)
    try:
        outputs = json.loads(result.stdout)
        if not isinstance(outputs, list):
            raise ValueError("expected output list")
        return outputs
    except ValueError as error:
        raise SystemExit(f"monitor-info: invalid Sway response: {error}")


def description(out: dict) -> str:
    """Build the ``Make Model Serial`` string used by kanshi for matching.

    Components that are missing or look like "Unknown" are dropped.
    kanshi tolerates a partial description as long as it stays unique
    across the connected set.
    """
    parts = []
    for key in ("make", "model", "serial"):
        value = (out.get(key) or "").strip()
        if value and value.lower() != "unknown":
            parts.append(value)
    return " ".join(parts)


def current_mode(out: dict) -> str:
    """Return the active mode formatted as ``WxH@RefreshHz``.

    sway reports refresh rate in mHz (millihertz, e.g. 59950 for 59.95
    Hz), so we divide by 1000 and format with one decimal — kanshi
    accepts both integer and one-decimal Hz values.
    """
    mode = out.get("current_mode") or next(iter(out.get("modes") or []), {})
    width = mode.get("width", 0)
    if not width or not mode.get("height"):
        raise SystemExit("monitor-info: output has no usable mode")
    height = mode.get("height", 0)
    refresh_mhz = mode.get("refresh", 0)
    refresh_hz = refresh_mhz / 1000.0
    # Use an integer when the refresh is a whole number (60.000 Hz),
    # one-decimal otherwise (59.950 → 59.95). Avoids "60.0" noise.
    if refresh_hz == int(refresh_hz):
        return f"{width}x{height}@{int(refresh_hz)}Hz"
    return f"{width}x{height}@{refresh_hz:.2f}Hz"


def main() -> None:
    outputs = get_outputs()

    # Split into laptop (eDP*) and external. Disabled outputs (e.g. one
    # left off by a previous kanshi profile) still have valid EDID, so
    # we include them — the user is presumably running this *to* set up
    # a docked profile that covers them.
    laptops = [o for o in outputs if o.get("name", "").startswith("eDP")]
    externals = [o for o in outputs if not o.get("name", "").startswith("eDP")]

    if not externals:
        sys.stderr.write(
            "Connect an external monitor and run monitor-info again\n"
        )
        sys.exit(0)

    lines = []
    lines.append("# Copy to ~/.config/kanshi/config")
    lines.append("profile docked {")
    # Disable every detected internal panel. There's only one on
    # laptops in practice, but we loop so multi-eDP machines (rare)
    # still get every panel turned off.
    for laptop in laptops:
        lines.append(f"    output {laptop['name']} disable")

    # Lay externals out left-to-right at y=0. Track the cumulative x
    # offset so each new monitor sits flush to the right of the
    # previous one's full width.
    cursor_x = 0
    for ext in externals:
        desc = description(ext)
        if not desc:
            # Fall back to the connector name if EDID was empty.
            desc = ext["name"]
        desc = desc.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ").replace("\r", " ")
        mode = current_mode(ext)
        width = (ext.get("current_mode") or next(iter(ext.get("modes") or []), {})).get("width", 0)
        # kanshi is happy with double-quoted descriptions even when
        # they have spaces; quote unconditionally for safety.
        lines.append(
            f'    output "{desc}" enable position {cursor_x},0 mode {mode} scale 1'
        )
        cursor_x += width

    lines.append("}")
    print("\n".join(lines))


if __name__ == "__main__":
    main()
