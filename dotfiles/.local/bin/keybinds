#!/usr/bin/env python3
"""Display sway keybindings cheatsheet."""

CONTENT = r"""
Sway shortcuts

Windows
Super hjkl          Focus
Super Shift hjkl    Move
Super Ctrl hjkl     Resize
Super q             Close
Super f             Fullscreen
Super Shift Space   Float
Super t             Change layout
Super \             Split horizontally
Super -             Split vertically
Super `             Scratchpad
Alt Tab             Next window

Workspaces
Super 1 to 9        Open workspace
Super Shift 1 to 9  Move window to workspace
Super Tab           Next workspace
Super o             Next monitor
Super Shift o       Move workspace to monitor

Apps
Super Enter         Terminal
Super Space         Apps
Super g             Appearance
Super b             Browser
Super n             New note
Super m             Find note
Super e             Files
Super p             Passwords
Super v             Editor

System
Super F11           Dim screen
Super F12           Brighten screen
Super Escape        Lock
Super x             Power
Super i             Status
Super Shift i       System monitor
Super w             WiFi
Super Shift b       Bluetooth
Super u             Eject drives
Super Shift c       Reload Sway
Super Shift e       Exit Sway
Super Shift /       Shortcuts

Screenshots
Print               Select area
Shift Print         Full screen

Press Enter to close
"""

def main():
    print(CONTENT)
    try:
        input()
    except (KeyboardInterrupt, EOFError):
        pass

if __name__ == "__main__":
    main()
