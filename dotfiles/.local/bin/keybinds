#!/usr/bin/env python3
"""Display the Sway shortcut sheet; `toggle` shows or hides it through the scratchpad."""
import json
import os
import subprocess
import sys

CONTENT = r"""
Sway shortcuts

Windows
Super hjkl          Focus
Super Shift hjkl    Move
Super Ctrl hjkl     Resize
Super q             Close
Super f             Fullscreen
Super Shift Space   Float
Super t             Change layout
Super \             Split horizontally
Super -             Split vertically
Super `             Scratchpad
Super Shift `       Send to scratchpad
Super Shift s       Sticky
Super a             Focus parent
Alt Tab             Next window

Workspaces
Super 1 to 9        Open workspace
Super Shift 1 to 9  Move window to workspace
Super Tab           Next workspace
Super Shift Tab     Previous workspace
Super o             Next monitor
Super Shift o       Move workspace to monitor

Apps
Super Enter         Terminal
Super Space         Apps
Super g             Appearance
Super b             Browser
Super n             New note
Super Shift n       Notifications
Super m             Find note
Super e             Files
Super p             KeePassXC show/hide
Super v             Editor

System
Super F11           Dim screen
Super F12           Brighten screen
Super Escape        Lock
Super x             Power
Super i             Toggle status
Super Shift i       System monitor
Super w             WiFi
Super Shift b       Bluetooth
Super c             Virtual machines
Super u             Eject drives
Super Ctrl p        Passthrough mode on/off
Super Shift c       Reload Sway
Super Shift e       Exit Sway
Super Shift /       Shortcuts

Screenshots
Print               Select area
Shift Print         Full screen

Super Shift / hides this window; Enter closes it
"""


def windows(node, workspace=None):
    if node.get("type") == "workspace":
        workspace = node.get("name")
    yield node, workspace
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        yield from windows(child, workspace)


def toggle():
    """Launch the sheet, hide it when focused, or bring it back from the scratchpad."""
    try:
        result = subprocess.run(["swaymsg", "-r", "-t", "get_tree"],
                                capture_output=True, text=True, timeout=3, check=True)
        tree = json.loads(result.stdout)
        if not isinstance(tree, dict) or tree.get("type") != "root":
            raise ValueError("Invalid Sway tree")
        matches = [(n, ws) for n, ws in windows(tree) if n.get("app_id") == "keybinds"]
        if not matches:
            os.execvp("foot", ["foot", "--app-id=keybinds", "-e", os.path.realpath(__file__)])
        node, workspace = next(((n, ws) for n, ws in matches if n.get("focused")), matches[0])
        selector = f"[con_id={int(node['id'])}]"
        if node.get("focused"):
            command = f"{selector} move scratchpad"
        elif workspace == "__i3_scratch":
            command = f"{selector} scratchpad show, focus"
        else:
            command = f"{selector} focus"
        result = subprocess.run(["swaymsg", "-r", command], capture_output=True,
                                text=True, timeout=3, check=True)
        replies = json.loads(result.stdout)
        if not replies or not all(item.get("success") for item in replies):
            raise ValueError("Sway rejected the shortcut window command")
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"keybinds: {error}", file=sys.stderr)
        return 1
    return 0


def main():
    if sys.argv[1:] == ["toggle"]:
        return toggle()
    print(CONTENT)
    try:
        input()
    except (KeyboardInterrupt, EOFError):
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
