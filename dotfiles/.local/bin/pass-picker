#!/bin/bash
# Simple pass picker using fuzzel - copies password to clipboard
set -euo pipefail

export PASSWORD_STORE_DIR="$HOME/.password-store"

[[ -d "$PASSWORD_STORE_DIR" ]] || exit 0
entry=$(find "$PASSWORD_STORE_DIR" -name '*.gpg' -printf '%P\n' 2>/dev/null | \
    sed 's/\.gpg$//' | \
    fuzzel --dmenu --prompt="Passwords ") || exit 0

if [[ -n "$entry" && "$entry" != -* && "$entry" != /* && "/$entry/" != *"/../"* && -f "$PASSWORD_STORE_DIR/$entry.gpg" ]]; then
    exec foot --app-id=pass-prompt -e pass -c -- "$entry"
fi
