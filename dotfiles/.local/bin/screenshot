#!/bin/bash
# Capture a region (default/select) or all outputs (full), save and copy it.
set -euo pipefail

mode="${1:-select}"
out_dir="$HOME/Pictures"
umask 077
out=""
captured=false
trap 'if [[ -n "$out" && "$captured" == false ]]; then rm -f -- "$out"; fi' EXIT

case "$mode" in
    select)
        region=$(slurp) || exit 0
        [[ -n "$region" ]] || exit 0
        mkdir -p "$out_dir"
        out=$(mktemp "$out_dir/screenshot_$(date +%Y%m%d_%H%M%S)_XXXXXX.png")
        grim -g "$region" "$out"
        ;;
    full)
        mkdir -p "$out_dir"
        out=$(mktemp "$out_dir/screenshot_$(date +%Y%m%d_%H%M%S)_XXXXXX.png")
        grim "$out"
        ;;
    *)
        notify-send -u critical "Screenshot" "Use select or full"
        exit 1
        ;;
esac
captured=true

# Keep a successful capture even if clipboard delivery fails.
wl-copy --type image/png < "$out"
notify-send "Screenshot" "Saved and copied
$out"
