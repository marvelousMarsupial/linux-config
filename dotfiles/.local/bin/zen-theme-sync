#!/usr/bin/python3
"""Install desktop colors in Zen's default profile; takes effect on restart."""
import configparser
import json
from pathlib import Path
import re
import tempfile


THEME_BEGIN = '/* desktop-theme:begin */'
THEME_END = '/* desktop-theme:end */'


def default_profile(home):
    root = home / '.zen'
    profiles = configparser.ConfigParser(interpolation=None)
    profiles.read(root / 'profiles.ini')
    selected = next((profiles[s]['Default'] for s in profiles.sections()
                     if s.startswith('Install') and profiles[s].get('Default')), None)
    if not selected:
        section = next((s for s in profiles.sections() if s.startswith('Profile')
                        and profiles[s].get('Default') == '1'), None)
        selected = profiles[section].get('Path') if section else None
    if not selected:
        return None
    profile = (root / selected).resolve()
    if not profile.is_dir() or not profile.is_relative_to(root.resolve()):
        raise ValueError('Invalid default Zen profile')
    return profile


def replace_file(path, text, mode=0o644):
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as temporary:
        staged = Path(temporary.name)
        temporary.write(text)
    try:
        staged.chmod(mode)
        staged.replace(path)
    finally:
        staged.unlink(missing_ok=True)


def sync(home):
    profile = default_profile(home)
    if profile is None:
        return
    chrome = profile / 'chrome'
    if not chrome.resolve().is_relative_to(profile):
        raise ValueError('Invalid Zen chrome directory')
    source = home / '.config/zen'
    # Read every source before replacing any profile files.
    files = {'system-theme.css': (source / 'system-theme.css').read_text(),
             'glass-palette.css': (source / 'glass-palette.css').read_text(),
             'glass-chrome.css': (source / 'userChrome.css').read_text()}
    stylesheet = chrome / 'userChrome.css'
    existing = stylesheet.read_text() if stylesheet.exists() else ''
    existing = re.sub(re.escape(THEME_BEGIN) + r'.*?' + re.escape(THEME_END) + r'\n?',
                      '', existing, flags=re.S)
    existing = f'{THEME_BEGIN}\n@import "system-theme.css";\n{THEME_END}\n' + existing
    prefs = profile / 'user.js'
    text = prefs.read_text() if prefs.exists() else ''
    # Dark is the intended default regardless of the selected browser theme.
    managed = {
        'browser.tabs.inTitlebar': 1,
        'zen.view.experimental-no-window-controls': True,
        'toolkit.legacyUserProfileCustomizations.stylesheets': True,
        'ui.systemUsesDarkTheme': 1,
        'browser.theme.content-theme': 0,
        'layout.css.prefers-color-scheme.content-override': 0,
    }
    for key, value in managed.items():
        text = re.sub(r'(?m)^user_pref\("' + re.escape(key) + r'",.*\);\n?', '', text)
        text = text.rstrip('\n') + f'\nuser_pref("{key}", {json.dumps(value)});\n'
    chrome.mkdir(exist_ok=True)
    for name, content in files.items():
        replace_file(chrome / name, content)
    replace_file(stylesheet, existing, 0o600)
    replace_file(prefs, text, 0o600)


def main():
    try:
        sync(Path.home())
    except (OSError, ValueError, configparser.Error) as error:
        raise SystemExit(f'Zen theme: {error}')


if __name__ == '__main__':
    main()
