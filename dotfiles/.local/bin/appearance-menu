#!/usr/bin/python3
"""A compact palette picker with a transparency switch.

Each palette is drawn as a card in its own colors: the desktop background,
the main text and the eight accents. Hovering shows its raised surface and
selecting it shows its focus accent, so the choice is visible before applying.
"""
import re
import subprocess
import sys
from pathlib import Path
from threading import Thread

ACCENT_KEYS = ('base08', 'base09', 'base0A', 'base0B', 'base0C', 'base0D', 'base0E', 'base0F')


def read_state(path, default):
    return path.read_text().strip() if path.exists() else default


def load_palettes(home):
    import yaml
    palettes = {}
    for path in sorted((home / '.config/theme/schemes').glob('*.yaml')):
        data = yaml.safe_load(path.read_text())
        if not isinstance(data, dict) or any(
                not re.fullmatch(r'[0-9a-fA-F]{6}', str(data.get(f'base{i:02X}', '')))
                for i in range(16)):
            raise ValueError(f'Invalid palette: {path.stem}')
        palettes[path.stem] = dict(data, title=str(data.get('scheme', path.stem)))
    if not palettes:
        raise ValueError('No themes installed.')
    return palettes


def get_state(home):
    return (read_state(home / '.cache/theme/current', ''),
            read_state(home / '.config/theme/glass-mode', 'off') == 'on')


def apply_settings(home, scheme, transparent):
    # Validate again at the write boundary; never interpret a label as a command.
    if scheme not in load_palettes(home):
        raise ValueError('Choose an installed theme.')
    current, glass = get_state(home)
    commands = []
    if scheme != current:
        commands.append([str(home / '.local/bin/theme'), 'apply', scheme])
    if transparent != glass:
        commands.append([str(home / '.local/bin/glass-mode'), 'on' if transparent else 'off'])
    for command in commands:
        result = subprocess.run(command, text=True, capture_output=True, timeout=120)
        if result.returncode:
            raise RuntimeError((result.stderr or result.stdout or 'Could not apply appearance.').strip()[-1200:])


def stylesheet(palettes, selected):
    p = palettes[selected]
    css = """
    .appearance { font-family: "CaskaydiaCove Nerd Font", monospace; font-size: 13px; }
    window.appearance { background: #BG; color: #FG; }
    .appearance list { background: transparent; }
    .appearance row { padding: 10px 14px; border: 2px solid transparent;
        border-radius: 8px; margin: 3px 0; }
    .appearance row:focus { outline: none; }
    .appearance .chip { min-width: 16px; min-height: 16px; border-radius: 100%; margin-left: 5px; }
    .appearance .title { margin-right: 16px; }
    .appearance .glass-icon { color: #MUTED; font-size: 20px; }
    .appearance row.toggle { background: #SURFACE; color: #FG; }
    .appearance row.toggle:selected { border-color: #ACCENT; }
    .appearance switch { background: #BG; border: 1px solid #MUTED;
        border-radius: 20px; min-width: 38px; }
    .appearance switch:checked { background: #ACCENT; border-color: #ACCENT; }
    .appearance switch slider { background: #FG; border: none; border-radius: 20px;
        min-width: 16px; min-height: 16px; box-shadow: none; }
    .appearance switch:focus { outline: none; }
    .appearance spinner { color: #ACCENT; }
    """
    for token, key in [('BG', 'base01'), ('FG', 'base05'), ('ACCENT', 'base0D'),
                       ('SURFACE', 'base00'), ('MUTED', 'base04')]:
        css = css.replace('#' + token, '#' + p[key])
    # Every card is painted in its own palette, whatever is currently applied.
    for index, palette in enumerate(palettes.values()):
        css += (f'.appearance #row-{index} {{ background: #{palette["base00"]}; color: #{palette["base05"]}; '
                f'border-color: #{palette["base02"]}; }}\n'
                f'.appearance #row-{index}:hover {{ background: #{palette["base01"]}; }}\n'
                f'.appearance #row-{index}:selected {{ border-color: #{palette["base0D"]}; }}\n')
        for chip, key in enumerate(ACCENT_KEYS):
            css += f'.appearance #chip-{index}-{chip} {{ background: #{palette[key]}; }}\n'
    return css


def create_application(home, palettes):
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, Gio, GLib, Gtk

    class Appearance(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='org.linuxconfig.Appearance',
                             flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.window = None
            self.busy = False

        def do_activate(self):
            if self.window:
                self.window.present()
                return
            current, glass = get_state(home)
            self.slugs = list(palettes)
            selected = current if current in palettes else self.slugs[0]
            self.theme_index = self.slugs.index(selected)
            self.window = Gtk.ApplicationWindow(application=self, title='Appearance')
            self.window.set_decorated(False)
            self.window.set_resizable(False)
            self.window.set_position(Gtk.WindowPosition.CENTER)
            self.window.get_style_context().add_class('appearance')
            # Capture before GtkListBox / GtkSwitch consume arrow and Enter keys.
            self.keys = Gtk.EventControllerKey.new(self.window)
            self.keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            self.keys.connect('key-pressed', self.keypress)
            self.window.connect('delete-event', lambda *_: self.busy)
            self.window.connect('destroy', lambda *_: self.quit())
            provider = Gtk.CssProvider()
            provider.load_from_data(stylesheet(palettes, selected).encode())
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                    Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            outer.set_border_width(12)
            self.window.add(outer)
            self.rows = Gtk.ListBox()
            self.rows.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.rows.set_activate_on_single_click(False)
            self.rows.connect('row-selected', self.row_selected)
            self.rows.connect('row-activated', lambda *_: self.activate_selection())
            for index, slug in enumerate(self.slugs):
                row = Gtk.ListBoxRow()
                row.set_name(f'row-{index}')
                row.set_can_focus(True)
                row.get_accessible().set_name(palettes[slug]['title'])
                card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
                title = Gtk.Label(label=palettes[slug]['title'], xalign=0)
                title.get_style_context().add_class('title')
                card.pack_start(title, True, True, 0)
                for chip in range(len(ACCENT_KEYS)):
                    swatch = Gtk.Box()
                    swatch.set_name(f'chip-{index}-{chip}')
                    swatch.set_valign(Gtk.Align.CENTER)
                    swatch.get_style_context().add_class('chip')
                    card.pack_start(swatch, False, False, 0)
                row.add(card)
                self.rows.add(row)
            # The toggle is a normal final row. Focus belongs to its row, so
            # keyboard activation does not depend on GtkSwitch child focus.
            toggle_row = Gtk.ListBoxRow()
            toggle_row.get_style_context().add_class('toggle')
            toggle_row.set_can_focus(True)
            toggle_row.get_accessible().set_name('Transparency')
            toggle_row.set_tooltip_text('Transparency')
            footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            footer.set_margin_top(6)
            footer.set_margin_bottom(6)
            icon = Gtk.Label(label='◐')
            icon.get_style_context().add_class('glass-icon')
            footer.pack_start(icon, False, False, 0)
            self.spinner = Gtk.Spinner()
            self.spinner.set_no_show_all(True)
            footer.pack_start(self.spinner, True, False, 0)
            self.switch = Gtk.Switch(active=glass)
            self.switch.set_can_focus(False)
            self.switch.set_valign(Gtk.Align.CENTER)
            self.switch.get_accessible().set_name('Transparency')
            self.switch.connect('notify::active', self.toggle_transparency)
            footer.pack_end(self.switch, False, False, 0)
            toggle_row.add(footer)
            self.rows.add(toggle_row)
            outer.pack_start(self.rows, False, False, 0)
            self.focus_row(self.theme_index)
            self.window.show_all()
            self.focus_row(self.theme_index)

        def row_selected(self, _rows, row):
            if row and row.get_index() < len(self.slugs):
                self.theme_index = row.get_index()

        def focus_row(self, index):
            row = self.rows.get_row_at_index(index)
            self.rows.select_row(row)
            row.grab_focus()

        def activate_selection(self):
            if self.busy:
                return
            if self.rows.get_selected_row().get_index() == len(self.slugs):
                self.switch.set_active(not self.switch.get_active())
            else:
                self.apply()

        def keypress(self, _controller, key, _keycode, modifiers):
            # Leave desktop/application shortcuts alone.
            if modifiers & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK |
                            Gdk.ModifierType.SUPER_MASK):
                return False
            if self.busy:
                return True
            count = len(self.slugs)
            index = self.rows.get_selected_row().get_index()
            if key == Gdk.KEY_Escape:
                self.window.close()
            elif key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
                self.activate_selection()
            elif key in (Gdk.KEY_Up, Gdk.KEY_Down, Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
                backward = key in (Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab) or (
                    key == Gdk.KEY_Tab and modifiers & Gdk.ModifierType.SHIFT_MASK)
                self.focus_row((index + (-1 if backward else 1)) % (count + 1))
            elif key == Gdk.KEY_Home:
                self.focus_row(0)
            elif key == Gdk.KEY_End:
                self.focus_row(count)
            elif key in (Gdk.KEY_Left, Gdk.KEY_Right):
                self.focus_row(self.theme_index if index == count else count)
            else:
                return False
            return True

        def toggle_transparency(self, *_):
            if not self.busy:
                # Preserve the actual applied theme, not the palette being browsed.
                current, _glass = get_state(home)
                self.apply(close=False, scheme=current or None)

        def apply(self, close=True, scheme=None):
            if self.busy:
                return
            self.busy = True
            self.rows.set_sensitive(False)
            self.spinner.show()
            self.spinner.start()
            selected = scheme or self.slugs[self.theme_index]
            transparent = self.switch.get_active()

            def worker():
                error = None
                try:
                    apply_settings(home, selected, transparent)
                except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as failure:
                    error = str(failure)
                GLib.idle_add(self.finished, error, close)

            Thread(target=worker, daemon=True).start()

        def finished(self, error, close):
            self.rows.set_sensitive(True)
            self.spinner.stop()
            self.spinner.hide()
            if error:
                self.switch.set_active(get_state(home)[1])
            self.busy = False
            if error:
                try:
                    subprocess.Popen(['notify-send', '-u', 'critical', 'Appearance', error])
                except OSError:
                    print(error, file=sys.stderr)
            elif close:
                self.window.close()
            else:
                self.focus_row(len(self.slugs))
            return False

    return Appearance()


def main():
    try:
        home = Path.home()
        application = create_application(home, load_palettes(home))
    except (ImportError, OSError, ValueError) as error:
        print(f'Appearance: {error}', file=sys.stderr)
        return 1
    return application.run(sys.argv)


if __name__ == '__main__':
    raise SystemExit(main())
