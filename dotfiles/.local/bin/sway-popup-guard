#!/usr/bin/python3
"""Reveal new floating windows during fullscreen and restore fullscreen on close."""
import json
import configparser
import os
from pathlib import Path
import re
import socket
import stat
import struct
import sys


class IPC:
    def __init__(self):
        self.socket = socket.socket(socket.AF_UNIX)
        self.socket.connect(os.environ['SWAYSOCK'])

    def read(self):
        def exact(size):
            data = bytearray()
            while len(data) < size:
                part = self.socket.recv(size - len(data))
                if not part:
                    raise EOFError
                data.extend(part)
            return data
        magic, size, kind = struct.unpack('<6sII', exact(14))
        if magic != b'i3-ipc':
            raise RuntimeError('Invalid Sway IPC response')
        return kind, json.loads(exact(size))

    def request(self, kind, value=''):
        payload = value.encode()
        self.socket.sendall(struct.pack('<6sII', b'i3-ipc', len(payload), kind) + payload)
        return self.read()[1]


def walk(node, workspace=None, floating=False):
    if node['type'] == 'workspace':
        workspace = node
    yield node, workspace, floating
    for child in node.get('nodes', []):
        yield from walk(child, workspace, floating)
    for child in node.get('floating_nodes', []):
        yield from walk(child, workspace, True)


def fullscreen(node):
    return node['type'] in ('con', 'floating_con') and node.get('fullscreen_mode', 0)


def write_foot_background(pid, sequence):
    """Send Foot's OSC 11 background/alpha command through its child's PTY."""
    try:
        executable = (Path('/proc') / str(pid) / 'exe').readlink().name
        if executable.removesuffix(' (deleted)') != 'foot':
            return False
        children = (Path('/proc') / str(pid) / 'task' / str(pid) / 'children').read_text().split()
        for child in children:
            for stream in ('0', '1', '2'):
                try:
                    tty = (Path('/proc') / child / 'fd' / stream).readlink()
                    if not re.fullmatch(r'/dev/pts/\d+', str(tty)):
                        continue
                    fd = os.open(tty, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
                    try:
                        info = os.fstat(fd)
                        if info.st_uid == os.getuid() and stat.S_ISCHR(info.st_mode):
                            return os.write(fd, sequence) == len(sequence)
                    finally:
                        os.close(fd)
                except OSError:
                    continue
    except OSError:
        pass  # The process can exit between the Sway event and this write.
    return False


class FootOpacity:
    """Apply background alpha on window events, including floating toggles."""
    def __init__(self, home, write=write_foot_background):
        self.home = home
        self.write = write
        self.applied = {}

    def sync(self, tree):
        colors = configparser.ConfigParser(interpolation=None)
        try:
            colors.read(self.home / '.config/foot/colors.ini')
            background = colors.get('colors', 'background', fallback='')
            alpha = colors.getfloat('colors', 'alpha', fallback=1.0)
        except (OSError, ValueError, configparser.Error):
            return
        if not re.fullmatch(r'[0-9a-fA-F]{6}', background) or not 0 <= alpha <= 1:
            return
        active = set()
        for node, _, floating in walk(tree):
            pid = node.get('pid')
            if not isinstance(pid, int) or pid <= 0:
                continue
            active.add(node['id'])
            opacity = round(100 * (max(0.60, alpha) if floating else alpha))
            value = (pid, background, opacity)
            if self.applied.get(node['id']) == value:
                continue
            sequence = f'\x1b]11;[{opacity}]#{background}\x1b\\'.encode()
            if self.write(pid, sequence):
                self.applied[node['id']] = value
        self.applied = {key: value for key, value in self.applied.items() if key in active}


class PopupGuard:
    def __init__(self, command):
        self.command = command
        self.suspended = {}
        self.pending = set()

    def track_terminal(self, node, by_id):
        # The shortcut exits fullscreen before Foot maps. Its app ID carries
        # the original container and mode so close/move restoration still works.
        match = re.fullmatch(r'fullscreen-terminal-(\d+)-([12])', node.get('app_id') or '')
        if not match or int(match[1]) not in by_id:
            return False
        parent, workspace, _ = by_id[int(match[1])]
        popup_workspace = by_id[node['id']][1]
        if (not workspace or not popup_workspace or workspace['id'] != popup_workspace['id']
                or fullscreen(parent)):
            return False
        saved = self.suspended.get(workspace['id'])
        if saved and saved['parent'] != parent['id']:
            return False
        if not saved:
            saved = dict(parent=parent['id'], mode=int(match[2]), popups=set())
            self.suspended[workspace['id']] = saved
        saved['popups'].add(node['id'])
        self.pending.discard(node['id'])
        return True

    def handle(self, event, tree):
        change = event.get('change')
        target = event.get('container', {}).get('id')
        if change == 'new':
            self.pending.add(target)
        elif change == 'close':
            self.pending.discard(target)
        entries = list(walk(tree))
        by_id = {n['id']: (n, ws, floating) for n, ws, floating in entries}
        if change == 'close':
            by_id.pop(target, None)
        for ws_id, saved in list(self.suspended.items()):
            saved['popups'] = {i for i in saved['popups'] if i in by_id and
                               by_id[i][1] and by_id[i][1]['id'] == ws_id}
            if saved['parent'] not in by_id:
                del self.suspended[ws_id]
            elif not saved['popups']:
                del self.suspended[ws_id]
                if not any(fullscreen(n) and n['id'] != saved['parent']
                           for n, ws, _ in entries if ws and ws['id'] == ws_id):
                    suffix = ' global' if saved['mode'] == 2 else ''
                    self.command(f'[con_id={saved["parent"]}] fullscreen enable{suffix}')
        if target not in by_id or change not in (
                'new', 'floating', 'fullscreen_mode', 'move', 'focus', 'title', 'startup'):
            return
        node, ws, floating = by_id[target]
        if not ws or ws['name'] == '__i3_scratch' or not ws.get('visible', True):
            return
        ws_id = ws['id']
        if change == 'new' and self.track_terminal(node, by_id):
            return
        if change == 'fullscreen_mode':
            if fullscreen(node):
                # An explicit fullscreen action takes priority over old floaters
                # and any earlier reveal/restore session on this workspace.
                self.suspended.pop(ws_id, None)
                self.pending.difference_update(n['id'] for n, w, _ in entries
                                               if w and w['id'] == ws_id)
            return
        if change in ('floating', 'move') and floating:
            self.pending.add(target)
        if change != 'new' and target not in self.pending:
            return
        saved = self.suspended.get(ws_id)
        if saved and target in saved['popups']:
            return
        fs = next((n for n, w, _ in entries if fullscreen(n) and n['id'] != target and
                   (n['fullscreen_mode'] == 2 or (w and w['id'] == ws_id))), None)
        if not saved and not fs:
            self.pending.discard(target)
            return
        if fullscreen(node) or (saved and saved['parent'] == target):
            self.pending.discard(target)
            return
        if not saved:
            saved = dict(parent=fs['id'], mode=fs['fullscreen_mode'], popups=set())
            self.suspended[ws_id] = saved
        self.pending.discard(target)
        saved['popups'].add(target)
        # Only the repo's own terminal popups (pickers, scratch terminals) take the
        # 65% frame. Native dialogs size themselves; forcing them bigger leaves a
        # small dialog inside a large empty border.
        resize = ''
        if re.fullmatch(r'(foot|footclient|yazi-portal|fullscreen-terminal-\d+-[12])', node.get('app_id') or ''):
            width = max(1, min(800, int(ws['rect']['width'] * 0.65)))
            height = max(1, min(550, int(ws['rect']['height'] * 0.65)))
            resize = f'resize set {width} {height}, '
        self.command(f'[con_id={saved["parent"]}] fullscreen disable; '
                     f'[con_id={target}] floating enable, {resize}move position center, focus')

    def recover(self, tree, startup=False):
        # Retry only windows arriving during fullscreen. Existing floaters must
        # not undo an explicit fullscreen action on every focus/title event.
        entries = list(walk(tree))
        by_id = {n['id']: (n, ws, floating) for n, ws, floating in entries}
        for node, workspace, floating in entries:
            if startup and self.track_terminal(node, by_id):
                continue
            if (workspace and not node.get('visible', False) and not fullscreen(node)
                    and (node.get('app_id') or node.get('window'))):
                if startup and floating:
                    self.pending.add(node['id'])
                if node['id'] in self.pending:
                    self.handle({'change': 'startup', 'container': {'id': node['id']}}, tree)


def main():
    commands, events = IPC(), IPC()
    if not events.request(2, '["window", "shutdown"]').get('success'):
        raise RuntimeError('Unable to subscribe to Sway window events')

    def command(text):
        result = commands.request(0, text)
        if not all(item.get('success') for item in result):
            # A window may close between its event and the command. Keep the
            # guard alive so the close event can restore the fullscreen parent.
            print(f'Sway popup command failed: {result}', file=sys.stderr)

    guard = PopupGuard(command)
    opacity = FootOpacity(Path.home())
    tree = commands.request(4)
    guard.recover(tree, startup=True)
    opacity.sync(tree)
    while True:
        kind, event = events.read()
        if kind == 0x80000006:
            return
        if event.get('change') not in ('new', 'close', 'floating', 'fullscreen_mode',
                                      'move', 'focus', 'title'):
            continue
        tree = commands.request(4)
        guard.handle(event, tree)
        guard.recover(tree)
        opacity.sync(tree)


if __name__ == '__main__':
    try:
        main()
    except EOFError:
        pass
