#!/bin/bash
# fuzzel wrapper that extends XDG_DATA_DIRS so flatpak app entries
# (~/.local/share/flatpak/exports/share/applications/, /var/lib/flatpak/...)
# show up in the launcher. Sway starts outside an interactive shell, so
# /etc/profile.d/flatpak.sh never runs and the default XDG_DATA_DIRS
# (/usr/local/share:/usr/share) misses the flatpak app entries.

export XDG_DATA_DIRS="/var/lib/flatpak/exports/share:/usr/local/share:/usr/share:$HOME/.local/share/flatpak/exports/share:$HOME/.local/share"

exec fuzzel "$@"
