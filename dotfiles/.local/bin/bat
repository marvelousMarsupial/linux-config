#!/usr/bin/python3
"""batcat with a rounded frame that closes on the right in interactive terminals.

bat draws a left bar and horizontal rules but never a right edge. This wrapper
runs batcat two columns narrower than the terminal, then turns each rule into a
rounded top, divider or bottom and pads every content line out to a right bar,
leaving one blank cell between the longest text and the bar.
Piped output, an explicit BAT_PAGER and paging flags leave batcat alone.
"""
import os
import re
import shutil
import subprocess
import sys
import unicodedata

ANSI = re.compile(r'\x1b\[[0-9;]*m')
RULE = re.compile(r'^─+([┬┼┴])─+$')
CORNERS = {'┬': ('╭', '╮'), '┼': ('├', '┤'), '┴': ('╰', '╯')}
# Blank cells kept between the widest text and the right bar.
MARGIN = 1


def display_width(text):
    """Count terminal cells without counting ANSI color escapes."""
    text = ANSI.sub('', text)
    return sum(0 if unicodedata.combining(char) or unicodedata.category(char) in ('Mn', 'Me', 'Cf') else
               2 if unicodedata.east_asian_width(char) in ('W', 'F') else 1
               for char in text)


def framed(lines):
    """Close each of bat's grids on the right with rounded corners."""
    width = None
    color = ''
    for line in lines:
        body = line.rstrip('\n')
        plain = ANSI.sub('', body)
        rule = RULE.fullmatch(plain)
        if rule:
            # The gutter before the junction stays blank so the frame hugs the text.
            width = len(plain) + MARGIN
            color = ''.join(ANSI.findall(body[:body.index(rule[1])]))
            gutter = plain.index(rule[1])
            left, right = CORNERS[rule[1]]
            yield ' ' * gutter + color + left + '─' * (width - gutter - 1) + right + '\x1b[0m\n'
            if rule[1] == '┴':
                width = None
        elif width is not None:
            padding = max(0, width - display_width(plain))
            yield body + ' ' * padding + color + '│\x1b[0m\n'
        else:
            yield line


def main():
    arguments = sys.argv[1:]
    paging_off = any(arg in ('-P', '--paging=never') for arg in arguments)
    if not sys.stdout.isatty() or os.environ.get('BAT_PAGER') or any(arg.startswith('--paging') for arg in arguments):
        os.execvp('batcat', ['batcat', *arguments])
    if not any(arg.startswith('--terminal-width') for arg in arguments):
        # Reserve the margin and the right edge before bat wraps content.
        arguments.append(f'--terminal-width={max(20, shutil.get_terminal_size().columns - 1 - MARGIN)}')
    bat = subprocess.Popen(['batcat', '--color=always', '--decorations=always', '--paging=never', *arguments],
                           stdout=subprocess.PIPE, text=True)
    pager = None
    output = sys.stdout
    if not paging_off and shutil.which('less'):
        pager = subprocess.Popen(['less', '-RF'], stdin=subprocess.PIPE, text=True)
        output = pager.stdin
    try:
        for line in framed(bat.stdout):
            output.write(line)
        output.flush()
    except BrokenPipeError:
        pass
    finally:
        bat.stdout.close()
        if pager:
            try:
                output.close()
            except BrokenPipeError:
                pass
            pager.wait()
    sys.exit(bat.wait())


if __name__ == '__main__':
    main()
