#!/bin/bash
# Power menu using fuzzel
set -euo pipefail

choice=$(printf "Lock\nSleep\nLog out\nRestart\nShut down" | fuzzel --dmenu --prompt="Power  " --lines=5 --width=20) || exit 0

case "$choice" in
    Lock)       swaylock -f ;;
    Sleep)      systemctl suspend ;;
    "Log out")  swaymsg exit ;;
    Restart)    systemctl reboot ;;
    "Shut down") systemctl poweroff ;;
esac
