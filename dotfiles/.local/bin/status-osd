#!/usr/bin/env python3
"""status-osd - display system status as a notification popup"""

import argparse
import os
import subprocess
from datetime import datetime
from pathlib import Path

# Source D-Bus environment for remote desktop sessions
dbus_env = Path(f"/run/user/{os.getuid()}/dbus-env")
if dbus_env.exists() and "DBUS_SESSION_BUS_ADDRESS" not in os.environ:
    for line in dbus_env.read_text().splitlines():
        if line.startswith("export DBUS_SESSION_BUS_ADDRESS="):
            addr = line.split("=", 1)[1].strip("'\"")
            os.environ["DBUS_SESSION_BUS_ADDRESS"] = addr

def run_output(cmd: list[str]) -> str:
    """Run a command and return stdout."""
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return result.stdout.strip() if result.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""

def get_time() -> str:
    """Get current time."""
    return datetime.now().strftime("%H:%M")

def get_date() -> str:
    """Get current date."""
    return datetime.now().strftime("%a %b %d")

def find_battery() -> Path | None:
    """Find battery path."""
    bat0 = Path("/sys/class/power_supply/BAT0")
    if bat0.is_dir():
        return bat0

    power_supply = Path("/sys/class/power_supply")
    for bat in power_supply.glob("BAT*"):
        if bat.is_dir():
            return bat
    return None

def get_battery() -> str:
    """Get battery status."""
    bat_path = find_battery()
    if bat_path is None:
        return "AC"

    try:
        capacity = (bat_path / "capacity").read_text().strip()
        status = (bat_path / "status").read_text().strip()
        icons = {
            "Charging": "+",
            "Discharging": "-",
            "Full": "=",
        }
        icon = icons.get(status, "")
        return f"{capacity}% {icon}"
    except IOError:
        return "AC"

def get_network() -> str:
    """Get network status via nmcli."""
    output = run_output(["nmcli", "-t", "-f", "NAME,TYPE", "c", "show", "--active"])
    if not output:
        return "Disconnected"

    wifi = ""
    ethernet = ""

    for line in output.splitlines():
        parts = line.rsplit(":", 1)
        if len(parts) >= 2:
            name, conn_type = parts[0].replace(r"\:", ":").replace(r"\\", "\\"), parts[1]
            if conn_type in ("wifi", "802-11-wireless") and not wifi:
                wifi = name
            elif conn_type in ("ethernet", "802-3-ethernet") and not ethernet:
                ethernet = name

    if wifi:
        return wifi
    elif ethernet:
        return "Wired"
    return "Disconnected"

def get_bluetooth() -> str:
    """Get connected bluetooth device."""
    output = run_output(["bluetoothctl", "devices", "Connected"])
    if output:
        # Format: Device XX:XX:XX:XX:XX:XX Name
        parts = output.splitlines()[0].split(None, 2)
        if len(parts) >= 3:
            return parts[2]
    return ""

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="status-osd",
        description="Display system status as a desktop notification",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Shows a brief notification with:
  - Current time and date
  - Battery level and status
  - Network connection
  - Bluetooth device (if connected)

Designed to be bound to a key in Sway for quick status checks.

Requires:
  - notify-send (for notifications)
  - nmcli (for network status)
  - bluetoothctl (for bluetooth, optional)
"""
    )
    parser.add_argument(
        "-t", "--timeout",
        type=int,
        default=2500,
        metavar="MS",
        help="Notification timeout in milliseconds (default: 2500)"
    )
    args = parser.parse_args()

    time_str = get_time()
    date_str = get_date()
    battery = get_battery()
    network = get_network()
    bluetooth = get_bluetooth()

    # Build message
    lines = [
        time_str,
        date_str,
        "",
        f"Battery: {battery}",
        f"Network: {network}",
    ]

    if bluetooth:
        lines.append(f"Bluetooth: {bluetooth}")

    msg = "\n".join(lines)

    # Send notification
    subprocess.run([
        "notify-send",
        "-a", "status-osd",
        "-u", "normal",
        "-t", str(args.timeout),
        "",
        msg
    ])

if __name__ == "__main__":
    main()
