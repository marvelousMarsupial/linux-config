#!/bin/bash
# Focus an existing notes window or create a private, unique note.
set -euo pipefail
vault="$HOME/vault"
tree=$(swaymsg -t get_tree) || exit 1
if jq -e '.. | objects | select(.app_id? == "notes")' <<< "$tree" >/dev/null; then
    exec swaymsg '[app_id="notes"] focus'
fi
umask 077
mkdir -p -- "$vault"
note=$(mktemp "$vault/$(date +%Y%m%d-%H%M%S)-XXXXXX.md")
printf '# \n' > "$note"
exec foot --app-id=notes -e nvim '+normal! A' -- "$note"
