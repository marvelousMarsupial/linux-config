#!/usr/bin/env bash
# Import the compositor environment and start its systemd user target.
set -euo pipefail

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-sway}"
export XDG_SESSION_TYPE=wayland
# One cursor for the compositor, GTK, Qt and XWayland; Sway's seat setting matches.
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Explicit imports avoid leaking unrelated shell variables to user services.
VARS="DESKTOP_SESSION XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE"
VARS="$VARS DISPLAY WAYLAND_DISPLAY SWAYSOCK XCURSOR_THEME XCURSOR_SIZE"
SESSION_TARGET="sway-session.target"

# Do not overwrite another active session's environment.
if systemctl --user --quiet is-active "$SESSION_TARGET"; then
    echo "sway-session: $SESSION_TARGET already active" >&2
    exit 0
fi

# Also cover Sway launched manually or by a display manager.
if [[ -r "$HOME/.config/environment.d/appearance.conf" ]]; then
    source "$HOME/.config/environment.d/appearance.conf"
    export GTK_THEME
fi
VARS="$VARS GTK_THEME"

# Confirm that the compositor accepts IPC before starting session services.
swaymsg --type get_version >/dev/null

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    # shellcheck disable=SC2086 # intentional splitting of variable names
    dbus-update-activation-environment --systemd $VARS
fi
# reset-failed rejects units that have not been loaded yet. Query the failed
# subset first; leave unrelated user services alone.
failed=$(systemctl --user list-units --failed --type=service --plain --no-legend --no-pager \
    kanshi.service sway-session-monitor.service battery-monitor.service swayidle.service udiskie.service \
    sway-popup-guard.service opensnitch-ui.service update-notify.service vpn-off.service)
failed_units=()
while read -r unit _rest; do
    [[ -z "$unit" ]] || failed_units+=("$unit")
done <<< "$failed"
if (( ${#failed_units[@]} )); then
    systemctl --user reset-failed "${failed_units[@]}"
fi
# shellcheck disable=SC2086 # intentional splitting of variable names
systemctl --user import-environment $VARS
# Fill placeholder monitor serials from what is plugged in, before kanshi reads its config.
"$HOME/.local/bin/monitor-setup" --auto >/dev/null 2>&1 || true
# kanshi is started through the target after its session dependencies.
systemctl --user start "$SESSION_TARGET"
