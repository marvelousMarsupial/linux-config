#!/usr/bin/env bash
# Import the compositor environment and start its systemd user target.
set -euo pipefail

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-sway}"
export XDG_SESSION_TYPE=wayland

# Explicit imports avoid leaking unrelated shell variables to user services.
VARS="DESKTOP_SESSION XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE"
VARS="$VARS DISPLAY WAYLAND_DISPLAY SWAYSOCK XCURSOR_THEME XCURSOR_SIZE"
SESSION_TARGET="sway-session.target"

# Do not overwrite another active session's environment.
if systemctl --user --quiet is-active "$SESSION_TARGET"; then
    echo "sway-session: $SESSION_TARGET already active — skipping" >&2
    exit 0
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    # shellcheck disable=SC2086 # intentional splitting of variable names
    dbus-update-activation-environment --systemd $VARS
fi
systemctl --user reset-failed
# shellcheck disable=SC2086 # intentional splitting of variable names
systemctl --user import-environment $VARS
# kanshi is started through the target after its session dependencies.
systemctl --user start "$SESSION_TARGET"
