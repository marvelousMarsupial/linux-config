#!/usr/bin/env python3
"""Display a centered clock, date, network and power status popup."""

import os
import argparse
import fcntl
import json
import re
import signal
import subprocess
import sys
from datetime import datetime
from pathlib import Path

# Import a saved session address when launched outside the desktop.
dbus_env = Path(f"/run/user/{os.getuid()}/dbus-env")
if dbus_env.exists() and "DBUS_SESSION_BUS_ADDRESS" not in os.environ:
    for line in dbus_env.read_text().splitlines():
        if line.startswith("export DBUS_SESSION_BUS_ADDRESS="):
            addr = line.split("=", 1)[1].strip("'\"")
            os.environ["DBUS_SESSION_BUS_ADDRESS"] = addr


# Popup width in monospace cells.
PANEL_WIDTH = 26
FONT = "CaskaydiaCove Nerd Font Mono:size=18"
# Leave one cell after the network name.
SSID_MAX = PANEL_WIDTH - len("WiFi ") - 1


def run(cmd: list[str]) -> str:
    """Run ``cmd`` and return its stdout, or ``""`` on failure.

    We intentionally swallow non-zero exits and FileNotFoundError so
    callers can treat "tool missing" / "tool failed" the same as "no
    data" — the panel keeps rendering the lines it could produce
    instead of crashing the whole popup over one missing helper.
    """
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def trunc(s: str, n: int) -> str:
    """Truncate ``s`` to at most ``n`` cells, replacing the tail with ``…``."""
    return s if len(s) <= n else s[: max(0, n - 1)] + "…"


def center(line: str, width: int) -> str:
    'Pad ``line`` with leading spaces so its content sits centered in ``width``.'
    pad = max(0, (width - len(line)) // 2)
    return " " * pad + line


def get_clock() -> str:
    'Compact bold ASCII clock for the current ``HH MM`` via ``toilet -f smblock``.'
    # `%H %M` over `%H:%M` so the rendered glyph contains a literal
    # space between hours and minutes; smblock renders that space
    # as a 1-cell-wide blank column, giving "12 34" as `HH (gap)
    # MM` (6 + 1 + 6 = 13 cells wide, narrower than the 14-cell
    # native HH:MM render).
    time_str = datetime.now().strftime("%H %M")
    return run(["toilet", "-f", "smblock", time_str]).rstrip("\n")


def get_network() -> str:
    'Return the WiFi name, Ethernet, or Offline.'
    wifi = run(["iwgetid", "-r"]).strip()
    if wifi:
        return f"WiFi {trunc(wifi, SSID_MAX)}"

    # Format from `ip -br link show`:
    #     <ifname>  <state>  <mac>  <flags>
    # Whitespace-separated, one interface per line. Skip the loopback
    # interface explicitly so a UP `lo` never shows as ethernet.
    for line in run(["ip", "-br", "link", "show"]).splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "UP" and parts[0] != "lo":
            if parts[0].startswith(("en", "eth", "em")):
                return "Ethernet"
    return "Offline"


def get_vpn() -> str:
    """Return the active VPN names, or an empty string when everything is off."""
    names = run(["vpn-menu", "status"]).split()
    return f"VPN {trunc(' '.join(names), SSID_MAX)}" if names else ""


def get_power() -> str:
    'Return a power status line.'
    bat = Path("/sys/class/power_supply/BAT0")
    if not bat.exists():
        return "Power connected"
    try:
        pct = (bat / "capacity").read_text().strip()
        status = (bat / "status").read_text().strip().lower()
    except OSError:
        # sysfs read failed (battery hot-removed, permissions, etc.) —
        # better to render a placeholder than to crash the whole panel.
        return "Battery unknown"
    if status == "charging":
        return f"Battery {pct}% charging"
    if status == "full":
        return "Battery full on power"
    if status == "not charging":
        return f"Battery {pct}% on power"
    # "discharging" or anything unexpected — show just the percentage.
    return f"Battery {pct}%"


def covered_background() -> list[str]:
    """Return an opaque background flag when a window sits under the panel.

    Glass mode gives fuzzel an almost clear background, which reads fine over
    the wallpaper but not over a window. The focused workspace's leaf nodes
    tell us whether anything is underneath; failures fall back to no override.
    """
    try:
        tree = json.loads(run(["swaymsg", "-t", "get_tree", "-r"]))
    except ValueError:
        return []

    def windows(node: dict) -> int:
        children = node.get("nodes", []) + node.get("floating_nodes", [])
        if not children:
            return 1 if node.get("type") in ("con", "floating_con") else 0
        return sum(windows(child) for child in children)

    def focused_workspace(node: dict) -> dict | None:
        children = node.get("nodes", []) + node.get("floating_nodes", [])
        if node.get("type") == "workspace":
            if node.get("focused") or any(focused_workspace(child) is not None for child in children):
                return node
            return None
        for child in children:
            found = focused_workspace(child)
            if found is not None:
                return found
        return node if node.get("focused") else None

    workspace = focused_workspace(tree)
    if not workspace or workspace.get("type") != "workspace" or windows(workspace) == 0:
        return []
    colors = Path.home() / ".config/fuzzel/colors.ini"
    try:
        match = re.search(r"(?m)^background=([0-9a-fA-F]{6})", colors.read_text())
    except OSError:
        return []
    # 85% opaque keeps the rounded glass look while hiding the window below.
    return [f"--background={match[1]}d9"] if match else []


def main() -> None:
    """Render the read-only status panel with fuzzel."""
    date_str = datetime.now().strftime("%a %b %d")

    # Build the line list in display order. Clock first (3 lines), then
    # the date, a blank spacer for visual grouping, then one status line
    # each for network / power.
    clock_lines = get_clock().split("\n")
    lines: list[str] = []
    lines.extend(clock_lines)
    lines.append(date_str)
    lines.append("")
    lines.append(get_network())
    if vpn := get_vpn():
        lines.append(vpn)
    lines.append(get_power())
    # Center every line within PANEL_WIDTH. Done after the lines list
    # is fully built (rather than per get_*() call) so future lines
    # automatically inherit centering without each helper having to
    # know about it. The blank spacer line stays a blank — center("")
    # returns "" because len("") < width and the pad is "" * N, so
    # nothing changes for it.
    lines = [center(line, PANEL_WIDTH) for line in lines]

    # Hand the lines to fuzzel via stdin. The selection-color overrides
    # make highlighting invisible (most of the panel is read-only, so
    # we don't want the cursor's blue bar drawing attention to whichever
    # line happens to be focused). `--inner-pad` and `--line-height`
    # give the popup a bit more breathing room than fuzzel's defaults.
    #
    subprocess.run(
        [
            "fuzzel",
            "--dmenu",
            "--keyboard-focus=on-demand",
            "--no-exit-on-keyboard-focus-loss",
            "--prompt=",
            f"--lines={len(lines)}",
            f"--width={PANEL_WIDTH}",
            f"--font={FONT}",
            "--selection-color=00000000",
            "--selection-text-color=ffffffff",
            "--inner-pad=20",
            "--line-height=25",
            *covered_background(),
        ],
        input="\n".join(lines),
        text=True,
        capture_output=True,
    )

def control(action: str) -> None:
    """Keep one panel process; signal only that panel when hiding/toggling."""
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    with (runtime / 'linux-config-status-panel.lock').open('a+') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if action != 'show':
                lock.seek(0)
                try:
                    os.kill(int(lock.read()), signal.SIGUSR1)
                except (ValueError, ProcessLookupError):
                    pass
            return
        if action == 'hide':
            return
        # The child owns its own process group, so closing this panel cannot
        # terminate an unrelated fuzzel launcher or notification viewer.
        child = None

        def dismiss(_signal, _frame):
            raise SystemExit(0)

        signal.signal(signal.SIGUSR1, dismiss)
        lock.seek(0)
        lock.truncate()
        lock.write(str(os.getpid()))
        lock.flush()
        try:
            child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '--render'],
                                     start_new_session=True)
            child.wait()
        finally:
            if child is not None:
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                child.wait()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', choices=('toggle', 'show', 'hide'), default='toggle')
    parser.add_argument('--render', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.render:
        main()
    else:
        control(args.action)
