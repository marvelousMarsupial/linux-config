#!/usr/bin/env python3
"""wifi-menu - WiFi network selector using fuzzel"""

import os
import subprocess
import sys
from pathlib import Path

# Source D-Bus environment for remote desktop sessions
dbus_env = Path(f"/run/user/{os.getuid()}/dbus-env")
if dbus_env.exists() and "DBUS_SESSION_BUS_ADDRESS" not in os.environ:
    for line in dbus_env.read_text().splitlines():
        if line.startswith("export DBUS_SESSION_BUS_ADDRESS="):
            addr = line.split("=", 1)[1].strip("'\"")
            os.environ["DBUS_SESSION_BUS_ADDRESS"] = addr

def run_output(cmd: list[str]) -> str:
    """Run a command and return stdout."""
    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
        return result.stdout if result.returncode == 0 else ""
    except FileNotFoundError:
        return ""

def notify(title: str, msg: str, critical: bool = False) -> None:
    """Send desktop notification."""
    try:
        cmd = ["notify-send"]
        if critical:
            cmd.extend(["-u", "critical"])
        cmd.extend([title, msg])
        subprocess.run(cmd, capture_output=True)
    except FileNotFoundError:
        pass

def nm_running() -> bool:
    """Check if NetworkManager is running."""
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "--quiet", "NetworkManager"],
            capture_output=True
        )
        return result.returncode == 0
    except FileNotFoundError:
        return False

def signal_bars(signal: int) -> str:
    """Convert signal strength to visual bars."""
    if signal >= 75:
        return "▂▄▆█"
    elif signal >= 50:
        return "▂▄▆░"
    elif signal >= 25:
        return "▂▄░░"
    else:
        return "▂░░░"

def scan_networks() -> list[tuple[str, int, bool]]:
    """Scan for WiFi networks. Returns list of (ssid, signal, secured)."""
    # Trigger rescan (don't wait for it)
    subprocess.run(["nmcli", "device", "wifi", "rescan"],
                   capture_output=True, timeout=5)

    # Get networks
    output = run_output(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"])

    networks = []
    seen_ssids = set()

    for line in output.splitlines():
        if not line or line.startswith(":"):
            continue

        parts = line.split(":")
        if len(parts) < 2:
            continue

        ssid = parts[0]
        if not ssid or ssid in seen_ssids:
            continue

        try:
            signal = int(parts[1]) if len(parts) > 1 and parts[1] else 0
        except ValueError:
            signal = 0

        security = parts[2] if len(parts) > 2 else ""
        secured = bool(security and security != "--")

        seen_ssids.add(ssid)
        networks.append((ssid, signal, secured))

    # Sort by signal strength
    networks.sort(key=lambda x: x[1], reverse=True)
    return networks[:15]

def main() -> None:
    # Help
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print("""wifi-menu - WiFi network selector

USAGE: wifi-menu

Scans for WiFi networks and displays them in fuzzel.
Select a network to connect.

Signal bars:
  ▂▄▆█  75-100%
  ▂▄▆░  50-74%
  ▂▄░░  25-49%
  ▂░░░  0-24%
""")
        return

    if not nm_running():
        notify("WiFi", "NetworkManager not running", critical=True)
        sys.exit(1)

    networks = scan_networks()

    if not networks:
        # Check what we do have and show in fuzzel
        devices = run_output(["nmcli", "-t", "-f", "TYPE,STATE", "device"])
        if "ethernet:connected" in devices:
            msg = "No WiFi - using Ethernet"
        elif "wireguard:connected" in devices:
            msg = "No WiFi - using VPN"
        elif "wifi:" not in devices:
            msg = "No WiFi adapter"
        else:
            msg = "No networks found"

        # Show in fuzzel so user sees something
        subprocess.run(
            ["fuzzel", "--dmenu", "--prompt=", "--lines=1", "--width=30"],
            input=msg,
            text=True,
            capture_output=True
        )
        sys.exit(0)

    # Build menu
    menu_lines = []
    for ssid, signal, secured in networks:
        bars = signal_bars(signal)
        lock = "󰌾 " if secured else ""
        menu_lines.append(f"{bars} {lock}{ssid}")

    menu = "\n".join(menu_lines)

    # Show menu
    try:
        result = subprocess.run(
            ["fuzzel", "--dmenu", "--prompt=WiFi  ", "--lines=10", "--width=40"],
            input=menu,
            text=True,
            capture_output=True,
            timeout=60
        )
    except subprocess.TimeoutExpired:
        sys.exit(0)
    except FileNotFoundError:
        notify("WiFi", "fuzzel not installed", critical=True)
        sys.exit(1)

    choice = result.stdout.strip()
    if not choice:
        sys.exit(0)

    # Extract SSID (remove signal bars and lock icon)
    ssid = choice
    # Remove bars prefix
    for prefix in ("▂▄▆█ ", "▂▄▆░ ", "▂▄░░ ", "▂░░░ "):
        if ssid.startswith(prefix):
            ssid = ssid[len(prefix):]
            break
    # Remove lock icon
    if ssid.startswith("󰌾 "):
        ssid = ssid[2:]

    # Connect
    try:
        connect_result = subprocess.run(
            ["nmcli", "device", "wifi", "connect", ssid],
            capture_output=True,
            timeout=30
        )
        if connect_result.returncode == 0:
            notify("WiFi", f"Connected to {ssid}")
        else:
            notify("WiFi", f"Failed to connect to {ssid}", critical=True)
    except subprocess.TimeoutExpired:
        notify("WiFi", f"Connection timeout for {ssid}", critical=True)

if __name__ == "__main__":
    main()
