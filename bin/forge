#!/bin/bash
# forge - workstation provisioning tool
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ANSIBLE_DIR="$SCRIPT_DIR/ansible"

ensure_ansible() {
    if ! command -v ansible-playbook &> /dev/null; then
        echo "==> Installing Ansible..."
        sudo apt-get update -qq
        sudo apt-get install -y -qq ansible
    fi
}

usage() {
    cat <<EOF
forge - workstation provisioning tool

Usage: forge <command> [options]

Commands:
    setup <role>      Install a role
    teardown          Remove current role
    switch <role>     Teardown current, setup new
    status            Show current role and theme
    theme <cmd>       Theme switcher (apply|list|current|preview)
    cleanup           Remove ansible post-install

Roles:
    server            Base CLI: zsh, tmux, neovim, yazi, starship
    dev-server        + code-server, jupyter, lazygit, build tools
    desktop           + sway, foot, flatpaks (Obsidian, Zen, KeePassXC)
    remote-desktop    + tigervnc for headless GUI

Examples:
    forge setup server
    forge switch desktop
    forge theme apply kanagawa
    forge status
EOF
}

get_current_role() {
    if [ -f ~/.cache/forge/role ]; then
        cat ~/.cache/forge/role
    else
        echo "none"
    fi
}

set_current_role() {
    mkdir -p ~/.cache/forge
    echo "$1" > ~/.cache/forge/role
}

cmd_setup() {
    local role="${1:-server}"

    if [[ ! "$role" =~ ^(server|dev-server|desktop|remote-desktop)$ ]]; then
        echo "Error: Invalid role '$role'"
        echo "Valid roles: server, dev-server, desktop, remote-desktop"
        exit 1
    fi

    echo "==> Setting up $role..."

    # Bootstrap ansible if needed
    ensure_ansible

    # Install collections if needed
    if ! ansible-galaxy collection list 2>/dev/null | grep -q community.general; then
        echo "==> Installing Ansible collections..."
        ansible-galaxy collection install -r "$ANSIBLE_DIR/requirements.yml"
    fi

    # Run playbook
    ansible-playbook -i "$ANSIBLE_DIR/inventory.yml" "$ANSIBLE_DIR/playbook.yml" -e "role=$role"

    set_current_role "$role"
    echo "==> Done! Role '$role' is now active."
}

cmd_teardown() {
    local role="${1:-$(get_current_role)}"

    if [ "$role" = "none" ]; then
        echo "No role currently installed."
        exit 0
    fi

    echo "==> Tearing down $role..."
    ensure_ansible
    ansible-playbook -i "$ANSIBLE_DIR/inventory.yml" "$ANSIBLE_DIR/teardown.yml" -e "role=$role"

    set_current_role "none"
    echo "==> Teardown complete."
}

cmd_switch() {
    local new_role="$1"

    if [ -z "$new_role" ]; then
        echo "Error: Specify role to switch to"
        exit 1
    fi

    local current=$(get_current_role)

    if [ "$current" != "none" ]; then
        echo "==> Switching from $current to $new_role..."
        cmd_teardown "$current"
    fi

    cmd_setup "$new_role"
}

cmd_status() {
    local role=$(get_current_role)
    echo "Role: $role"

    if command -v theme &> /dev/null; then
        echo -n "Theme: "
        theme current 2>/dev/null | head -1 || echo "not set"
    fi
}

cmd_cleanup() {
    echo "==> Removing build dependencies..."
    sudo apt-get remove --purge -y ansible
    sudo apt-get autoremove -y
    echo "==> Cleanup complete. Dotfiles still installed, ansible removed."
}

cmd_theme() {
    if command -v theme &> /dev/null; then
        theme "$@"
    else
        echo "Theme command not found. Run 'forge setup' first."
        exit 1
    fi
}

# Main
case "${1:-}" in
    setup)
        shift
        cmd_setup "$@"
        ;;
    teardown)
        shift
        cmd_teardown "$@"
        ;;
    switch)
        shift
        cmd_switch "$@"
        ;;
    status)
        cmd_status
        ;;
    cleanup)
        cmd_cleanup
        ;;
    theme)
        shift
        cmd_theme "$@"
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
