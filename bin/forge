#!/bin/bash
# forge - workstation provisioning tool
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ANSIBLE_DIR="$SCRIPT_DIR/ansible"

ensure_ansible() {
    if ! command -v ansible-playbook &> /dev/null; then
        echo "==> Installing Ansible..."
        sudo apt-get update -qq
        sudo apt-get install -y -qq ansible
    fi
}

usage() {
    cat <<EOF
forge - workstation provisioning tool

Usage: forge <command> [options]

Commands:
    setup <role>      Install a role
    teardown [--full] Remove current role (--full removes packages too)
    switch <role>     Teardown current, setup new
    status            Show current role and theme
    theme <cmd>       Theme switcher (apply|list|current|preview)
    cleanup           Remove ansible post-install

Roles:
    server            Base CLI: zsh, tmux, neovim, yazi, starship
    dev               + code-server, jupyter, lazygit, build tools
    desktop           + sway, foot, flatpaks (Obsidian, Zen, KeePassXC)
    remote-desktop    + tigervnc for headless GUI

Examples:
    forge setup server
    forge switch desktop
    forge theme apply kanagawa
    forge status
EOF
}

get_current_role() {
    if [ -f ~/.cache/forge/role ]; then
        cat ~/.cache/forge/role
    else
        echo "none"
    fi
}

set_current_role() {
    mkdir -p ~/.cache/forge
    echo "$1" > ~/.cache/forge/role
}

cmd_setup() {
    local role="${1:-server}"

    if [[ ! "$role" =~ ^(server|dev|desktop|remote-desktop)$ ]]; then
        echo "Error: Invalid role '$role'"
        echo "Valid roles: server, dev, desktop, remote-desktop"
        exit 1
    fi

    echo "==> Setting up $role..."

    # Bootstrap ansible if needed
    ensure_ansible

    # Install collections if needed
    if ! ansible-galaxy collection list 2>/dev/null | grep -q community.general; then
        echo "==> Installing Ansible collections..."
        ansible-galaxy collection install -r "$ANSIBLE_DIR/requirements.yml"
    fi

    # Run playbook
    ansible-playbook -i "$ANSIBLE_DIR/inventory.yml" "$ANSIBLE_DIR/playbook.yml" -e "role=$role" -K

    set_current_role "$role"
    echo "==> Done! Role '$role' is now active."
}

cmd_teardown() {
    local full=false
    local role=""

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full|-f)
                full=true
                shift
                ;;
            *)
                role="$1"
                shift
                ;;
        esac
    done

    role="${role:-$(get_current_role)}"

    if [ "$role" = "none" ] && [ "$full" = false ]; then
        echo "No role currently installed. Use 'forge teardown server --full' to force."
        exit 0
    fi

    # Default to server if doing full teardown with no role
    if [ "$role" = "none" ]; then
        role="server"
    fi

    echo "==> Tearing down $role..."
    ensure_ansible

    if [ "$full" = true ]; then
        echo "==> Full teardown: removing packages too..."
        ansible-playbook -i "$ANSIBLE_DIR/inventory.yml" "$ANSIBLE_DIR/teardown.yml" -e "role=$role" -e "full_teardown=true"
    else
        ansible-playbook -i "$ANSIBLE_DIR/inventory.yml" "$ANSIBLE_DIR/teardown.yml" -e "role=$role"
    fi

    set_current_role "none"
    echo "==> Teardown complete."
}

get_role_chain() {
    # Returns roles to teardown when switching FROM this role
    # Each role only removes its own additions, but we need to know the chain
    case "$1" in
        remote-desktop) echo "remote-desktop desktop" ;;
        desktop)        echo "desktop" ;;
        dev)            echo "dev" ;;
        server)         echo "server" ;;
        *)              echo "" ;;
    esac
}

get_new_role_base() {
    # Returns the base roles included in the new role
    case "$1" in
        remote-desktop) echo "server desktop remote-desktop" ;;
        desktop)        echo "server desktop" ;;
        dev)            echo "server dev" ;;
        server)         echo "server" ;;
        *)              echo "" ;;
    esac
}

cmd_switch() {
    local new_role="$1"

    if [ -z "$new_role" ]; then
        echo "Error: Specify role to switch to"
        exit 1
    fi

    local current=$(get_current_role)

    if [ "$current" = "none" ]; then
        cmd_setup "$new_role"
        return
    fi

    if [ "$current" = "$new_role" ]; then
        echo "Already on $new_role. Running setup to refresh..."
        cmd_setup "$new_role"
        return
    fi

    echo "==> Switching from $current to $new_role..."

    # Get what the new role includes
    local new_bases=$(get_new_role_base "$new_role")

    # Teardown current role chain, skipping roles included in new role
    ensure_ansible
    for role in $(get_role_chain "$current"); do
        if ! echo "$new_bases" | grep -qw "$role"; then
            echo "==> Tearing down $role..."
            ansible-playbook -i "$ANSIBLE_DIR/inventory.yml" "$ANSIBLE_DIR/teardown.yml" -e "role=$role"
        fi
    done

    cmd_setup "$new_role"
}

cmd_status() {
    local role=$(get_current_role)
    echo "Role: $role"

    if command -v theme &> /dev/null; then
        echo -n "Theme: "
        theme current 2>/dev/null | head -1 || echo "not set"
    fi
}

cmd_cleanup() {
    echo "==> Removing build dependencies..."
    sudo apt-get remove --purge -y ansible
    sudo apt-get autoremove -y
    echo "==> Cleanup complete. Dotfiles still installed, ansible removed."
}

cmd_theme() {
    if command -v theme &> /dev/null; then
        theme "$@"
    else
        echo "Theme command not found. Run 'forge setup' first."
        exit 1
    fi
}

# Main
case "${1:-}" in
    setup)
        shift
        cmd_setup "$@"
        ;;
    teardown)
        shift
        cmd_teardown "$@"
        ;;
    switch)
        shift
        cmd_switch "$@"
        ;;
    status)
        cmd_status
        ;;
    cleanup)
        cmd_cleanup
        ;;
    theme)
        shift
        cmd_theme "$@"
        ;;
    -h|--help|help|"")
        usage
        ;;
    # Shorthand: forge <role> = forge setup <role>
    server|dev|desktop|remote-desktop)
        cmd_setup "$1"
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
