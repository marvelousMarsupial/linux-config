-- {{ scheme }} - Generated by theme switcher
return {
  -- All colorscheme plugins available
  {
    "folke/tokyonight.nvim",
    lazy = false,
    priority = 1000,
    opts = {
      style = "moon",
      transparent = true,
      styles = {
        sidebars = "transparent",
        floats = "transparent",
      },
    },
{% if nvim_plugin == "folke/tokyonight.nvim" %}
    config = function(_, opts)
      require("tokyonight").setup(opts)
      require("tokyonight").load()
    end,
{% endif %}
  },
  {
    "navarasu/onedark.nvim",
    lazy = false,
    priority = 1000,
    opts = {
      style = "darker",
      transparent = true,
      lualine = { transparent = true },
    },
{% if nvim_plugin == "navarasu/onedark.nvim" %}
    config = function(_, opts)
      require("onedark").setup(opts)
      require("onedark").load()
    end,
{% endif %}
  },
  {
    "echasnovski/mini.base16",
    lazy = false,
    priority = 1000,
{% if not nvim_plugin %}
    config = function()
      require("mini.base16").setup({
        palette = {
          base00 = "#{{ base00 }}",
          base01 = "#{{ base01 }}",
          base02 = "#{{ base02 }}",
          base03 = "#{{ base03 }}",
          base04 = "#{{ base04 }}",
          base05 = "#{{ base05 }}",
          base06 = "#{{ base06 }}",
          base07 = "#{{ base07 }}",
          base08 = "#{{ base08 }}",
          base09 = "#{{ base09 }}",
          base0A = "#{{ base0A }}",
          base0B = "#{{ base0B }}",
          base0C = "#{{ base0C }}",
          base0D = "#{{ base0D }}",
          base0E = "#{{ base0E }}",
          base0F = "#{{ base0F }}",
        },
        use_cterm = false,
      })

      -- Enhance treesitter highlights for more vibrant syntax
      local hi = vim.api.nvim_set_hl
      hi(0, "@variable", { fg = "#{{ base05 }}" })
      hi(0, "@variable.builtin", { fg = "#{{ base08 }}" })
      hi(0, "@constant", { fg = "#{{ base09 }}" })
      hi(0, "@constant.builtin", { fg = "#{{ base09 }}" })
      hi(0, "@string", { fg = "#{{ base0B }}" })
      hi(0, "@string.escape", { fg = "#{{ base0C }}" })
      hi(0, "@character", { fg = "#{{ base0B }}" })
      hi(0, "@number", { fg = "#{{ base09 }}" })
      hi(0, "@boolean", { fg = "#{{ base09 }}" })
      hi(0, "@function", { fg = "#{{ base0D }}" })
      hi(0, "@function.builtin", { fg = "#{{ base0D }}" })
      hi(0, "@function.call", { fg = "#{{ base0D }}" })
      hi(0, "@method", { fg = "#{{ base0D }}" })
      hi(0, "@method.call", { fg = "#{{ base0D }}" })
      hi(0, "@constructor", { fg = "#{{ base0A }}" })
      hi(0, "@parameter", { fg = "#{{ base08 }}" })
      hi(0, "@keyword", { fg = "#{{ base0E }}" })
      hi(0, "@keyword.function", { fg = "#{{ base0E }}" })
      hi(0, "@keyword.return", { fg = "#{{ base0E }}" })
      hi(0, "@keyword.operator", { fg = "#{{ base0E }}" })
      hi(0, "@conditional", { fg = "#{{ base0E }}" })
      hi(0, "@repeat", { fg = "#{{ base0E }}" })
      hi(0, "@operator", { fg = "#{{ base05 }}" })
      hi(0, "@punctuation", { fg = "#{{ base05 }}" })
      hi(0, "@punctuation.bracket", { fg = "#{{ base0F }}" })
      hi(0, "@punctuation.delimiter", { fg = "#{{ base05 }}" })
      hi(0, "@type", { fg = "#{{ base0A }}" })
      hi(0, "@type.builtin", { fg = "#{{ base0A }}" })
      hi(0, "@type.definition", { fg = "#{{ base0A }}" })
      hi(0, "@property", { fg = "#{{ base08 }}" })
      hi(0, "@field", { fg = "#{{ base08 }}" })
      hi(0, "@attribute", { fg = "#{{ base0A }}" })
      hi(0, "@namespace", { fg = "#{{ base0C }}" })
      hi(0, "@include", { fg = "#{{ base0E }}" })
      hi(0, "@label", { fg = "#{{ base0A }}" })
      hi(0, "@comment", { fg = "#{{ base03 }}", italic = true })
      hi(0, "@tag", { fg = "#{{ base08 }}" })
      hi(0, "@tag.attribute", { fg = "#{{ base0A }}" })
      hi(0, "@tag.delimiter", { fg = "#{{ base0F }}" })

      -- Make backgrounds transparent like tokyonight
      vim.opt.background = "dark"
      local none = "NONE"

      -- Core UI - all transparent
      hi(0, "Normal", { fg = "#{{ base05 }}", bg = none })
      hi(0, "NormalNC", { fg = "#{{ base05 }}", bg = none })
      hi(0, "NormalFloat", { fg = "#{{ base05 }}", bg = "#{{ base01 }}" })
      hi(0, "FloatBorder", { fg = "#{{ base03 }}", bg = none })
      hi(0, "SignColumn", { fg = "#{{ base03 }}", bg = none })
      hi(0, "LineNr", { fg = "#{{ base03 }}", bg = none })
      hi(0, "LineNrAbove", { fg = "#{{ base03 }}", bg = none })
      hi(0, "LineNrBelow", { fg = "#{{ base03 }}", bg = none })
      hi(0, "CursorLineNr", { fg = "#{{ base05 }}", bg = none })
      hi(0, "CursorLine", { bg = none })
      hi(0, "CursorColumn", { bg = none })
      hi(0, "VertSplit", { fg = "#{{ base01 }}", bg = none })
      hi(0, "WinSeparator", { fg = "#{{ base01 }}", bg = none })
      hi(0, "StatusLine", { fg = "#{{ base04 }}", bg = "#{{ base01 }}" })
      hi(0, "StatusLineNC", { fg = "#{{ base03 }}", bg = "#{{ base01 }}" })
      hi(0, "EndOfBuffer", { fg = "#{{ base00 }}", bg = none })
      hi(0, "FoldColumn", { fg = "#{{ base03 }}", bg = none })
      hi(0, "Folded", { fg = "#{{ base03 }}", bg = none })
      hi(0, "ColorColumn", { bg = "#{{ base01 }}" })
      hi(0, "MsgArea", { fg = "#{{ base05 }}", bg = none })
      hi(0, "ModeMsg", { fg = "#{{ base0B }}", bg = none })
      hi(0, "MoreMsg", { fg = "#{{ base0D }}", bg = none })
      hi(0, "NonText", { fg = "#{{ base02 }}", bg = none })
      hi(0, "SpecialKey", { fg = "#{{ base02 }}", bg = none })
      -- Diagnostics
      hi(0, "DiagnosticSignError", { fg = "#{{ base08 }}", bg = none })
      hi(0, "DiagnosticSignWarn", { fg = "#{{ base0A }}", bg = none })
      hi(0, "DiagnosticSignInfo", { fg = "#{{ base0D }}", bg = none })
      hi(0, "DiagnosticSignHint", { fg = "#{{ base0C }}", bg = none })
      -- Git signs
      hi(0, "GitSignsAdd", { fg = "#{{ base0B }}", bg = none })
      hi(0, "GitSignsChange", { fg = "#{{ base0D }}", bg = none })
      hi(0, "GitSignsDelete", { fg = "#{{ base08 }}", bg = none })
      hi(0, "GitSignsAddNr", { fg = "#{{ base0B }}", bg = none })
      hi(0, "GitSignsChangeNr", { fg = "#{{ base0D }}", bg = none })
      hi(0, "GitSignsDeleteNr", { fg = "#{{ base08 }}", bg = none })
    end,
{% endif %}
  },
}
