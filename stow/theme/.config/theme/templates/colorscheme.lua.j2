-- {{ scheme }} - Generated by theme switcher
return {
  {
{% if nvim_plugin %}
    "{{ nvim_plugin }}",
{% else %}
    "tinted-theming/tinted-vim",
{% endif %}
    lazy = false,
    priority = 1000,
{% if nvim_plugin == "folke/tokyonight.nvim" %}
    opts = {
      style = "moon",
      transparent = true,
      styles = {
        sidebars = "transparent",
        floats = "transparent",
      },
    },
{% else %}
    config = function()
{% if nvim_colorscheme %}
      vim.cmd("colorscheme {{ nvim_colorscheme }}")
{% else %}
      vim.cmd("colorscheme base16-{{ scheme_slug }}")
{% endif %}
    end,
{% endif %}
  },
}
