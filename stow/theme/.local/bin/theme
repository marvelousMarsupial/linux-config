#!/usr/bin/env python3
"""Unified theme switcher for base16 color schemes."""

import argparse
import glob
import os
import subprocess
import sys
import tomllib
from pathlib import Path

import yaml
from jinja2 import Environment, FileSystemLoader


def expand_path(path: str) -> Path:
    """Expand ~ and return Path object."""
    return Path(os.path.expanduser(path))


def resolve_glob_path(pattern: str) -> list[Path]:
    """Resolve a path pattern that may contain globs. Returns list of paths."""
    expanded = os.path.expanduser(pattern)
    if "*" in expanded:
        matches = glob.glob(expanded)
        return [Path(m) for m in matches]
    return [Path(expanded)]


def load_config() -> dict:
    """Load configuration from config.toml."""
    config_path = expand_path("~/.config/theme/config.toml")
    with open(config_path, "rb") as f:
        return tomllib.load(f)


def load_scheme(scheme_name: str, config: dict) -> dict:
    """Load a color scheme from YAML file."""
    schemes_dir = expand_path(config["settings"]["schemes_dir"])
    scheme_path = schemes_dir / f"{scheme_name}.yaml"
    if not scheme_path.exists():
        raise FileNotFoundError(f"Scheme not found: {scheme_name}")
    with open(scheme_path) as f:
        return yaml.safe_load(f)


def list_schemes(config: dict) -> list[str]:
    """List available color schemes."""
    schemes_dir = expand_path(config["settings"]["schemes_dir"])
    return sorted(p.stem for p in schemes_dir.glob("*.yaml"))


def get_current_theme(config: dict) -> str | None:
    """Get the currently applied theme."""
    cache_dir = expand_path(config["settings"]["cache_dir"])
    current_file = cache_dir / "current"
    if current_file.exists():
        return current_file.read_text().strip()
    return None


def set_current_theme(scheme_name: str, config: dict) -> None:
    """Save the current theme to cache."""
    cache_dir = expand_path(config["settings"]["cache_dir"])
    cache_dir.mkdir(parents=True, exist_ok=True)
    current_file = cache_dir / "current"
    current_file.write_text(scheme_name + "\n")


def atomic_write(path: Path, content: str) -> None:
    """Write content to file atomically using tmp + rename."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    tmp_path.write_text(content)
    tmp_path.rename(path)


def run_hook(hook: str, target_name: str) -> bool:
    """Run a reload hook command. Returns True on success."""
    if not hook:
        return True
    try:
        subprocess.run(
            hook,
            shell=True,
            check=True,
            capture_output=True,
            timeout=5,
        )
        return True
    except subprocess.CalledProcessError:
        return False
    except subprocess.TimeoutExpired:
        return False
    except FileNotFoundError:
        return False


def apply_theme(scheme_name: str, config: dict, preview: bool = False) -> None:
    """Apply a color scheme to all targets."""
    scheme = load_scheme(scheme_name, config)
    templates_dir = expand_path(config["settings"]["templates_dir"])

    # Get scheme-specific metadata
    scheme_meta = config.get("scheme_meta", {}).get(scheme_name, {})

    # Build template context with all base16 colors and metadata
    context = {
        "scheme": scheme.get("scheme", scheme_name),
        "scheme_slug": scheme_meta.get("scheme_slug", scheme_name),
        "yazi_flavor": scheme_meta.get("yazi_flavor"),  # None if not set
    }
    # Add all base16 colors (base00-base0F)
    for key, value in scheme.items():
        if key.startswith("base"):
            context[key] = value

    env = Environment(
        loader=FileSystemLoader(templates_dir),
        keep_trailing_newline=True,
    )

    if preview:
        print(f"Preview: {scheme_name}")
        print("-" * 40)

    needs_restart = []

    for target in config["targets"]:
        template = env.get_template(target["template"])
        content = template.render(**context)
        output_pattern = target["output"]

        # Resolve glob patterns in output path
        output_paths = resolve_glob_path(output_pattern)

        # If glob matched nothing and pattern has *, skip silently
        if not output_paths and "*" in output_pattern:
            continue

        # If no glob, use the literal path
        if not output_paths:
            output_paths = [expand_path(output_pattern)]

        if preview:
            print(f"\n[{target['name']}] -> {output_pattern}")
            print(content[:500] + ("..." if len(content) > 500 else ""))
            continue

        wrote_any = False
        for output_path in output_paths:
            # For glob patterns, the parent dir must exist
            if "*" in output_pattern and not output_path.parent.exists():
                continue
            atomic_write(output_path, content)
            print(f"  {target['name']}: {output_path}")
            wrote_any = True

        if wrote_any and target.get("hook"):
            run_hook(target["hook"], target["name"])

        if wrote_any and target.get("restart"):
            needs_restart.append(target["restart"])

    if not preview:
        set_current_theme(scheme_name, config)
        print(f"\nApplied: {scheme_name}")
        if needs_restart:
            print(f"Restart to apply: {', '.join(needs_restart)}")


def print_colors(scheme_name: str, config: dict) -> None:
    """Print color palette for a scheme."""
    scheme = load_scheme(scheme_name, config)
    print(f"\n{scheme.get('scheme', scheme_name)}")
    print("=" * 40)
    for i in range(16):
        key = f"base0{i:X}"
        color = scheme.get(key, "??????")
        # Print colored block using ANSI escape codes
        r, g, b = int(color[0:2], 16), int(color[2:4], 16), int(color[4:6], 16)
        block = f"\033[48;2;{r};{g};{b}m    \033[0m"
        print(f"  {key}: #{color} {block}")


def main():
    parser = argparse.ArgumentParser(
        description="Unified theme switcher for base16 color schemes"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # apply command
    apply_parser = subparsers.add_parser("apply", help="Apply a color scheme")
    apply_parser.add_argument("scheme", help="Name of the scheme to apply")

    # list command
    subparsers.add_parser("list", help="List available schemes")

    # current command
    subparsers.add_parser("current", help="Show current theme")

    # preview command
    preview_parser = subparsers.add_parser(
        "preview", help="Preview a scheme without applying"
    )
    preview_parser.add_argument("scheme", help="Name of the scheme to preview")

    args = parser.parse_args()
    config = load_config()

    if args.command == "list":
        schemes = list_schemes(config)
        current = get_current_theme(config)
        for s in schemes:
            marker = " *" if s == current else ""
            print(f"  {s}{marker}")

    elif args.command == "current":
        current = get_current_theme(config)
        if current:
            print(current)
            print_colors(current, config)
        else:
            print("No theme currently set")
            sys.exit(1)

    elif args.command == "apply":
        schemes = list_schemes(config)
        if args.scheme not in schemes:
            print(f"Unknown scheme: {args.scheme}", file=sys.stderr)
            print(f"Available: {', '.join(schemes)}", file=sys.stderr)
            sys.exit(1)
        apply_theme(args.scheme, config)

    elif args.command == "preview":
        schemes = list_schemes(config)
        if args.scheme not in schemes:
            print(f"Unknown scheme: {args.scheme}", file=sys.stderr)
            print(f"Available: {', '.join(schemes)}", file=sys.stderr)
            sys.exit(1)
        print_colors(args.scheme, config)
        apply_theme(args.scheme, config, preview=True)


if __name__ == "__main__":
    main()
