# Environment
export EDITOR=nvim
export VISUAL=nvim

# Alias reminder (inline terminal hints + corner notification)
export ALIAS_REMINDER=1

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias c='clear'
alias x='exit'
alias -- -='cd -'

# Safety
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='trash-put'

# Listing
alias l='eza -lah'
alias la='eza -la'
alias ll='eza -l'
alias lt='eza -lahT'
alias ls='eza'
alias tree='eza --tree'
alias cat='bat'

# System
alias ip='ip -br -c'
alias ports='ss -tulanp'
alias df='df -h'
alias free='free -h'
alias dmesg='dmesg -T'
alias topmem='ps aux --sort=-%mem | head'
alias topcpu='ps aux --sort=-%cpu | head'
alias psg='ps aux | grep'

# Disk
alias du='du -h'
alias dud='du -d 1 -h'
alias duf='du -sh *'

# Network
alias myip='curl -s ifconfig.me'
alias ping='ping -c 5'
alias listening='ss -tlnp'
alias connections='ss -tnp'

# VPN (WireGuard)
alias vpnup='vpn up'
alias vpndown='vpn down'
alias vpnstat='vpn status'

# Systemd
alias sc='sudo systemctl'
alias scs='sudo systemctl status'
alias scr='sudo systemctl restart'
alias sce='sudo systemctl enable --now'
alias scd='sudo systemctl disable --now'
alias scdr='sudo systemctl daemon-reload'
alias jc='journalctl'
alias jcf='journalctl -f'
alias jce='journalctl -xe'

# Quick tools
alias v='nvim'
# y defined as function in .zshrc (cd's to dir on exit)
# Tmux helper with custom bindings help
t() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    command cat << 'EOF'
tmux bindings (prefix: Ctrl+Space)

Navigation (Alt + hjkl):
  Alt-h/j/k/l     Move between panes (smart-splits aware)
  Alt-H/J/K/L     Resize panes

Pane Management:
  Alt-v           Split + nvim
  Alt-e           Split + yazi
  Alt-Enter       Split + shell
  Alt-q           Close pane
  Alt-z           Toggle zoom
  Alt-d           Detach

Copy Mode:
  Alt-[           Enter copy mode
  Alt-]           Paste
  v               Begin selection (in copy mode)
  y               Copy to clipboard (in copy mode)

Misc:
  prefix r        Reload config
  prefix S        Sync panes
  F12             Toggle nested session
EOF
    return
  fi
  tmux new-session
}
alias weather='curl wttr.in'
alias serve='python3 -m http.server'
alias please='sudo $(fc -ln -1)'
alias ag='alias | grep'
alias fd='fdfind'

# History & Config
alias h='history -10'
alias hg='history | grep'
alias reload='source ~/.zshrc'

# Clipboard (wayland)
alias clip='wl-copy'
alias paste='wl-paste'

# Archives
alias untar='tar -xvf'
alias targz='tar -czvf'

# Finding
alias findd='find . -type d -name'
alias findf='find . -type f -name'

# Git
alias g='git'
alias gs='git status'
alias ga='git add'
alias gaa='git add -A'
alias gc='git commit'
alias gcm='git commit -m'
alias gca='git commit --amend'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpl='git pull'
alias gl='git log --oneline'
alias glog='git log --oneline --graph --decorate'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias gm='git merge'
alias grb='git rebase'
alias gst='git stash'
alias gstp='git stash pop'

# Global Aliases (zsh only)
alias -g G='| grep'
alias -g L='| less'
alias -g H='| head'
alias -g T='| tail'
alias -g W='| wc -l'
alias -g S='| sort'
alias -g U='| sort -u'
alias -g J='| jq'

# Suffix Aliases (zsh only - open with nvim)
alias -s md='nvim'
alias -s txt='nvim'
alias -s json='nvim'
alias -s yaml='nvim'
alias -s yml='nvim'
alias -s py='nvim'
alias -s lua='nvim'
alias -s sh='nvim'
# BEGIN REMOTE DESKTOP ALIASES
alias rstart='remote-start'
alias rstop='remote-stop'
# END REMOTE DESKTOP ALIASES

# BEGIN DEV ALIASES
alias coder='coder-start'
alias jupyter='jupyter-start'
alias lg='lazygit'
# END DEV ALIASES
# BEGIN CLOUDBEAVER ALIASES
alias cloudbeaver='cloudbeaver-start'
alias dbeaver='cloudbeaver-start'
# END CLOUDBEAVER ALIASES
