# Trusted Bash configuration. Copy to ~/.config/restic-home/env, chmod 600.
# Choose a Restic target: local disk, sftp, REST server, S3, B2, etc.
RESTIC_REPOSITORY='sftp:backup@example.com:/backups/my-machine'
RESTIC_PASSWORD_FILE="$HOME/.config/restic-home/password"
# Backend credentials, if needed, go here too (never in the repository).
# AWS_ACCESS_KEY_ID='...'
# AWS_SECRET_ACCESS_KEY='...'
